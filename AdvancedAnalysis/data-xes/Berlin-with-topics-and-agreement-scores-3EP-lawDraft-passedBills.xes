			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Beauftragter zur Aufarbeitung der SED-Diktatur"/>
			<string key="Titel" value="Gesetz über den Beauftragten bzw. die Beauftragte zur Aufarbeitung der SED-Diktatur im Land Berlin &lt;br /&gt;(Berliner Aufarbeitungsbeauftragtengesetz - AufarbBG Bln)"/>
			<string key="DokNr" value="18/0416"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Die Linke Fraktion Berlin (Die Linke)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-0416.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Überarbeitung des zum 30.11.2017 außer Kraft tretenden Gesetzes über den Landesbeauftragten zur Aufarbeitung  der Unterlagen des Staatssicherheitsdienstes  der ehemaligen Deutschen Demokratischen Republik im Land Berlin.&lt;br&gt;&lt;br /&gt;Fortführung der bisherigen Arbeit der Behörde des Landesbeauftragten.&lt;br&gt;&lt;br /&gt;Über die bisherige Aufgabenstellung der Behörde des Landesbeauftragten hinausgehend Aufhebung der Beschränkung auf den Staatssicherheitsdienst:  Aufarbeitung des ganzen politischen Systems in der Sowjetischen Besatzungszone und der DDR sowie dessen Auswirkungen.&lt;br&gt; &lt;br /&gt;Zu den Aufgaben des oder der Landesbeauftragten (§2) gehören&lt;br&gt;- die Beratung von Bürgerinnen und Bürgern in Fragen von Akteneinsicht, Rehabilitierung und Entschädigung von SED-Unrecht nach den SED-Unrechtsbereinigungsgesetzen und hinsichtlich der Behandlung verfolgungsbedingter Gesundheitsschäden,&lt;br&gt;&lt;br /&gt;- die Förderung der Arbeit von in Berlin tätigen Opfer- bzw. Verfolgtenverbänden und Aufarbeitungsinitiativen. Unterstützung der ZusammenaVorabüberweisung an AInnSichO u. AKult"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="NaT"/>
			<int key="@@index" value="13437"/>
			<float key="opposition_agreement_score" value="1.0"/>
			<float key="all_agreement_score" value="0.4333333333333333"/>
