			<string key="Desk" value="Nachtragshaushaltsgesetz 2009"/>
			<string key="Titel" value="Zweites Gesetz über die Feststellung eines Nachtrags zum Haushaltsplan von Berlin für das Haushaltsjahr 2009 &lt;br /&gt;(Zweites Nachtragshaushaltsgesetz 2009 - 2. NHG 09)"/>
			<string key="DokNr" value="16/2451"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-2451.pdf"/>
			<string key="Sb" value="1-35"/>
			<string key="Abstract" value="Die Entwicklung der deutschen Wirtschaft verläuft nach jüngsten Daten schlechter als noch zu Jahresanfang vermutet. Für das laufende Jahr wird der stärkste Wirtschaftseinbruch in der Bundesrepublik Deutschland erwartet. Dieser schlägt sich in den Einnahmen aus Steuern und Länderfinanzausgleich nieder. Gegenüber dem Nachtragshaushaltsgesetz vom 26. März 2009 errechnet sich ein nochmaliger Rückgang bei Steuern und Finanzausgleich. \\nVorabüberweisung an AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
