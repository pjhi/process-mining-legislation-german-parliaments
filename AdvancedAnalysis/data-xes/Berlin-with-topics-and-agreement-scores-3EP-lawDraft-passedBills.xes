			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Untersuchungsausschuss"/>
			<string key="Titel" value="Gesetz über die Untersuchungsausschüsse des Abgeordnetenhauses von Berlin (UntAG)"/>
			<string key="DokNr" value="16/4221"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Die Linke Fraktion Berlin (Die Linke)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-4221.pdf"/>
			<string key="Sb" value="1-20"/>
			<string key="Abstract" value="Überarbeitung des Untersuchungsausschussgesetzes aus dem Jahr 1970.&lt;br&gt;&lt;br /&gt;Klärung der Minderheitsrechte hinsichtlich der Sachherrschaft über den Gegenstand der von ihr beantragten Untersuchung und der Beweisanträge&lt;br&gt;&lt;br /&gt;Aufnahme einer Abwahlmöglichkeit der oder des Vorsitzenden durch das Plenum mit Zweidrittel-Mehrheit&lt;br&gt;&lt;br /&gt;Klarere Regelungen zu öffentlichen und nicht öffentlichen Sitzungen sowie zu den Voraussetzungen zum Ausschluss der Öffentlichkeit und zu Anwesenheitsrechte Dritter. &lt;br&gt;&lt;br /&gt;Einfügung von Vorschriften über den Geheimnisschutz t (§§ 14 und 15) &lt;br&gt;&lt;br /&gt;Neustrukturierung des Rechts der Beweiserhebung (§§ 16 ff), Regelungen hinsichtlich Körperschaften, Anstalten und Stiftungen des öffentlichen Rechts sowie Einrichtungen in privatrechtlicher Organisationsform&lt;br&gt;&lt;br /&gt;Zeugen erhalten die Möglichkeit zur Einsichtnahme in die Vernehmungsprotokolle in den Räumen des Abgeordnetenhauses sowie zu einer nachträglichen Stellungnahme zu ihren Protokollen (§ 27)&lt;br&gt;&lt;br /&gt;Übertragung der gerichtlichen Zustän"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="NaT"/>
