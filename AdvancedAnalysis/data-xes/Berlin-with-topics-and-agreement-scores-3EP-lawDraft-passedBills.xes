			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Verkehrspolitik"/>
			<string key="Titel" value="Erstes Gesetz zur Änderung des Berliner Mobilitätsgesetzes"/>
			<string key="DokNr" value="18/2429"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-2429.pdf"/>
			<string key="Sb" value="1-43"/>
			<string key="Abstract" value="Vierter Baustein des Mobilitätsgesetzes (Fußgängergesetz): Vorrang für den Fußverkehr als Teil des Umweltverbunds (Bahnverkehr, Busverkehr, Radverkehr, Fußverkehr) vor dem motorisierten Individualverkehr:&lt;br&gt;&lt;br /&gt;- Erleichterung beim Überqueren von Straßen (Ausbau von Gehwegvorstreckungen und Mittelinseln, Absenkung von Bordsteinen, Verlängerung der Grünphase an breiten Straßen, Möglichkeit zur Verlängerung der Grünphase an sogenannten Blindenampeln per Knopfdruck)&lt;br&gt;&lt;br /&gt;- Verkehrsberuhigung durch Fußgängerzonen, verkehrsberuhigte Straßen und Spielstraßen&lt;br&gt;&lt;br /&gt;- Direkte Querung für Zufußgehende an jedem Arm einer Kreuzung&lt;br&gt;&lt;br /&gt;- Verbesserung der Beleuchtung an Fußwegen und Radwegen&lt;br&gt;&lt;br /&gt;- Erarbeitung eines Konzeptes für das schulische Mobilitätsmanagement (bauliche und verkehrliche Maßnahmen im Schulumfeld; Einsatz von Schülerlotsen und Schülerlotsinnen, bezirkliche Schulwegpläne)&lt;br&gt;&lt;br /&gt;- Ausbau der bisherigen Koordinierungsstelle für den Radverkehr in der Senatsverwaltung für Verkehr zur Koordinierungss"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="NaT"/>
