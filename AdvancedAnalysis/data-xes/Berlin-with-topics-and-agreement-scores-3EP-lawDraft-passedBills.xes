			<string key="Desk" value="Ethikkommission"/>
			<string key="Titel" value="Zweites Gesetz zur Änderung des Ethik-Kommissionsgesetzes Berlin"/>
			<string key="DokNr" value="18/1216"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-1216.pdf"/>
			<string key="Sb" value="1-69"/>
			<string key="Abstract" value="Das Gesetz wird um die Aufgabe der Bewertung klinischer Prüfungen von Arzneimitteln bei Menschen durch eine registrierte Ethik-Kommission nach dem zur Durchführung der Verordnung (EU) Nr. 536/2014 erlassenen Bundesrecht&lt;br /&gt;(Arzneimittelgesetz und Klinische Prüfung-Bewertungsverfahren-Verordnung) ergänzt. Hierzu werden die erforderlichen Bestimmungen vor allem zur interdisziplinären Besetzung der Ethik-Kommission einschließlich der Einbeziehung sogenannter externer Sachverständiger, zur Stellung der Kommissionsmitglieder und zur Erhebung von Verwaltungsgebühren getroffen. Außerdem wird die Ermächtigung zum Erlass einer Rechtsverordnung erweitert.&lt;br /&gt;Bei dieser Gelegenheit werden auch Aufgaben einer registrierten Ethik-Kommission nach Strahlenschutzrecht in das Ethik-Kommissionsgesetz Berlin aufgenommen.&lt;br&gt;Änderung § 1 Abs.1, 2, die bisherigen Abs. 2 u. 3 werden Abs. 3 u. 4; § 2 Abs. 1, Abs. 2a, 2b, Abs. 3, 4, 5, 6, 7&lt;br&gt;Einfügung § 2 Abs. 2d; § 3 Nr. 1a, Nr. 11"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
