			<string key="Desk" value="Beamtenversorgung"/>
			<string key="Titel" value="Gesetz zur Verbesserung der Einsatzversorgung und zur Änderung weiterer dienstrechtlicher Vorschriften &lt;br /&gt;(Einsatzversorgungsverbesserungsgesetz Berlin - EinsatzVVerbG Bln)"/>
			<string key="DokNr" value="18/1250"/>
