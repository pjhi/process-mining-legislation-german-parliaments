			<string key="Desk" value="Teilhabe behinderter Menschen"/>
			<string key="Titel" value="Gesetz zur Umsetzung des Bundesteilhabegesetzes in Berlin &lt;br /&gt;(Berliner Teilhabegesetz - BlnTG)"/>
			<string key="DokNr" value="18/2027"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-2027.pdf"/>
			<string key="Sb" value="1-129"/>
			<string key="Abstract" value="Umsetzung des Gesetzes zur Stärkung der Teilhabe und Selbstbestimmung von Menschen mit Behinderungen vom 23.12.2016: &lt;br /&gt;Gesetzliche Festlegung des ab 01.01.2020 für das neue Leistungsrecht zuständigen Trägers. &lt;br&gt;&lt;br /&gt;Überführung der Hilfe für Menschen mit Behinderung aus dem Recht der Sozialleistungen ins Recht der Rehabilitation und der Teilhabe / Gründung von Teilhabefachdiensten in den bezirklichen Ämtern für Soziales und den bezirklichen Jugendämtern, dabei Zusammenführung im örtlichen und fachlichen Arbeitsbündnis „Haus der Teilhabe“ / Unterstützung durch den Teilhabebeirat und weitere Gremien / Herstellung der Anschlussfähigkeit an das E-Government einschließlich der Datensicherheit und des Datenschutzes der DSGVO für alle im Bereich Soziales liegenden Gesetze und Aufgaben&lt;br&gt;&lt;br /&gt;Artikelgesetz:&lt;br&gt;Artikel 1: Gesetz zur Ausführung des Neunten Buches Sozialgesetzbuch (AG SGB IX)&lt;br&gt;Artikel 2: Änderung des Gesetzes über die Ausführung des Kinder-und Jugendhilfegesetzes&lt;br&gt;Artikel 3: Änderung deVorabüberweisung an AIntArbSoz f, AGesPflegGleich, ABildJugFam u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
