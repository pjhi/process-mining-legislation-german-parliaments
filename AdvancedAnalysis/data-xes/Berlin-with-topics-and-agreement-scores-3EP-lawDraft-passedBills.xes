			<string key="DokNr" value="18/0460"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Die Linke Fraktion Berlin (Die Linke)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Alternative für Deutschland (AfD)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
