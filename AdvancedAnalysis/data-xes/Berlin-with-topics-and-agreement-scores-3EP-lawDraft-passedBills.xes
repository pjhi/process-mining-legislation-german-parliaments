			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Studienplatz"/>
			<string key="Titel" value="Gesetz über den &quot;Staatsvertrag über die Vergabe von Studienplätzen&quot;"/>
			<string key="DokNr" value="16/0283"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-0283.pdf"/>
			<string key="Sb" value="1-33"/>
			<string key="Abstract" value="Der Staatsvertrag wurde von den Ministerpräsidenten am 22. Juni 2006 unterzeichnet. &lt;br /&gt;Neue Punkte:&lt;br /&gt;Weiterentwicklung der Zentralstelle für die Vergabe von Studienplätzen zu einer Serviceeinrichtung mit verändertem Aufgabenspektrum und anderer Rechtsform (Art. 1 Abs. 4).&lt;br /&gt;Eröffnung ländereigener Kapazitätsfestsetzungsverfahren bei der Studienplatzvergabe durch Streichung von Art. 7 Abs. 6 des Staatsvertrages.&lt;br /&gt;Stärkung des Rechts der Selbstauswahl durch Erhöhung der Quote für das Hochschulauswahlverfahren von 24% auf 60%. (Art. 9, 11, 12, 13, 14)&lt;br /&gt;Verkürzung der Kündigungsfrist auf ein Jahr (Art. 19 Abs. 2)&lt;br /&gt;(Entwurf des Staatsvertrages: Drs 15/4978)"/>
