			<string key="Desk" value="Meldewesen"/>
			<string key="Titel" value="Gesetz zur Regelung von Zuständigkeiten im Meldewesen, zur Bestimmung der eID-Karte-Behörden, zur Änderung des Gesetzes über das Verfahrender Berliner Verwaltung und zur Aufhebung von weiteren Gesetzen"/>
