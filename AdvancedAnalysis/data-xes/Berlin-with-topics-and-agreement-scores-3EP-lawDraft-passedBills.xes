			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-2946.pdf"/>
			<string key="Sb" value="1-18"/>
			<string key="Abstract" value="Neuanpassungen der Grundlagen für die Tätigkeiten der Seniorengremien auf Bezirks- und Landesebene. Es soll die aktive Beteiligung von Seniorinnen und Senioren am gesellschaftlichen, politischen, sozialen und kulturellen Leben fördern.&lt;br&gt;Einfügung § 3a,b , § 4a, § 8&lt;br&gt;&lt;br /&gt;Streichung § 4 Abs. 3, § 4 Abs. 5 u. 6, § 6 Abs. 2 u. 3, § 7 Abs. 3&lt;br&gt;&lt;br /&gt;Änderung § 7 Abs. 2 Satz 1&lt;br&gt;&lt;br /&gt;§ 4 Abs. 4 wird zum neuen Abs. 3&lt;br&gt;&lt;br /&gt;§ 6 Abs. 4 u. 5 werden zu 2 u. 3 \\nVorabüberweisung an AGesSoz u. AHaupt"/>
			<string key="Redner" value="nan"/>
