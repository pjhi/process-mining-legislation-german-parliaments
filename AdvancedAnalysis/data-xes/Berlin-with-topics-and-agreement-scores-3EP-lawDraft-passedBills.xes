			<string key="Titel" value="Viertes Gesetz zur Änderung des Fraktionsgesetzes und Neunzehntes Gesetz zur Änderung des Landesabgeordnetengesetzes"/>
			<string key="DokNr" value="16/2808"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Die Linke Fraktion Berlin (Die Linke)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
