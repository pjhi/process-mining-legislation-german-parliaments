			<string key="Desk" value="Öffentlicher Auftrag"/>
			<string key="Titel" value="Zweites Gesetz zur Änderung des Berliner Ausschreibungs- und Vergabegesetzes&lt;br /&gt;(Gesetz zur Änderung des Berliner Ausschreibungs- und Vergabesetzes und weiterer Rechtsvorschriften)"/>
			<string key="DokNr" value="18/2538"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-2538.pdf"/>
			<string key="Sb" value="1-127"/>
			<string key="Abstract" value="Vorgaben für die Einhaltung zwingend zu berücksichtigender sozialer und ökologischer Kriterien bei der Beschaffung / Anhebung des vergabespezifischen Mindest-Entgelts auf 12,50 € / Gültigkeit des Gesetzes für öffentliche Aufträge im Bereich von Liefer- und Dienstleistungen einheitlich ab einer Wertgrenze von 10.000 Euro, bei Bauleistungen ab 50.000 Euro / Erstmalige Berücksichtigung der Interessen von kleinen und mittleren Unternehmen in Vergabeprozessen / Stärkung der zentralen Kontrollgruppe durch die Einführung eines Informations- und Anforderungsrechts gegenüber den Vergabestellen&lt;br&gt;&lt;br /&gt;Artikelgesetz:&lt;br&gt;Artikel 1: Berliner Ausschreibungs- und Vergabegesetz (BerlAVG)&lt;br&gt;Artikel 2: Aufhebung der Verordnung zur Anpassung der Höhe des nach § 1 Absatz 4 Berliner Ausschreibungs- Vergabegesetz zu zahlenden Entgelts&lt;br&gt;Artikel 3: Ermächtigung zum Erlass einer Verwaltungsvorschrift zur Einrichtung eines Verzeichnisses ungeeigneter Bewerber und Bieter bei öffentlichen Aufträgen&lt;br&gt;Artikel 4: Änderung dVorabüberweisung an AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
