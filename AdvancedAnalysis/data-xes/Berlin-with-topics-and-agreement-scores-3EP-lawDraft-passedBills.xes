			<string key="Desk" value="Verkehrspolitik"/>
			<string key="Titel" value="Gesetz zur Neuregelung gesetzlicher Vorschriften zur Mobilitätsgewährleistung"/>
			<string key="DokNr" value="18/0878"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-0878.pdf"/>
			<string key="Sb" value="1-86"/>
			<string key="Abstract" value="Definition der mittel- und langfristigen Ziele der Mobilitätspolitik unter Berücksichtigung von Klimaschutz, Umweltschutz, Aufenthaltsqualität und Verkehrssicherheit.&lt;br&gt;&lt;br /&gt;Gesetzlich vorgeschrieben werden künftig neben dem Nahverkehrsplan weitere Planwerke: Radverkehrsplan, integriertes Wirtschaftsverkehrskonzept, Fußverkehrsstrategie sowie Stadtentwicklungsplan Mobilität und Verkehr.&lt;br&gt;&lt;br /&gt;Vorrang für Öffentlichen Nahverkehr und Fahrräder vor dem Autoverkehr / Vorrang für Busse und Bahnen auf definierten Strecken / Bau &quot;geschützter&quot; Radwege an Hauptstraßen / Einrichtung von 100 Kilometer Radschnellwegen / Umbau geeigneter Nebenstraßen zu Fahrradstraßen / Aufstellung von Fahrradparkhäusern und Fahrradstationen an Bahnhöfen und Bushaltestellen / Beseitigung von Gefahrenstellen an Kreuzungen mit vielen Unfallverletzten / Ziel: keine Verkehrsunfälle mit schweren Personenschäden im Berliner Stadtgebiet (&quot;Vision Zero&quot;)&lt;br /&gt;&lt;br&gt;Artikelgesetz:&lt;br&gt;Artikel 1: Berliner Mobilitätsgesetz&lt;br&gt;Artikel 2: Änderung des"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
