			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-2740.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die bislang als Zweiländeranstalt geführte LBS Norddeutsche Landesbausparkasse Berlin - Hannover (LBS Nord) soll künftig als ausschließlich niedersächsische Anstalt des öffentlichen Rechts (A.ö.R.) auf Grundlage eines niedersächsischen LBS-Nord-Gesetzes weitergeführt werden. Das Geschäftsgebiet  wird auch weiterhin die Länder Niedersachsen und Berlin umfassen. \\nVorabüberweisung an AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
