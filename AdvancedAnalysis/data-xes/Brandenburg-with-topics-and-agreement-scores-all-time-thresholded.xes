			<string key="Titel" value="Erstes Gesetz zum Abbau von bürokratischen Hemmnissen im Land Brandenburg (Erstes Brandenburgisches Bürokratieabbaugesetz - 1. BbgBAG)" />
			<string key="DokNr" value="04/2735" />
