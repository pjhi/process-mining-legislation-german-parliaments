			<date key="time:timestamp" value="2017-09-26T02:00:00.000+02:00"/>
			<string key="@id" value="D-117476"/>
			<int key="ReihNr" value="1"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTypL" value="Gesetzentwurf"/>
			<string key="Desk" value="Telekommunikationsüberwachung"/>
			<string key="Titel" value="Gesetz zur Änderung des Landesverfassungsschutzgesetzes und des Ausführungsgesetzes zum Artikel 10-Gesetz"/>
			<string key="DokNr" value="16/2740"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/2000/16_2740_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 26.09.2017 Drucksache 16/2740 (29 S.)"/>
			<string key="Su" value="nan"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Erteilung der Befugnis zur Quellen-Telekommunikationsüberwachung als flankierende technische Regelung zur Telekommunikationsüberwachung an das Landesamt für Verfassungsschutz; Änderung der Vorschriften für Übermittlungen an und durch das Landesamt für Verfassungsschutz; Erstreckung der Finanzermittlungen auch auf Fälle um Bestrebungen gegen die freiheitliche demokratische Grundordnung; Aufnahme eines Benachteiligungsverbots in die Regelung zum Einholen von Auskünften bei nicht-öffentlichen Stellen; Erweiterung der Mitwirkungsaufgaben auf Zuverlässigkeitsüberprüfungen nach der Gewerbeordnung sowie bei Großveranstaltungen; Anpassung an das novellierte Bundesverfasungsschutzgesetz"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<int key="@@index" value="9805"/>
