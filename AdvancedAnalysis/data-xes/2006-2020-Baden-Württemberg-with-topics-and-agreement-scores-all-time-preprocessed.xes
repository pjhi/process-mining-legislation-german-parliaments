			<string key="Titel" value="Gesetz zur Reform des öffentlichen Dienstrechts (Dienstrechtsreformgesetz &amp;minus; DRG)"/>
			<string key="DokNr" value="14/6694"/>
			<string key="Urheber" value="Landesregierung"/>
