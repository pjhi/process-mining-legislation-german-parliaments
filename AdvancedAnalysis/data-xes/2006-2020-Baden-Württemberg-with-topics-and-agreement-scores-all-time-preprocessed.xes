			<string key="Titel" value="Gesetz zur Änderung von Vorschriften zur Anerkennung ausländischer Berufsqualifikationen in Baden-Württemberg"/>
			<string key="DokNr" value="15/7554"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP15/Drucksachen/7000/15_7554_D.pdf"/>
