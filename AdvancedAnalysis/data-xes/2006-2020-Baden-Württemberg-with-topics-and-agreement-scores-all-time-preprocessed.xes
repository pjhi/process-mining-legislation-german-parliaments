			<string key="Titel" value="Gesetz zur Änderung des Abgeordnetengesetzes"/>
			<string key="DokNr" value="13/5086"/>
			<string key="Urheber" value="Sozialdemokratische Partei Deutschlands (SPD)"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP13/Drucksachen/5000/13_5086_D.pdf"/>
