			<string key="Titel" value="Gesetz über den Datenschutz im Justizvollzug in Baden-Württemberg (Justizvollzugsdatenschutzgesetz &amp;minus; JVollzDSG)"/>
			<string key="DokNr" value="14/1241"/>
