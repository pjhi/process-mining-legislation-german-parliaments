			<string key="Urheber" value="[&apos;Christlich-Demokratische Union (CDU)&apos;, &apos;BÜNDNIS 90/DIE GRÜNEN (GRÜNE)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Freie Demokratische Partei / Demokratische Volkspartei (FDP/DVP)&apos;]"/>
