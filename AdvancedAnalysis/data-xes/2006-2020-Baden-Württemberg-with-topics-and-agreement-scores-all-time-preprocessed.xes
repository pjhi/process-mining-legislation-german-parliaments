			<string key="Titel" value="Gesetz zur Änderung der Verfassung des Landes Baden-Württemberg und des Gesetzes über den Staatsgerichtshof sowie anderer Gesetze"/>
			<string key="DokNr" value="15/7378"/>
			<string key="Urheber" value="Landesregierung"/>
