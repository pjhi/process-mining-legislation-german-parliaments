			<string key="DokNr" value="15/5038" />
			<string key="Urheber" value="['Sozialdemokratische Partei Deutschlands (SPD)', 'Christlich Demokratische Union Deutschlands (CDU)', 'Partei des Demokratischen Sozialismus (Die Linkspartei.PDS)', 'Bündnis 90/Die GRÜNEN (Grüne)', 'Freie Demokratische Partei (FDP)']" />
