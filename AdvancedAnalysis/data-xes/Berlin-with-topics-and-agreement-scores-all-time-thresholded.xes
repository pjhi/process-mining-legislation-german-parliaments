			<string key="Titel" value="Änderung der Verfassung von Berlin -    &lt;br /&gt;Wahlrecht auf Bezirksebene schon mit 16 Jahren    &lt;br /&gt;(Sechstes Gesetz zur Änderung der Verfassung von Berlin)" />
			<string key="DokNr" value="15/4068" />
