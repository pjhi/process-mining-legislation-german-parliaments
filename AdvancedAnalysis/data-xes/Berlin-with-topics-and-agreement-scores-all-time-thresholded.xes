			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)" />
			<string key="Desk" value="Haushaltsgesetz 1999" />
			<string key="Titel" value="Gesetz über die Feststellung des Haushaltsplans von Berlin für das Haushaltsjahr 1999  &lt;br /&gt;(Haushaltsgesetz 1999 - HG 99)" />
			<string key="DokNr" value="13/2973" />
			<float key="Urheber" value="nan" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d2973.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value="Aus der Begründung: Der Entwurf enthält die erforderlichen&lt;br /&gt;Regelungen über die Feststellung des Haushaltsplans (§ 1), die&lt;br /&gt;Festsetzung der Hebesätze für die Gemeindesteuern, die&lt;br /&gt;Höchstbeträge der Kreditermächtigungen (§ 3), die&lt;br /&gt;Ermächtigungen zur Übernahme von Bürgschaften und&lt;br /&gt;Sonderfinanzierungen (§ 6). Die Regelungen über&lt;br /&gt;haushaltswirtschaftliche Sperren (3 8) und die&lt;br /&gt;Deckungsfähigkeit (§ 12) wurden als bewährte Vorschriften&lt;br /&gt;unverändert übernommen. Neu ist § 13, der die Fortgeltung des&lt;br /&gt;Haushaltsgesetzes bis zur Verkündung des nächsten&lt;br /&gt;Haushaltsgesetzes regelt.&lt;br /&gt; Außer Kraft treten:&lt;br /&gt; Landesbürgschaftsgesetz; Rückbürgschaftsgesetz; Viertes&lt;br /&gt; Wohnungsbaubürgschaftsgesetz; Gesetz über die Übernahme&lt;br /&gt; von Landesbürgschaften für Darlehen an Berliner&lt;br /&gt; Wohnungssuchende im öffentlich geförderten sozialen&lt;br /&gt; Wohnungsbau" />
			<float key="Redner" value="nan" />
			<float key="HNr" value="nan" />
			<float key="Jg" value="nan" />
			<float key="NrInTyp" value="nan" />
