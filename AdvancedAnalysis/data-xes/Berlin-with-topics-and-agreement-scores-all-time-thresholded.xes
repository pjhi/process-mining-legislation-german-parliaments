			<string key="DokTypL" value="Antrag (Gesetzentwurf)" />
			<string key="Desk" value="Fehlbelegungsabgabe" />
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes über den Abbau der Fehlsubventionierung im Berliner Wohnungswesen (AFWoG Bln)" />
			<string key="DokNr" value="12/3461" />
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (B90/Gr)" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-3461.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value='Die bisherige Regelung sieht bei nicht fristgemäßem Nachweis der Einkommensverhältnisse vor, dem Zahlungspflichtigen den Höchstbetrag aufzuerlegen. Erfolgt der Einkommensnachweis verspätet, darf bisher die Leistungspflicht nur für die Zukunft herabgesetzt werden. Diese Regelung führte zu nicht vertretbaren Härten. Das soll mit einer "Härteklausel" ausgeschlossen werden.' />
			<float key="Redner" value="nan" />
			<float key="HNr" value="nan" />
			<float key="Jg" value="1993.0" />
