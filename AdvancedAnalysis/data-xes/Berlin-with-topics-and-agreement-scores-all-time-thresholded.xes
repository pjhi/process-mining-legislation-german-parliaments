		<event>
			<string key="lifecycle:transition" value="complete" />
			<string key="DBID" value="D-174108" />
			<int key="ReihNr" value="1" />
			<string key="DokArt" value="Drs" />
			<string key="DokArtL" value="Drucksache" />
			<string key="DokTyp" value="Antr (GesEntw)" />
			<string key="DokTypL" value="Antrag (Gesetzentwurf)" />
			<string key="Desk" value="Schulgesetz" />
			<string key="Titel" value="Gesetz zur Änderung des Schulgesetzes für das Land Berlin (Schulgesetz - SchulG) -&lt;br /&gt;Ergänzende Förderung und Betreuung für Kinder mit besonderem Förderbedarf ab Jahrgangsstufe 5" />
			<string key="DokNr" value="15/5192" />
			<string key="Urheber" value="Christlich Demokratische Union Deutschlands (CDU)" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-5192.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value="Für Schülerinnen und Schüler mit Behinderungen und einem sonderpädagogischen Förderbedarf ist auch nach der Jahrgangsstufe 4 bis zur Vollendung ihrer Schulzeit, unabhängig von der Berufstätigkeit der Eltern, außerunterrichtliche Betreuung und Förderung anzubieten.&lt;br /&gt;Änderung § 19" />
			<float key="Redner" value="nan" />
