			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)" />
			<string key="Desk" value="Hochschulzulassungsgesetz" />
			<string key="Titel" value="Zweites Gesetz zur Änderung des Berliner Hochschulzulassungsgesetzes" />
			<string key="DokNr" value="12/0322" />
			<float key="Urheber" value="nan" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0322.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value="Mit der Anpassung des Gesetzes über die Zulassung zu den Hochschulen des Landes Berlin in zulassungsbeschränkten&lt;br /&gt;Studiengängen, an die Regelungen des Hochschulrahmengesetz (HRG) entspricht das Land Berlin seiner gesetzlichen&lt;br /&gt;Verpflichtung. Des weiteren war für eine Übergangszeit den derzeit noch unterschiedlichen Ausbildungsstrukturen im&lt;br /&gt;östlichen und im westlichen Teil des Landes Berlin Rechnung zu tragen sowie die in der ehemaligen DDR praktizierte Zulassung für künftige Studienjahre zu berücksichtigen. \\nVorabüberweisung an AWissForsch" />
			<float key="Redner" value="nan" />
			<float key="HNr" value="nan" />
			<float key="Jg" value="1991.0" />
