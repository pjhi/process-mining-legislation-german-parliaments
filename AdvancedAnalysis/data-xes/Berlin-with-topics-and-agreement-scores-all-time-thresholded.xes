			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)" />
			<string key="Desk" value="Zuständigkeit (Verwaltung)" />
			<string key="Titel" value="Gesetz zur Änderung zuständigkeitsrechtlicher Vorschriften auf dem Gebiet des Sozialwesens" />
			<string key="DokNr" value="16/3590" />
			<float key="Urheber" value="nan" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-3590.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value="Die Anlagen zum Allgemeinen Zuständigkeitsgesetz und zum Allgemeinen Sicherheits- und Ordnungsgesetzes bedürfen der Anpassung an die Regelungen des Aufenthaltsgesetzes im Zusammenhang mit der Aufnahme von Flüchtlingen. Eine verbindliche Regelung dazu, welche Behörden im Land Berlin für die Aufnahme einschließlich der Erstversorgung und Unterbringung im Rahmen gezielter Aufnahmeaktionen ausländischer Flüchtlinge zuständig ist, existiert bislang erst für einen kleinen Teil der im Aufenthaltsrecht vorgesehenen Formen der Aufnahme aus dem Ausland.&lt;br&gt;Mit geändert wurden:&lt;br&gt;Allgemeines Zuständigkeitsgesetz, Allgemeines Sicherheits- und Ordnungsgesetz (ASOG)" />
			<float key="Redner" value="nan" />
			<float key="HNr" value="nan" />
