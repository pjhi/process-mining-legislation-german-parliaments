			<string key="Desk" value="Rechtseinheit" />
			<string key="Titel" value="Erstes Gesetz zur Änderung des Gesetzes über die Vereinheitlichung des Berliner Landesrechts" />
			<string key="DokNr" value="12/0871" />
			<float key="Urheber" value="nan" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-0871.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value="Die in den Aufgabenbereichen des öffentlichen Personennahverkehrs, der Wasserversorgung und&lt;br /&gt;Abwasserentsorgung, der Stadtreinigung sowie der Hafen- und Lagerwirtschaft tätigen Eigenbetriebe in den östlichen&lt;br /&gt;und westlichen Stadtbezirken sollen jeweils zu einem Eigenbetrieb für ganz Berlin zusammengefaßt werden. &lt;br /&gt;Fusion der Eigenbetriebe:&lt;br /&gt;die Berliner Verkehrsbetriebe (BVB) in die Berliner Verkehrs-Betriebe (BVG);&lt;br /&gt;die Wasserversorgung und Abwasserbehandlung Berlin in die Berliner Wasser-Betriebe (BWB),&lt;br /&gt;die Stadtreinigung Berlin in die Berliner StadtreinigungsBetriebe (BSR),&lt;br /&gt;der Osthafen Berlin in die Behala Berliner Hafen- und Lagerhaus-Betriebe \\nVorabüberweisung an ARecht, AVerkBetr u. AHaupt" />
