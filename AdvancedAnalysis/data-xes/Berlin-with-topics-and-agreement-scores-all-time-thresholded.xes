			<string key="DokNr" value="11/1033" />
			<string key="Urheber" value="['Christlich Demokratische Union Deutschlands (CDU)', 'Sozialdemokratische Partei Deutschlands (SPD)', 'Bündnis 90/Die GRÜNEN (GRÜNE/AL)']" />
