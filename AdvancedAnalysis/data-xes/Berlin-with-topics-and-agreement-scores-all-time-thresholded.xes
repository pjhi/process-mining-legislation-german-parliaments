			<string key="DokTyp" value="VorlBeschl (GesEntw)" />
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)" />
			<string key="Desk" value="Anstalt des öffentlichen Rechts" />
			<string key="Titel" value="Erstes Gesetz zur Änderung des Berliner Betriebe-Gesetzes (BerlBG)" />
			<string key="DokNr" value="16/0935" />
			<float key="Urheber" value="nan" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-0935.pdf" />
			<string key="Sb" value="1-70" />
			<string key="Abstract" value="Ab dem 01.01.2008 soll  die Erbringung der Leistungen im Verkehr mit U-Bahn, Straßenbahn, Bus und Fähre durch die BVG im Rahmen einer Direktvergabe in Form eines Verkehrsvertrages durch das Land Berlin an die BVG erfolgen. Dazu ist es erforderlich, europarechtliche Vorgaben durch für das Land bestehende Weisungs- und Kontrollrechte zu erfüllen.&lt;br /&gt;Darüber hinaus bestand bislang in Berlin, anders als in den Flächenbundesländern, kein Anschluss- und Benutzungszwang für die Wasserversorgung. Dieser soll aus Gründen des öffentlichen Wohls eingeführt werden." />
			<float key="Redner" value="nan" />
			<float key="HNr" value="nan" />
			<float key="Jg" value="nan" />
