			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)" />
			<string key="Desk" value="Fehlbelegungsabgabe" />
			<string key="Titel" value="Gesetz über den Abbau der Fehlsubventionierung im Berliner Wohnungswesen (AFWoG Bln)" />
			<string key="DokNr" value="12/1190" />
			<float key="Urheber" value="nan" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1190.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value="Es ist vorgesehen, für sehr gut Verdienende den Subventionsvorteil stärker abzubauen und dafür mehr als drei Grundbeträge vorzusehen. Ferner ist, insbesondere aus praktischen Erwägungen beim Vollzug des Gesetzes, vorgesehen, einen Teil der öffentlich geförderten Wohnungen einer anderen Jahrgangsgruppe zuzuordnen. Um das Gesetz sozial gerechter zu gestalten, beginnt nunmehr die Leistungspflicht erst bei einer Überschreitung der Einkommensgrenze um mehr als 25 vom Hundert. \\nVorabüberweisung an ABauWohn u. AHaupt" />
			<float key="Redner" value="nan" />
			<float key="HNr" value="nan" />
			<float key="Jg" value="1992.0" />
