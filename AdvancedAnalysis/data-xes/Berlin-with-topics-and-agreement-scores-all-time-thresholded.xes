			<string key="DokTypL" value="Antrag (Gesetzentwurf)" />
			<string key="Desk" value="Schulgesetz" />
			<string key="Titel" value="Gesetz zur Änderung des Schulgesetzes für das Land Berlin" />
			<string key="DokNr" value="17/1137" />
			<string key="Urheber" value="PIRATEN (Piraten)" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-1137.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value="Nach diesem Gesetz  werden Kinder, deren Entwicklung in für die Schule wichtigen Kompetenzbereichen schneller fortschreitet als bei anderen Kindern, nicht nur nach einem, sondern auch zwei Jahre früher eingeschult .&lt;br&gt;Änderung § 42 Abs, 2 u. 3" />
			<float key="Redner" value="nan" />
