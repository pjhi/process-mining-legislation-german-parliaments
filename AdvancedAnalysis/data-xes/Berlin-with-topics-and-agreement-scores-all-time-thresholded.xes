			<string key="Titel" value="Erstes Gesetz zur Änderung des Gesetzes über die Aufgaben und die Weiterentwicklung des öffentlichen Personennahverkehrs im Land Berlin (ÖPNV-Gesetz)" />
			<string key="DokNr" value="13/0720" />
			<string key="Urheber" value="Partei des Demokratischen Sozialismus (PDS)" />
