			<string key="Desk" value="Wohnungsbauförderung" />
			<string key="Titel" value="Berliner Wohnraumförderungsgesetz (BWoFG)" />
			<string key="DokNr" value="16/3350" />
			<string key="Urheber" value="Christlich Demokratische Union Deutschlands (CDU)" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-3350.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value="Aufforderung an den Senat, den Entwurf eines Berliner Wohnraumförderungsgesetzes (BWoFG) vorzulegen, das das bisherige Wohnraumförderungsgesetz sowie das Wohnungsbindungsgesetz ersetzt. Ziele sind die Förderung von Berechtigten durch Subjekt- statt Objektförderung, sozialer Entmischung entgegenzuwirken, die Sanierung von Bestandswohnungen zum Zwecke der Energieeinsparung und des Umweltschutzes, die Abschaffung des bisherigen Systems der Kostenmiete.&lt;br&gt;&lt;br /&gt;Berichtsauftrag bis zum 31.12.2010" />
			<float key="Redner" value="nan" />
			<float key="HNr" value="nan" />
