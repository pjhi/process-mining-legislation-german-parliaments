			<string key="DokNr" value="15/3346" />
			<string key="Urheber" value="['Sozialdemokratische Partei Deutschlands (SPD)', 'Christlich Demokratische Union Deutschlands (CDU)', 'Partei des Demokratischen Sozialismus (PDS)', 'Bündnis 90/Die GRÜNEN (Grüne)', 'Freie Demokratische Partei (FDP)']" />
