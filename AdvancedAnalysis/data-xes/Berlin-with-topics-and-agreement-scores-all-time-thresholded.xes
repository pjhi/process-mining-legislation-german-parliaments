			<string key="DokTypL" value="Antrag (Gesetzentwurf)" />
			<string key="Desk" value="Verwaltungsreform" />
			<string key="Titel" value="Drittes Gesetz zur Reform der Berliner Verwaltung  &lt;br /&gt;(Drittes Verwaltungsreformgesetz)  &lt;br /&gt; (Zweites Gesetz zur Reform der Berliner Verwaltung (2. Verwaltungsreformgesetz 2. VerwrefG))" />
			<string key="DokNr" value="13/2537" />
			<string key="Urheber" value="Sozialdemokratische Partei Deutschlands (SPD)" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d2537.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value="Der Senat nimmt durch die Hauptverwaltung die Aufgaben von gesamtstädtischer Bedeutung wahr; dazu gehören Leitungsaufgaben sowie Polizei, Justiz und Steuerverwaltung. Die Bezirksverwaltungen nehmen alle anderen Aufgaben der Verwaltung wahr &lt;br&gt;Mit geändert wurden:  Allgemeines Zuständigkeitsgesetz; Allgemeines Sicherheits- und Ordnungsgesetz (ASOG); Gesetz über die Zuständigkeit der  Ordnungsbehörden; Bezirksverwaltungsgesetz; Gesetz zur Ausführung des Baugesetzbuchs; Berliner Straßengesetz; Gesundheitsdienst-Gesetz; Gesetz zur Ausführung des Bundesozialhilfegesetzes; Kindertagesbetreuungsgesetz;  Gesetz zur Ausführung des Kinder- und Jugendhilfegesetzes; \\nVorabüberweisung an AInn f, ARecht u. ASonVerwRef" />
			<float key="Redner" value="nan" />
			<float key="HNr" value="nan" />
			<float key="Jg" value="nan" />
