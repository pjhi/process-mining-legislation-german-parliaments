			<string key="Desk" value="Kinderbetreuung" />
			<string key="Titel" value="Gesetz zur Ganztagsbetreuung für die Jahrgangsstufen 5 und 6 und für Schülerinnen und Schüler mit Behinderungen" />
			<string key="DokNr" value="17/0333" />
			<float key="Urheber" value="nan" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-0333.pdf" />
			<string key="Sb" value="1-53" />
			<string key="Abstract" value='Angebot der ergänzenden Förderung und Betreuung für Kinder der Jahrgänge 5 und &lt;br /&gt;6 an Schultagen von 6.00 Uhr bis 18.00 Uhr bei Nachweis eines Betreuungsbedarfs.&lt;br /&gt;Der Nachweis eines besonderen Bedarfs ist künftig nur noch für die Ferienbetreuung&lt;br /&gt;erforderlich.&lt;br&gt;&lt;br /&gt;Angebot eines zusätzlichen Betreuungsmoduls in der Zeit zwischen 15.00 Uhr und&lt;br /&gt;16.00 Uhr für Schülerinnen und Schüler, die mit sonderpädagogischem Förderbedarf&lt;br /&gt;im Bereich "Geistige Entwicklung" ein Förderzentrum in der Eingangs-, Unter- oder&lt;br /&gt;Mittelstufe besuchen sowie für Schülerinnen und Schüler mit schweren&lt;br /&gt;Behinderungen im gemeinsamen Unterricht an den Integrierten&lt;br /&gt;Sekundarschulen.&lt;br&gt;&lt;br /&gt;Klarstellungen zur Kostenbeteiligung für vorzeitig eingeschulte Kinder, zu&lt;br /&gt;Finanzierungs- und Vertragsregelungen für im Land Berlin betreute Brandenburger&lt;br /&gt;Kinder sowie zur Finanzierung bei Betreuungsende innerhalb eines Monats&lt;br&gt;Artikelgesetz:&lt;br&gt;Artikel I: Änderung des Schulgesetzes&lt;br&gt;Artikel II: Änderung des TagesbetreuungskostenbeteiligunggeVorabüberweisung an AHaupt' />
			<float key="Redner" value="nan" />
			<float key="HNr" value="nan" />
			<float key="Jg" value="nan" />
			<float key="NrInTyp" value="nan" />
			<string key="VkDat" value="NaT" />
