			<string key="DokTypL" value="Antrag (Gesetzentwurf)" />
			<string key="Desk" value="Fehlbelegungsabgabe" />
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes über den Abbau der Fehlsubventionierung im Berliner Wohnungswesen (AFWoG Bln)" />
			<string key="DokNr" value="12/3460" />
			<string key="Urheber" value="['Sozialdemokratische Partei Deutschlands (SPD)', 'Christlich Demokratische Union Deutschlands (CDU)']" />
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-3460.pdf" />
			<float key="Sb" value="nan" />
			<string key="Abstract" value='Die bisherige Regelung sieht bei nicht fristgemäßem Nachweis der Einkommensverhältnisse vor, daß der Zahlungspflichtige&lt;br /&gt;den Höchstbetrag zu entrichten hat. Erfolgt der Einkommensnachweis verspätet, darf nach geltendem Recht die Leistungspflicht nur für die Zukunft herabgesetzt werden. Diese Regelung führte zu nicht vertretbaren Härten. Daher soll eine "Härteklausel" geschaffen werden.' />
			<float key="Redner" value="nan" />
			<float key="HNr" value="nan" />
			<float key="Jg" value="1993.0" />
			<string key="NrInTyp" value="12/0" />
