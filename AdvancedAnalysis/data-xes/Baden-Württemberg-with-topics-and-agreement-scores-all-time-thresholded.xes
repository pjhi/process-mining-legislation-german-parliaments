			<string key="Titel" value="Gesetz zur Umsetzung der Bahnstrukturreform und zur Gestaltung des öffentlichen Personennahverkehrs in Baden-Württemberg" />
			<string key="DokNr" value="11/5626" />
			<string key="Urheber" value="Landesregierung" />
