			<string key="DokTypL" value="Gesetzentwurf" />
			<string key="Desk" value="Brücke" />
			<string key="Titel" value='Gesetz zu dem Staatsvertrag zwischen dem Land Baden-Württemberg und dem Freistaat Bayern über die Planfeststellungen für die Maßnahmen "Verlegung der L 2310 neu / St 2315 bei Collenberg (Ortsteil Kirschfurt) mit Neubau einer Mainbrücke" sowie "Ersatzneubau der Brücke über den Main bei Wertheim – Kreuzwertheim"' />
			<string key="DokNr" value="16/9921" />
			<string key="Urheber" value="Landesregierung" />
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/9000/16_9921_D.pdf" />
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 09.01.2021 Drucksache 16/9921  (13 S.)" />
			<float key="Su" value="13.0" />
			<float key="Sb" value="nan" />
			<float key="Redner" value="nan" />
			<string key="Abstract" value="Übertragung der hoheitlichen Befugnis zum Tätigwerden für die konkreten Verfahren auf dem Gebiet des Landes Baden-Württemberg auf den Freistaat Bayern auf staatsvertraglicher Grundlage, insbesondere Durchführung der Planung und der hierfür erforderlichen Planfeststellungsverfahren der beiden länderübergreifenden Maßnahmen „Verlegung der L 2310 neu / St 2315 bei Collenberg (Ortsteil Kirschfurt) mit Neubau einer Mainbrücke“ sowie „Ersatzneubau der Brücke über den Main bei Wertheim – Kreuzwertheim“ unter Federführung der Bayerischen Staatsbauverwaltung, Vereinbarung zur Durchführung des Planfeststellungsverfahrens ausschließlich nach den für die bayerische Straßenbauverwaltung gültigen Vorschriften und Richtlinien, Legitimierung der Bayerischen Staatsbauverwaltung zur ausschließlichen Anwendung bayerischen Recht für die Durchführung beider Maßnahmen – auch auf baden-württembergischem Hoheitsgebiet" />
			<string key="VkDat" value="NaT" />
