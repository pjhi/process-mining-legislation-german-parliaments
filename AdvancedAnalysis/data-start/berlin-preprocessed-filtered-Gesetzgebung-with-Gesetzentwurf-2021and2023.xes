			<string key="Titel" value="Zweites Gesetz zur Änderung des Marktüberwachungsverordnungs-Durchführungsgesetzes für Bauprodukte für&lt;br /&gt;Bauprodukte"/>
			<string key="DokNr" value="19/1428"/>
			<string key="Urheber" value="nan"/>
