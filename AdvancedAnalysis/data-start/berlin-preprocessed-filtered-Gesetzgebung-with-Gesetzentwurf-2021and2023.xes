			<string key="DokNr" value="19/0771"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Die Linke Fraktion Berlin (Die Linke)&apos;]"/>
