			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Abwasser"/>
			<string key="Titel" value="Zwölftes Gesetz zur Änderung des Berliner Wassergesetzes – Einbeziehung der Berliner Wasserbetriebe (BWB) in die Abfuhr von Abwasser aus abflusslosen Abwassersammelbecken und von nicht separiertem Klärschlamm"/>
			<string key="DokNr" value="19/0668"/>
			<string key="Urheber" value="Christlich Demokratische Union Deutschlands (CDU)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/19/DruckSachen/d19-0668.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Berliner Wasserbetrieben (BWB) sollen die Möglichkeit haben, auf Grundstücken, die nicht an die öffentliche Kanalisation angeschlossen sind, Abwasser aus abflusslosen Abwassersammelbehältern sowie den nicht separierten Klärschlamm&lt;br /&gt;aus Kleinkläranlagen zu entsorgen. Die Möglichkeit, dass die Entsorgung durch geeignete Fachbetriebe vorgenommen wird, bleibt dabei erhalten.&lt;br /&gt;Änderung § 29e Abs. 2"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="VkDat" value="nan"/>
