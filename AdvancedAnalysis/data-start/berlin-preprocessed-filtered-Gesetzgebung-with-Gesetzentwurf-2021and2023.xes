			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Berlin/Brandenburg"/>
			<string key="Titel" value="Gesetz zu dem Sechsten Staatsvertrag über die Änderung des Landesplanungsvertrages"/>
			<string key="DokNr" value="19/1574"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/19/DruckSachen/d19-1574.pdf"/>
			<string key="Sb" value="1-42"/>
			<string key="Abstract" value="Aus Gründen der Rechtsklarheit und Rechtssicherheit für die Verfahren der gemeinsamen Landesplanung sind Anpassungen des Landesplanungsvertrages erforderlich. Das Landesrecht soll ergänzende Regelungen treffen, soweit der Bund von seiner konkurrierenden Gesetzgebungsbefugnis keinen Gebrauch gemacht hat. Die vorgesehenen Änderungen dienen zugleich der Deregulierung und Vereinfachung der landesplanerischen Verfahren. Die Transformation des Staatsvertrags in Landesrecht erfolgt durch Gesetz. \\nsiehe auch Drucksache 19/1408"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
