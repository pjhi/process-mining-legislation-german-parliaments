			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Krebs (Krankheit)"/>
			<string key="Titel" value="Gesetz zum Staatsvertrag Klinisch-epidemiologisches Krebsregister Brandenburg-Berlin"/>
			<string key="DokNr" value="19/0521"/>
			<string key="Urheber" value="nan"/>
