			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Wasserpreis"/>
			<string key="Titel" value="Gesetz zur Abschaffung des Grundwasserentnahmegesetzes"/>
			<string key="DokNr" value="16/2835"/>
			<string key="Urheber" value="Freie Demokratische Partei (FDP)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-2835.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Grundwasserentnahmeentgelt in Berlin ist mit 31 Cent/m³ mit Abstand das höchste in Deutschland. In anderen Bundesländern beträgt das Grundwasserentnahmeentgelt mit 1-5 Cent/m³ einen Bruchteil des Berliner Entgelts, so in Hamburg 5,5 Cent/m³, in Sachsen 1,5 Cent/m³, in Hessen wurde es bereits ganz abgeschafft."/>
