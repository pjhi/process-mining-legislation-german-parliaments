			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Versammlung"/>
			<string key="Titel" value="Die „öffentliche Ordnung” gehört wieder in das Versammlungsrecht! - Gesetz zur Änderung des Versammlungsfreiheitsgesetzes Berlin&lt;br /&gt;(Gesetz zur Änderung des Versammlungsfreiheitsgesetzes Berlin)"/>
			<string key="DokNr" value="19/0319"/>
			<string key="Urheber" value="Christlich Demokratische Union Deutschlands (CDU)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/19/DruckSachen/d19-0319.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Grundrecht der Versammlungsfreiheit, der informationellen Selbstbestimmung, der Freiheit der Person, der Freizügigkeit sowie die entsprechenden Grundrechte des Grundgesetzes werden nach Maßgabe dieses Gesetzes eingeschränkt.&lt;br /&gt;Änderung § 3 Abs. 2 Nr. 2; § 10 Abs. 1; § 14 Abs. 1 u. 4; § 16 Abs. 1 u. 2; § 17 Abs. 1 Satz 1; § 18 Abs. 1 u. 3;"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
