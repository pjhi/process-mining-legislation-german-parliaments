			<string key="Desk" value="Vermögensverwaltung"/>
			<string key="Titel" value="Erstes Gesetz zur Änderung des Gesetzes über die Errichtung eines Sondervermögens Immobilien des Landes Berlin"/>
			<string key="DokNr" value="15/2572"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-2572.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Aufnahme eines nicht im Eigentum des Landes Berlin stehenden Grundstückes in das Sondervermögen ist nicht zulässig. Durch die Streichung des Grundstückes Görrestraße 12 - 14 aus dem SILB ErrichtungsG soll klargestellt werden, dass es sich bei dem genannten Grundstück nicht um einen Bestandteil des Sondervermögens handelt."/>
