		<string key="VorgangsDeskriptoren" value="[&apos;Berliner Hafen- und Lagerhaus-Betriebe (bis 31.12.1993)&apos;, &apos;Berliner Stadtreinigungs-Betriebe (bis 31.12.1993)&apos;, &apos;Berliner Verkehrs-Betriebe (bis 31.12.1993)&apos;, &apos;Berliner Wasser-Betriebe (bis 31.12.1993)&apos;, &apos;Eigenbetrieb&apos;]"/>
