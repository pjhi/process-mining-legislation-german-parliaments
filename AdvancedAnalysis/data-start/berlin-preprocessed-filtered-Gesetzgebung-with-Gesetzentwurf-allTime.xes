			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Dienstrecht"/>
			<string key="Titel" value="Gesetz zur Einführung der Verwendungsbeförderung"/>
			<string key="DokNr" value="18/3042"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-3042.pdf"/>
			<string key="Sb" value="1-57"/>
			<string key="Abstract" value="Mit dem vorliegenden Gesetz wird für erfahrene Beamtinnen und Beamte des ersten Einstiegsamtes der Laufbahngruppe 2 die Möglichkeit geschaffen, in Ämter des zweiten  Einstiegsamtes  ihrer  Laufbahngruppe  mit  der  Wertigkeit  der  Besoldungsgruppe A14 befördert zu werden. Weitere Beförderungen sollen ausgeschlossen sein, ein anderweitiger Einsatz im Verwendungsbereich nicht.&lt;br&gt;Artikelgesetz:&lt;br&gt;Artikel 1: Änderung des Laufbahngesetzes&lt;br&gt;Artikel 2: Änderung der Laufbahnverordnung allgemeiner Verwaltungsdienst&lt;br&gt;Artikel 3: Änderung der Steuerverwaltungslaufbahnverordnung&lt;br&gt;Artikel 4: Änderung der Verordnung über Praxisaufstieg, Beförderungsqualifizierung und Sonderlaufbahngruppenwechsel der Beamtinnen und Beamten der Laufbahnfachrichtung Steuerverwaltung"/>
