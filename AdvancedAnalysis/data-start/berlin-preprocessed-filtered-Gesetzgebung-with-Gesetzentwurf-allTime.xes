			<string key="Titel" value="Zweites Gesetz zur Änderung des Gesetzes über den Abbau der Fehlsubventionierung im Berliner Wohnungswesen"/>
			<string key="DokNr" value="12/3957"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;]"/>
