			<string key="DokNr" value="13/3224"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3224.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Ruhegehaltsstaffel für Senatsmitglieder wird der&lt;br /&gt;veränderten Struktur im Beamtenversorgungsrecht mit dem Ziel&lt;br /&gt;angepaßt, daß als Ruhegehaltsanspruch z.B. nach einer&lt;br /&gt;fünfjährigen Amtszeit anstatt von bisher 50 v. H. künftig nur&lt;br /&gt;31,5 v. H. der Amtsbezüge zustehen. Dies entspricht der&lt;br /&gt;Regelung des Bundes und der Mehrzahl der Bundesländer."/>
