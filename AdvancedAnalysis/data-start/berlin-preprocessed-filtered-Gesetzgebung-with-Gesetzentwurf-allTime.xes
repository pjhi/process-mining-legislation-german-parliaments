			<string key="DokNr" value="19/1273"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/19/DruckSachen/d19-1273.pdf"/>
			<string key="Sb" value="1-41"/>
			<string key="Abstract" value="Ausgewählte Spitzenämter sollen im Land Berlin höher bewertet werden. Diese haushaltsgesetzlichen Maßgaben müssen besoldungsrechtlich nachvollzogen werden, um den Amtsinhaberinnen und Amtsinhabern die&lt;br /&gt;entsprechende Besoldung gewähren zu können. Ferner sind die entsprechenden Amtsbezeichnungen anzupassen.&lt;br /&gt;&lt;br&gt;Artikelgesetz:&lt;br&gt;Artikel 1: Änderung des Bundesbesoldungsgesetzes in der Überleitungsfassung für Berlin&lt;br&gt;Artikel 2: Änderung des Landesbesoldungsgesetzes"/>
			<string key="Redner" value="nan"/>
