			<string key="DokTyp" value="ÄndAntr"/>
			<string key="DokTypL" value="Änderungsantrag"/>
			<string key="Desk" value="nan"/>
			<string key="Titel" value="nan"/>
			<string key="DokNr" value="15/208-1"/>
			<string key="Urheber" value="Meyer, Christoph (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-0208-1.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Im Fall der Insolvenz der Bankgesellschaft Berlin AG aus&lt;br /&gt;außerhalb des in Abs. 1 beschriebenen&lt;br /&gt;Immobiliendienstleistungsgeschäfts liegenden Gründen, endet die&lt;br /&gt;Laufzeit der Garantie mit dem Eingang des Insolvenzantrages bei&lt;br /&gt;dem Insolvenzgericht."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Änderungsantrag"/>
			<int key="@@index" value="88878"/>
			<date key="DokDat" value="2002-04-09T00:00:00+00:00"/>
			<date key="DokDat_original" value="2002-09-04T00:00:00+00:00"/>
		</event>
		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="2002-04-09T02:00:00.000+02:00"/>
			<string key="DBID" value="D-153012"/>
			<int key="ReihNr" value="0007"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="BeschlEmpf"/>
			<string key="DokTypL" value="Beschlussempfehlung"/>
			<string key="Desk" value="nan"/>
			<string key="Titel" value="nan"/>
			<string key="DokNr" value="15/0342"/>
			<string key="Urheber" value="Hauptausschuss"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-0342.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Begrenzung des Haftungsrahmens auf eine Summe von höchstens&lt;br /&gt;21,6 Mrd. Euro Ende der Laufzeit: Ablauf des Jahres 2032.&lt;br /&gt;Vom Senat abzuschließende Garantievereinbarung&lt;br /&gt;(Detailvereinbarung) sowie alle zukünftigen, diese ergänzenden&lt;br /&gt;und ändernden Verträge bedürfen der Zustimmung des&lt;br /&gt;Abgeordnetenhauses. Schnellstmögliche Veräußerung des Anteils&lt;br /&gt;des Landes Berlin an Bankgesellschaft Berlin AG zu vertretbaren&lt;br /&gt;Bedingungen. Die Investitionsbank Berlin ist bis spätestens&lt;br /&gt;30.6.2003 als eigenständige öffentlich-rechtliche Strukturbank&lt;br /&gt;aus der Bankgesellschaft Berlin herauszulösen. Frühzeitige und&lt;br /&gt;umfassende Einbeziehung des Abgeordnetenhauses in Errichtung&lt;br /&gt;und Tätigkeit der Controllinggesellschaft."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Beschlussempfehlung"/>
			<int key="@@index" value="88879"/>
