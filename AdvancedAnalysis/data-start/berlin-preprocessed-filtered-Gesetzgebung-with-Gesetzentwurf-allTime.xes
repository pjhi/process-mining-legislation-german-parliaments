			<string key="DokNr" value="16/0824"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-0824.pdf"/>
			<string key="Sb" value="1-37"/>
			<string key="Abstract" value="Um zu vermeiden, dass allein wegen der Abgabenbefreiung finanziell und gewässerwirtschaftlich ungünstige Investitionen getätigt werden, wird die Abgabenfreiheit nunmehr sowohl im Bereich der Trenn- als auch der Mischkanalisation - unabhängig von der Art der verwendeten Anlage - an die Einhaltung der allgemein anerkannten Regeln der Technik geknüpft."/>
			<string key="Redner" value="nan"/>
