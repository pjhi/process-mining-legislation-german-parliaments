			<string key="Desk" value="Kabelfernsehen"/>
			<string key="Titel" value="Gesetz zur Überleitung der Versuche mit privatem Rundfunk in Berlin und zur Änderung des Kabelpilotprojektgesetzes"/>
			<string key="DokNr" value="11/0797"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/11/DruckSachen/d11-0797.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Kabelpilotprojekt Berlin wird gemäß § 6 KPPG nach&lt;br /&gt;fünfjähriger Laufzeit mit Ablauf des 28. August 1990&lt;br /&gt;beendet sein. Spätestens zu diesem Zeitpunkt entfällt die&lt;br /&gt;bisherige Rechtsgrundlage für die privaten Kabelprogramme&lt;br /&gt;in Berlin. Durch dieses Gesetz soll eine Übergangsregelung&lt;br /&gt;geschaffen werden. Änderung § 15 Abs. 4 \\nVorabüberweisung an AKult f u. ARecht"/>
			<string key="Redner" value="nan"/>
