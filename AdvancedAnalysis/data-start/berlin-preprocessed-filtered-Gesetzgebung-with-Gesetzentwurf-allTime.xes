			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Baugesetzbuch"/>
			<string key="Titel" value="Erstes Gesetz zur Änderung des Gesetzes zur Ausführung des Baugesetzbuchs"/>
			<string key="DokNr" value="12/1102"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1102.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Baugesetzbuch sieht für städtebauliche Festlegungen die Rechtsform einer Satzung vor. Die Satzung ist auf die&lt;br /&gt;Gemeinden in den Flächenländern zugeschnitten, nicht auf die Stadtstaaten, deren Verfassung Satzungen nicht&lt;br /&gt;vorsehen. Das Baugesetzbuch ermächtigt deshalb in § 246 Abs. 2 die Stadtstaaten zu bestimmen, welche Form der&lt;br /&gt;Rechtsetzung an die Stelle der vorgesehenen Satzungen tritt. Ziel des vorliegenden Gesetzentwurfs ist die Anpassung an&lt;br /&gt;die Formen der Rechtsetzung in Berlin und die Bestimmung der Zuständigkeiten, damit die Vorschriften anwendbar&lt;br /&gt;werden. An die Stelle der Satzungen sollen Rechtsverordnungen der zuständigen Senatsverwaltung, beim&lt;br /&gt;Entwicklungsbereich des Senats, treten. Die Formen der Rechtsverordnung entspricht der auch sonst gewählten Form&lt;br /&gt;der untergesetzlichen Norm. Im übrigen erhalten die vorgesehenen Vorschriften die im Baugesetzbuch vorgeschriebenen Hinweise sowie Regeln über das Verbindlichwerden der in den Rechtsvorschriften vorgesehenen Regelungen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
