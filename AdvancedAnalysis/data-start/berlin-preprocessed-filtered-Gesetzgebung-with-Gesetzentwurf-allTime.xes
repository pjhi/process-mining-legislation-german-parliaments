			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Landesentwicklungsprogramm"/>
			<string key="Titel" value="Gesetz zu dem Vierten Staatsvertrag über die Änderung des Landesplanungsvertrages"/>
			<string key="DokNr" value="15/5100"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-5100.pdf"/>
			<string key="Sb" value="1-16"/>
			<string key="Abstract" value="Anlass für das Gesetzgebungsverfahren ist die Richtlinie 2001/42/EG des Europäischen Parlaments und des Rates vom 27. Juni 2001 über die Prüfung der Umweltauswirkungen bestimmter Pläne und Programme, ABl. EG Nr. L 197 S. 30 (SUP-Richtlinie). Die Richtlinie betrifft das Verfahren der Aufstellung von Plänen und Programmen und soll dazu beitragen, dass Umwelterwägungen bei der Ausarbeitung von Plänen und Programmen einbezogen werden. Ziel ist eine Umweltprüfung mit Öffentichkeitsbeteiligung schon auf der räumlichen Planungsebene und nicht erst bei der Projektzulassung, bei der das Instrument der Umweltverträglichkeitsprüfung für bestimmte Vorhaben bereits besteht."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
