			<string key="Desk" value="Öffentlicher Haushalt"/>
			<string key="Titel" value="Erstes Gesetz zur Bereinigung des strukturellen Ungleichgewichts des Haushalts   &lt;br /&gt;(Erstes Haushaltsstrukturgesetz - 1. HStrG)  &lt;br /&gt;(Gesetz zur Änderung des Berliner Hochschulgesetzes; Gesetz über die Neuordnung der Zahnmedizin an den Universitäten des Landes Berlin)   &lt;br /&gt;(Neuordnungsgesetz Zahnmedizin - NOGZ))"/>
			<string key="DokNr" value="12/3174"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-3174.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der Finanzlage Rechnung tragend wird beabsichtigt, bei&lt;br /&gt;überschreiten der Regelstudienzeit Studiengebühren zu&lt;br /&gt;erheben. Auch empfiehlt sich die Konzentration der&lt;br /&gt;Zahnmedizin, die derzeit sowohl an der&lt;br /&gt;Humboldt-Universität als auch an der Freien Universität&lt;br /&gt;gelehrt wird, auf eine einzige Universität."/>
