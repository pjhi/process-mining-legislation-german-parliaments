		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1992-09-09T02:00:00.000+02:00"/>
			<string key="DBID" value="D-4977"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Pflegekosten"/>
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes über Pflegeleistungen und des Gesetzes über die Vereinheitlichung des Berliner Landesrechts"/>
			<string key="DokNr" value="12/1905"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1905.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Durch Neufestsetzung von Geldleistungen und Grundbeträgen&lt;br /&gt;nach dem Bundessozialhilfegesetz sind u.a. die Beträge der&lt;br /&gt;Blindenhilfe und des Pflegegeldes rückwirkend zum 1. Juli&lt;br /&gt;1992 erhöht worden. Dies hat zur Folge, daß im Ostteil&lt;br /&gt;Berlins die Leistungen nach dem Bundessozialhilfegesetz&lt;br /&gt;teilweise wesentlich höher sind als die vorrangigen&lt;br /&gt;vergleichbaren Leistungen nach dem Landesgesetz.&lt;br /&gt; Zudem ist in Anbetracht der seit dem 1. Januar 1991&lt;br /&gt;unveränderten Höhe der Geldleistungen nunmehr auch im&lt;br /&gt;Hinblick auf eine rasche Angleichung der&lt;br /&gt;Lebensverhältnisse die Erhöhung der Leistungen an&lt;br /&gt;Zivilblinde/hochgradig Sehbehinderte und&lt;br /&gt;Hilflose erforderlich."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="27587"/>
