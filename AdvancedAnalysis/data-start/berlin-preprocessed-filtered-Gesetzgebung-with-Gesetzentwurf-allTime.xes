			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Staatsvertrag"/>
			<string key="Titel" value="Gesetz zum Siebten Staatsvertrag zur Änderung rundfunkrechtlicher Staatsverträge (Siebter Rundfunkänderungsstaatsvertrag)"/>
			<string key="DokNr" value="15/2096"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-2096.pdf"/>
			<string key="Sb" value="1-26"/>
			<string key="Abstract" value="Die Regierungschefs der Länder und der Bund haben sich darauf verständigt, den Auftrag des öffentlich-rechtlichen Rundfunks&lt;br /&gt;einheitlich im Rundfunkstaatsvertrag, ARD-Staatsvertrag, ZDF-Staatsvertrag und Deutschlandradio-Staatsvertrag zu&lt;br /&gt;konkretisieren, um damit das Gleichgewicht zwischen öffentlich-rechtlichem und privatem Rundfunk im dualen Rundfunksystem fortzuentwickeln. Daneben soll die Gebührenbefreiung von PCs, die über das Internet Rundfunk empfangen können, verlängert werden.&lt;br /&gt; Mit geändert wurden:&lt;br /&gt; Änderung des ARD-Staatsvertrages; Änderung des&lt;br /&gt; ZDF-Staatsvertrages; Änderung des&lt;br /&gt; Rundfunkgebührenstaatsvertrages; Änderung des&lt;br /&gt; Deutschlandradiostaatsvertrages;"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
