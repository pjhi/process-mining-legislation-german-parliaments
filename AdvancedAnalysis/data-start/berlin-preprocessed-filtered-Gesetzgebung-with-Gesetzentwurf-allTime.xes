			<string key="Desk" value="Steuer"/>
			<string key="Titel" value="Gesetz zur Änderung zweitwohnungsteuerlicher und übernachtungsteuerlicher Vorschriften"/>
			<string key="DokNr" value="18/0268"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-0268.pdf"/>
			<string key="Sb" value="1-28"/>
			<string key="Abstract" value="Erhöhung der Zweitwohnungssteuer von fünf auf 15 Prozent der Jahresnettokaltmiete ab 01.01.2019. - Zweitwohnungssteuerpflicht ab Einzug in die Zweitwohnung (bislang erst ein Jahr nach dem Einzug). &lt;br /&gt;Weitergabe der von den Bezirksämtern beim Vollzug des Zweckentfremdungsverbots-Gesetzes erhobenen Daten an die Steuerverwaltung.&lt;br&gt;&lt;br /&gt;Artikelgesetz:&lt;br&gt; Artikel I: Änderung des Berliner Zweitwohnungsteuergesetzes&lt;br&gt; Artikel II: Änderung des Übernachtungsteuergesetzes&lt;br&gt;Zweitwohnungssteuergesetz:&lt;br&gt; Änderung § 7 Satz 2; § 8 Ab. 1, 2, 3 u. 4; § 9, § 10 § 11 u. § 12&lt;br&gt; Aufhebung § 13 u. 14&lt;br&gt; Übernachtungssteuergesetz:&lt;br&gt; Änderung Inhaltsübersicht&lt;br&gt; Einfügung § 13&lt;br&gt; der bisherige § 13 wird § 14"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
