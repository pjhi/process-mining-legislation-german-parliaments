		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1992-11-04T01:00:00.000+01:00"/>
			<string key="DBID" value="D-5138"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Umweltverträglichkeitsprüfung"/>
			<string key="Titel" value="Neufassung des Berliner Gesetzes über die Umweltverträglichkeitsprüfung (UVPG-Bln)"/>
			<string key="DokNr" value="12/2157"/>
			<string key="Urheber" value="Partei des Demokratischen Sozialismus (PDS)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-2157.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Dieser Gesetzentwurf verfolgt die Absicht, das Instrumentarium &quot;Umweltverträglichkeitsprüfung&quot; so auszugestalten, daß es seiner Intention präventiver Umweltschutzpolitik und der Situation eines städtischen Agglomerationsraumes mit 3,4 Millionen Einwohnern weitestgehend entspricht. Er versucht, die vorhandenen landesrechtlichen Spielräume im Interesse einer&lt;br /&gt;umweltverträglichen Stadtentwicklungspolitik auszuschöpfen. Insoweit lehnt er sich nur zum Teil an die Grundstruktur des geltenden Gesetzes an und ist in die Systematik dieses Gesetzes durch eine Novellierung einzelner Paragraphen bzw. Artikel des Gesetzes nicht sinnvoll integrierbar. Deshalb wird eine Neufassung vorgeschlagen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
