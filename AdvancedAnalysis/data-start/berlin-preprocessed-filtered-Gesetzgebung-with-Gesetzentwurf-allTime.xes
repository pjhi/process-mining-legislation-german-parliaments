			<date key="time:timestamp" value="2003-04-07T02:00:00.000+02:00"/>
			<string key="DBID" value="D-141545"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Feuerwehr"/>
			<string key="Titel" value="Gesetz über die Feuerwehren im Land Berlin &lt;br /&gt;(Feuerwehrgesetz - FwG)"/>
			<string key="DokNr" value="15/1558"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-1558.pdf"/>
			<string key="Sb" value="1-25"/>
			<string key="Abstract" value="Mit der Novellierung werden&lt;br&gt;&lt;br /&gt; - die rechtlichen Voraussetzungen geschaffen, unter denen die privaten Hilfsorganisationen und die Bundesanstalt   Technisches Hilfswerk in die allgemeine Gefahrenabwehr  einbezogen werden können (vgl. § 4),&lt;br&gt;&lt;br /&gt; - die Regelungen über die Rechtsstellung der Freiwilligen Feuerwehren geändert und erweitert (vgl. §§ 6 bis 10),&lt;br&gt;&lt;br /&gt; - die Jugendfeuerwehren als Jugendgruppen bei den Freiwilligen Feuerwehren erstmalig im Gesetz verankert&lt;br /&gt;   (vgl. § 2 Abs. 2),&lt;br&gt;&lt;br /&gt; - die Aufgaben der Werkfeuerwehren präzisiert (vgl. § 11  Abs. 1) und die Möglichkeit zu alternativen Organisationsformen ausnahmsweise eröffnet (vgl. § 11 Abs. 4) sowie&lt;br&gt;&lt;br /&gt; - die Kostenerstattung für die Inanspruchnahme von Leistungen der Berliner Feuerwehr bestimmt (vgl. § 17), die bisher gebührenfrei erbracht wurden&lt;br&gt;&lt;br /&gt; Mit geändert wurden:  Allgemeines Sicherheits- und Ordnungsgesetz (ASOG); Katastrophenschutzgesetz"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
