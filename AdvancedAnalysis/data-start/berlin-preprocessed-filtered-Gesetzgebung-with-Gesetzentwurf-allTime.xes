			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Lehrerbildung"/>
			<string key="Titel" value="Zehntes Gesetz zur Änderung des Lehrerbildungsgesetzes (10. LBiGÄndG)"/>
			<string key="DokNr" value="14/0706"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/14/DruckSachen/d140706.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der Bedarf für Berufsschullehrerinnen und -lehrer wird in den kommenden Jahren stetig steigen. Der Ausbau der berufsgegleitenden Maßnahmen im 11. Schuljahr, die Ausbildung in beruflichen Vollzeitlehrgängen verstärken den&lt;br /&gt;Lehrkräftebedarf. Prognosen zufolge existiert bis zum Schuljahr 2006/2007 ein Bedarf von ca. 1 100 Lehrerstellen. Diesem Bedarf steht lediglich ein Angebot aus dem Bereich der universitären Lehrerbildung in Berlin von ca. 480 entgegen. Die Bedarfssituation macht die Aufnahme von Fachkräften mit entsprechenden Diplomabschlüssen notwendig. Hierbei ist seitens des für Schulwesen zuständigen Mitglieds des Senats die Einstellung von Diplomabsolventen verschiedener Berufszweige zu ermöglichen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
