			<string key="Desk" value="Meldewesen"/>
			<string key="Titel" value="Gesetz zur Ausführung des Bundesmeldegesetzes und zur Änderung weiterer Vorschriften"/>
			<string key="DokNr" value="17/2895"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-2895.pdf"/>
			<string key="Sb" value="1-102"/>
			<string key="Abstract" value="Rechtseinheit im Meldewesen für eine effiziente Anwendung moderner Informations- und Kommunikationstechnologien um den Zugang von öffentlichen Stellen zu bestehenden Meldedatenbeständen zu verbessern für eine schnellere Erledigung öffentlicher Aufgaben.&lt;br&gt;Artikelgesetz: &lt;br&gt;Artikel I: Berliner Ausführungsgesetz zum Bundesmeldegesetz (BlnAGBMG)&lt;br&gt;Artikel II: Änderung des Allgemeinen Sicherheits- und Ordnungsgesetzes (ASOG)&lt;br&gt;Artikel III: Folgeänderungen: Landeswahlgesetz, Mammographie - Screening - Meldedatenverwendungsgesetz, Schulgesetz, Meldegesetz, Zweitwohnungssteuergesetz, Verordnung über die Übermittlung von Daten aus dem Verwaltungsvollzug an das Amt für Statistik Berlin-Brandenburg&lt;br&gt;Artikel IV: Änderung der Verwaltungsgebührenordnung&lt;br&gt;Artikel V: Aufhebung der Verordnung zur Durchführung des Meldegesetzes"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
