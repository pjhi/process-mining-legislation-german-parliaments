			<string key="Desk" value="Berliner Wasserbetriebe (ab 01.01.1994)"/>
			<string key="Titel" value="Gesetz zur Änderung des Berliner Betriebegesetzes, zur Teilprivatisierung der Berliner Wasserbetriebe und zur Änderung des Berliner Wassergesetzes"/>
			<string key="DokNr" value="13/3367"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3367.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der Senat hat in seiner Sitzung am 7. Juli 1998 beschlossen,&lt;br /&gt;die Berliner Wasserbetriebe - Anstalt des öffentlichen&lt;br /&gt;Rechts - (BWB) im Rahmen eines Holding-Modells in einen&lt;br /&gt;privatrechtlichen Konzern einzubinden.&lt;br /&gt; Für die Teilprivatisierung unter Wahrung der Rechtsform&lt;br /&gt; der Anstalt öffentlichen Rechts sind die erforderlichen&lt;br /&gt; rechtlichen Rahmenbedingungen zu schaffen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
