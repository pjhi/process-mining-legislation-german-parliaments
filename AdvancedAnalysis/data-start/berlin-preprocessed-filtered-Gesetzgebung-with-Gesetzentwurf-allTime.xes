			<string key="Desk" value="Hochschulgesetz"/>
			<string key="Titel" value="Achtes Gesetz zur Änderung des Berliner Hochschulgesetzes (8. BerlHGÄndG)  &lt;br /&gt;(Neuntes Gesetz zur Änderung des Berliner Hochschulgesetzes  (9. BerlHGÄG))"/>
			<string key="DokNr" value="15/0970"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Partei des Demokratischen Sozialismus (PDS)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-0970.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Berliner Hochschulgesetz soll der durch die Regelungen&lt;br /&gt;des Hochschulrahmengesetzes vorgegebenen neuen Rechtslage&lt;br /&gt;angepasst werden. Daher wird die Juniorprofessur im Berliner&lt;br /&gt;Hochschulgesetz verankert. Grund für ihre schnelle Einführung&lt;br /&gt;ist der Umstand, dass in den nächsten Jahren ein großer Teil&lt;br /&gt;der Professoren und Professorinnen der Berliner Hochschulen&lt;br /&gt;in den Ruhestand treten wird."/>
