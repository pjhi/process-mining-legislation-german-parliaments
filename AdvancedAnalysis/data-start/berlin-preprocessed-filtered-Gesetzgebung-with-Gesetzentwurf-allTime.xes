			<string key="Desk" value="Fehlbelegungsabgabe"/>
			<string key="Titel" value="Drittes Gesetz zur Änderung des Gesetzes über den Abbau der Fehlsubventionierung im Berliner Wohnungswesen  &lt;br /&gt;(AFWoG Bln)"/>
			<string key="DokNr" value="13/0231"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d0231.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="1994 sind Einkommensgrenzen für den sozialen  Wohnungsbau durch Bundesrecht verändert worden. Wird das Berliner Gesetz zu Fehlbelegung nicht geändert, würden die künftigen jährlichen Einnahmen stark  zurückgehen. Deshalb soll bei hohen Einkommensüberschreitungen nicht mehr der Mittelwert des Mietspiegels gelten, sondern ein Mittelwert plus &lt;br /&gt;15% die neue Höchstgrenze für die Miete plus Fehlbelegungsabgabe gelten.&lt;br&gt;&lt;br /&gt; Mit geändert wurde: Wohnungsbaugesetz"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
