			<string key="Desk" value="Rechtseinheit"/>
			<string key="Titel" value="Gesetz über den Geltungsbereich des Berliner Landesrechts &lt;br /&gt;(Gesetz über die Vereinheitlichung des Berliner Landesrechts)"/>
			<string key="DokNr" value="11/1128"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/11/DruckSachen/d11-1128.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Gesetz über die Vereinheitlichung des Berliner&lt;br /&gt;Landesrechts; Problem: im Zeitraum zwischen den 3.&lt;br /&gt;Oktober 1990 und&lt;br /&gt;der Konstituierung eines Gesamtberliner Abgeordnetenhauses&lt;br /&gt;gibt es unterschiedliches Landesrecht in beiden Teilen&lt;br /&gt;Berlins. Eine Vereinheitlichung des Landesrechts soll&lt;br /&gt;durch Ausdehnung des Geltungsbereichs des bisher in den&lt;br /&gt;West-Berliner Bezirken geltenden Rechts auf den anderen&lt;br /&gt;Teil Berlins erzielt werden. Das entsprechende Recht der&lt;br /&gt;DDR tritt mit gewissen Ausnahmen außer Kraft. \\nVorabüberweisung an ARecht (f), AEinheit u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1990"/>
			<string key="NrInTyp" value="11/0"/>
