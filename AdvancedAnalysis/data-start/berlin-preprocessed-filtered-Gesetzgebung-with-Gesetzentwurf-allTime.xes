			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Zuständigkeit (Verwaltung)"/>
			<string key="Titel" value="Gesetz zur Neuordnung von Zuständigkeiten im Geschäftsbereich der Senatsverwaltung für Inneres und im Verkehrsbereich &lt;br /&gt;(Zuständigkeitsneuordnungsgesetz - ZNOG)"/>
			<string key="DokNr" value="15/3244"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-3244.pdf"/>
			<string key="Sb" value="1-83"/>
			<string key="Abstract" value="Zur Umsetzung der beschlossenen Personaleinsparungen in Höhe von 20% bis zum Jahre 2006 erforderliche Reorganisationsmaßnahmen: &lt;br&gt;Bündelung gleichgelagerter Aufgaben durch Konzentration der verwaltungsexternen bzw. -internen Verwaltungsleistungen auf jeweils eine Behörde; Verlagerung einzelner verkehrsbezogener Aufgabenstellungen der Senatsverwaltung für Stadtentwicklung zum Landeseinwohneramt, Verlagerung der Entschädigungsbehörde vom Landesverwaltungsamt Berlin zum Landeseinwohneramt; Konzentration von Personalverwaltungsaufgaben bei dem Landesverwaltungsamt; Umbenennung des Landeseinwohneramtes in Landesamt für Bürger- und Ordnungsangelegenheiten (LABO).&lt;br&gt;  Geändert wurden:  Allgemeines Sicherheits- und Ordnungsgesetz (ASOG); Verordnung über sachliche Zuständigkeiten für die Verfolgung und Ahndung von  Ordnungswidrigkeiten; Gesetz über das Verfahren der Berliner Verwaltung; Gesetz zur Ausführung des Passgesetzes;  Landespersonalausweisgesetz; Meldegesetz; Zuständigkeits-  und Verfahrensordnu"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
