			<string key="Desk" value="Hochschulgesetz"/>
			<string key="Titel" value="Erprobungsregelungen verstetigen - Gesetz zur Änderung des Gesetzes über die Hochschulen im Land Berlin (BerlHG)"/>
			<string key="DokNr" value="15/4787"/>
			<string key="Urheber" value="Freie Demokratische Partei (FDP)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-4787.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Erprobungsklausel nach § 7a BerlHG ermöglicht es den Hochschulen nach Genehmigung durch die Senatsverwaltung, neue Modelle der Leitung, Organisation und Finanzierung zu erproben, um damit eine Vereinfachung der Entscheidungsprozesse zu erzielen. Die gemäß §7a Satz 1 zugelassenen Abweichungen von Vorschriften des Berliner Hochschulgesetzes sowie die darauf beruhenden Satzungen der Hochschulen sind in ihrer Geltungsdauer jedoch eingeschränkt. - Änderung § 137a.&lt;br /&gt;"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
