			<string key="Desk" value="Ausländerbehörde"/>
			<string key="Titel" value="Gesetz zur Errichtung eines Landesamtes für Einwanderung und zur Anpassung betroffener Gesetze"/>
			<string key="DokNr" value="18/1945"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-1945.pdf"/>
			<string key="Sb" value="1-19"/>
			<string key="Abstract" value="Errichtung einer eigenständigen Einwanderungsbehörde zum 1. Januar 2020 zur Umsetzung des auf Bundesebene geplanten Fachkräfteeinwanderungsgesetzes. Übernahme der Aufgaben der bisher beim Landesamt für Bürger- und Ordnungsangelegenheiten angesiedelten Ausländerbehörde. Fortentwicklung zu einer Willkommensbehörde. Förderung der Zuwanderung von Fachkräften. Verbesserung der Integration von Geflüchteten in den Arbeitsmarkt und die Gesellschaft.&lt;br /&gt;&lt;br&gt;Artikelgesetz:&lt;br&gt;Artikel 1: Gesetz zur Errichtung eines Landesamtes für Einwanderung&lt;br&gt;Artikel 2: Änderung des Landesbesoldungsgesetzes&lt;br&gt;Artikel 3: Änderung des Allgemeinen Sicherheits- und Ordnungsgesetzes (ASOG)&lt;br&gt;Artikel 4: Änderung des Personalvertretungsgesetzes&lt;br&gt;Artikel 5: Änderung der Verordnung über sachliche Zuständigkeiten für die Verfolgung und Ahndung von Ordnungswidrigkeiten"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
