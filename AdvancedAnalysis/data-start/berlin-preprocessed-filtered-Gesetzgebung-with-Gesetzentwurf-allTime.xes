		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1995-08-23T02:00:00.000+02:00"/>
			<string key="DBID" value="D-7386"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Anstalt des öffentlichen Rechts"/>
			<string key="Titel" value="Gesetz über die Errichtung der Anstalt öffentlichen Rechts Berliner Bäder-Betriebe &lt;br /&gt; (Bäder-Anstaltsgesetz - BBBG)"/>
			<string key="DokNr" value="12/5875"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-5875.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Betriebsführung der Schwimmbäder ist unwirtschaftlich und bedarf erheblicher staatlicher Subventionen. Die&lt;br /&gt;derzeitige Situation ist durch 24 eigenverantwortlich agierende Verwaltungseinheiten gekennzeichnet, die sich nur&lt;br /&gt;punktuell miteinander abstimmen. Es fehlt das koordinierende, steuernde Element, das insbesondere die inhohem Maße&lt;br /&gt;vorhandenen Synergieeffekte zur Geltung bringt. Der steigende Zuschußbedarf würde in absehbarer Zeit zu Bäderschließungen &lt;br /&gt;führen. Es sind somit Lösungen erforderlich, die den Betrieb&lt;br /&gt;der Schwimmbäder wirtschaftlicher gestalten. \\nVorabüberweisung an AHaupt u. ASport"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1995"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="46502"/>
			<date key="DokDat" value="1995-08-23T00:00:00+00:00"/>
			<date key="DokDat_original" value="1995-08-23T00:00:00+00:00"/>
		</event>
