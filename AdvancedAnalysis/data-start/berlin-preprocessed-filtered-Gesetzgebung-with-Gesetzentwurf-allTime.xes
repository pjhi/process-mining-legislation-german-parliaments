			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Naturschutz"/>
			<string key="Titel" value="Achtes Gesetz zur Änderung des Berliner Naturschutzgesetzes"/>
			<string key="DokNr" value="13/2503"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d2503.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Geänderte Vorschriften des Bundesnaturschutzgesetzes sowie das Baugesetzbuch führen zu Anpassungsbedarf &lt;br /&gt;auch beim Berliner Naturschutzgesetz. Darüber hinaus haben sich aus der Praxis heraus einige Änderungen &lt;br /&gt;und Präzisierungen als erforderlich erwiesen, um beispielsweise dem verbindlichen Charakter der Landschaftspläne gerecht zu werden und ihr Verhältnis zu den Schutzverordnungen zu klären. Außerdem wird &lt;br /&gt;die sogenannte Halterhaftung eingeführt und eine präzisere Regelung über die Durchführung und Kostentragung bei Maßnahmen des Naturschutzes getroffen.&lt;br /&gt; &lt;br&gt;Mit geändert wurden: Bodenversiegelungsausgleichsverordnung; Änderung des § 4&lt;br /&gt; des Gesetzes zur Ausführung des Bundesbaugesetzes; Änderung § 25 des Berliner Wassergesetzes"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="30924"/>
