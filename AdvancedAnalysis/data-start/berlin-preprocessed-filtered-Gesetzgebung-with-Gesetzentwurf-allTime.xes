			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Abgeordnetengesetz"/>
			<string key="Titel" value="Zweites Gesetzes zur Änderung des Gesetzes über die Rechtsverhältnisse der Mitglieder des Abgeordnetenhauses von Berlin&lt;br /&gt;(Zweites Gesetz zur Änderung des Landesabgeordnetengesetzes)"/>
			<string key="DokNr" value="18/3284"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Die Linke Fraktion Berlin (Die Linke)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-3284.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Einfügung einer zusätzlichen Stufe 0  bei der Veröffentlichung von Nebeneinkünften zur Präzisierung der Anzeige- und Veröffentlichungspflichten der Mitglieder des Abgeordnetenhauses. Finanzierung aus dem Haushalt des Abgeordnetenhauses für bauliche und technische Sicherheitsmaßnahmen an Wohnungen und Wahlkreisbüros von besonders gefährdeten Mitgliedern des Abgeordnetenhauses sowie Kosten für die Beseitigung von Vandalismusschäden an Wahlkreisbüros.&lt;br&gt;Änderung § 5a Abs. 3 Satz 4, § 7 Abs. 1 u. Abs. 2 Satz 1 (die bisherigen Abs. 4-6 werden die Abs. 5-7)&lt;br&gt;Einfügung § 7 Abs. 4"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
