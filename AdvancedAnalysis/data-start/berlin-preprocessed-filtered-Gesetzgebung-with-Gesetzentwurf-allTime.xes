		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1999-08-31T02:00:00.000+02:00"/>
			<string key="DBID" value="D-21901"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Baugesetzbuch"/>
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes zur Ausführung des Baugesetzbuchs &lt;br /&gt;(Zweites Gesetz zur Änderung des Gesetzes zur Ausführung des Baugesetzbuchs)"/>
			<string key="DokNr" value="13/4035"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d4035.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Baugesetzbuch sieht für die städtebaulichen Festlegungen&lt;br /&gt;die Rechtsform einer gemeindlichen Satzung vor. Es enthält&lt;br /&gt;außerdem Bestimmungen über die Zuständigkeit von Behörden und&lt;br /&gt;das Verhältnis von Gemeinde zu Landesbehörde.&lt;br /&gt; Diese Regelungen sind auf die Flächenländer zugeschnitten,&lt;br /&gt; nicht auf Stadtstaaten, wie Berlin und Hamburg. Diese&lt;br /&gt; Stadtstaaten kennen keine Satzungen, bei ihnen fallen auch&lt;br /&gt; staatliche und gemeindliche Tätigkeiten zusammen. Das&lt;br /&gt; Baugesetzbuch verpflichtet sie deshalb in § 246 Abs. 2 zu&lt;br /&gt; bestimmen, welche Form der Rechtsetzung an die Stelle der &lt;br /&gt; Satzung tritt. Außerdem werden durch § 246 Abs. 4 die&lt;br /&gt; Senate ermächtigt, die Vorschriften über die Zuständigkeit&lt;br /&gt; von Behörden dem besonderen Verwaltungsaufbau ihrer Länder&lt;br /&gt; anzupassen. Berlin hat die erforderlichen Bestimmungen im&lt;br /&gt; Gesetz zur Ausführung des Baugesetzbuchs (AGBauGB) &lt;br /&gt; getroffen.&lt;br /&gt; § 76 Abs. 6 der Bauordnung wird aufgehoben;&lt;br /&gt; § 21 a des Baugesetzbuchs tritt mit Ablauf des 31.12.2004&lt;br /&gt; ausser Kraft. \Vorabüberweisung an ABauWohnV"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="53627"/>
