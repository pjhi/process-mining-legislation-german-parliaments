			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Staatsvertrag"/>
			<string key="Titel" value="Gesetz zum Dritten Staatsvertrag zur Änderung rundfunkrechtlicher Staatsverträge &lt;br /&gt;(Dritter Rundfunkänderungsstaatsvertrag)"/>
			<string key="DokNr" value="13/0739"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d0739.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das bisherige Verfahren zur Festsetzung der Rundfunkgebühr ist nach dem Urteil des BVG nicht mit &lt;br /&gt;dem Grundgesetz vereinbar. Die Kommission zur Ermittlung des Finanzbedarfs der Rundfunkanstalten &lt;br /&gt;(KEF) hat eine zusätzlichen Finanzbedarf der Landesrundfunkanstalten festgestellt. Danach sollen die &lt;br /&gt;in der ARD zusammengeschlossenen Landesrundfunkanstalten und das ZDF zwei zusätzliche Spartenprogramme &lt;br /&gt;veranstalten dürfen.&lt;br /&gt;&lt;br&gt;Mit geändert wurde: Rundfunkgebührenstaatsvertrag \\nVorabüberweisung an AMedien"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
