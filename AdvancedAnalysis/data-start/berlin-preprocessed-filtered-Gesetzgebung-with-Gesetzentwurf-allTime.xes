			<string key="Titel" value="Gesetzentwurf zur Änderung des Berliner Mobilitätsgesetzes und des Berliner Straßengesetzes"/>
			<string key="DokNr" value="19/0983"/>
			<string key="Urheber" value="[&apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Die Linke Fraktion Berlin (Die Linke)&apos;]"/>
