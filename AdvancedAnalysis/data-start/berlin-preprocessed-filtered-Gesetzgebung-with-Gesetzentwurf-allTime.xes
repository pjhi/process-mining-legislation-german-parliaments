		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1991-09-24T02:00:00.000+02:00"/>
			<string key="DBID" value="D-7521"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Lehrerbildung"/>
			<string key="Titel" value="Gesetz zur Umsetzung der Richtlinie 89/48/EWG des Rates der Europäischen Gemeinschaften vom 21. Dezember 1988 über eine allgemeine Regelung zur Anerkennung der Hochschuldiplome, die eine mindestens dreijährige Berufsausbildung abschließen, für Lehrerberufe &lt;br /&gt;(EG-RL-LehrG)"/>
			<string key="DokNr" value="12/0687"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0687.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die zentrale Vorschrift des Artikels 3 dieser Richtlinie&lt;br /&gt;geht grundsätzlich von der Gleichstellung dieser Diplome&lt;br /&gt;aus. Nach Artikel 4 der Richtlinie ist jedoch vorgesehen,&lt;br /&gt;Maßnahmen für den Fall zu ergreifen, daß die Ausbildung im&lt;br /&gt;Herkunftsstaat des Bewerbers gegenüber der im&lt;br /&gt;Aufnahmestaat vorgeschriebenen Ausbildung wesentliche&lt;br /&gt;Defizite aufweist. Dazu bedarf es aber einer&lt;br /&gt;entsprechenden Umsetzung der Richtlinie in&lt;br /&gt;innerstaatliches Recht. Um eine Bindungswirkung nach außen&lt;br /&gt;zu erzielen, muß diese Umsetzung durch ein förmliches&lt;br /&gt;Gesetz geschehen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
