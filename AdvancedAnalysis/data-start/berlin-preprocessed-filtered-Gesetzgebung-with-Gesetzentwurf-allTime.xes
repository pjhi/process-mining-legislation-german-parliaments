			<date key="time:timestamp" value="1998-03-16T01:00:00.000+01:00"/>
			<string key="DBID" value="D-21163"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Katastrophenschutz"/>
			<string key="Titel" value="Gesetz über die Gefahrenabwehr bei Katastrophen &lt;br /&gt;(Katastrophenschutzgesetz - KatSG)"/>
			<string key="DokNr" value="13/2586"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d2586.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die bestehenden Rechtsvorschriften, wie das ASOG, das  Feuerwehrgesetz und das Rettungsdienstgesetz, bieten &lt;br /&gt;eine ausreichende rechtliche Grundlage, um die  Alltagsgefahren wirksam zu bekämpfen. Es besteht  jedoch ein Regelungsbedarf für Katastrophen. Diese  unterscheiden sich von den Alltagsgefahren dadurch,  daß sie das Leben und die Gesundheit einer Vielzahl  von Menschen, die Umwelt oder sonstige bedeutsame Rechtsgüter gefährden und von den Ordnungsbehörden mit eigenen Mitteln und Kräften nicht angemessen beseitigt  werden können.&lt;br /&gt; &lt;br&gt;Mit geändert wurden: Gesetz über die Zuständigkeit der Ordnungsbehörden; 2. Verwaltungsreformgesetz; Feuerwehrgesetz;"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="31986"/>
			<date key="DokDat" value="1998-03-16T00:00:00+00:00"/>
			<date key="DokDat_original" value="1998-03-16T00:00:00+00:00"/>
		</event>
