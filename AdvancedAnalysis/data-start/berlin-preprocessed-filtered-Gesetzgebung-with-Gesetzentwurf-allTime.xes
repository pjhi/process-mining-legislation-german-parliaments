			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Nachtragshaushaltsgesetz 1996"/>
			<string key="Titel" value="Gesetz über die Feststellung eines Nachtrags zum Haushaltsplan von Berlin für die Haushaltsjahre 1995/1996 (Nachtragshaushaltsgesetz 1995/1996 - NHG 95/96)"/>
			<string key="DokNr" value="13/0200"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d0200.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Ansätze für 1996 im Doppelhaushalt 1995/1996 sind &lt;br /&gt;aufgrund der Einnahmeentwicklung überholt. Die den &lt;br /&gt;Haushaltsansätzen zugrunde liegenden Steuerschätzungen &lt;br /&gt;und Einnahmeerwartungen aus dem Jahre 1994 mußten &lt;br /&gt;korrigiert werden. Die Haushaltslage hat sich &lt;br /&gt;erheblich verschlechtert. Mit dem aktuellen &lt;br /&gt;Finanzstatus für die Jahre 1996 bis 1999 ist für &lt;br /&gt;das Jahr 1996 eine Deckungslücke von 5,3 Mrd. DM &lt;br /&gt;festgestellt worden. Damit ergibt sich im Vergleich &lt;br /&gt;zu früheren Nachtragshaushaltsplänen in diesem Jahr &lt;br /&gt;ein deutlich erhöhter Änderungsbedarf. \\nVorabüberweisung an AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="46692"/>
