			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die verfassungsrechtliche Überprüfbarkeit von Entscheidungen&lt;br /&gt;des Abgeordnetenhauses muß auch bei politischen&lt;br /&gt;Kräfteverhältnissen möglich sein, wie sie jetzt im&lt;br /&gt;Berliner Parlament existieren. Da die Rechte der&lt;br /&gt;Opposition insgesamt gestärkt werden sollen, ist eine&lt;br /&gt;entsprechende Verfassungsänderung unumgänglich.&lt;br /&gt; Änderung des Art. 72 Abs. 2 Nr. 2"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
