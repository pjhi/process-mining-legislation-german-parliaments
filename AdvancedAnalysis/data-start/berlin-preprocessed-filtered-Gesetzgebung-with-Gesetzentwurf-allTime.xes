			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Wasserrecht"/>
			<string key="Titel" value="Neuntes Gesetz zur Änderung des Berliner Wassergesetzes"/>
			<string key="DokNr" value="15/1653"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-1653.pdf"/>
			<string key="Sb" value="1-152"/>
			<string key="Abstract" value="Der Entwurf sieht eine Reihe von Änderungen des Berliner Wassergesetzes vor, deren Notwendigkeit sich aus der&lt;br /&gt;Anpassung an das Bundesrecht und aus dem praktischen Vollzug sowie aus der Umsetzung der IVU-Richtlinie (Integrierte&lt;br /&gt;Vermeidung und Verminderung der Umweltverschmutzung) und der UVP-Änderungsrichtlinie (Umweltverträglichkeitsprüfung) in&lt;br /&gt;das deutsche Recht ergeben hat. Zu nennen sich vor allem die  Verlagerung einiger wasserrechtlicher Vollzugsaufgaben in die&lt;br /&gt;Bezirke, die Vereinfachung und integrierte Koordinierung von (wasser-)rechtlichen Zulassungsverfahren sowie die Bestimmung&lt;br /&gt;der UVP-Pflicht bei bestimmten Vorhaben mittels Größen- oder Leistungswerten anhand einer anlagen- oder standortbezogenen&lt;br /&gt;Vorprüfung."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
