			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Staatsvertrag"/>
			<string key="Titel" value="Gesetz zum Achten Rundfunkänderungsstaatsvertrag"/>
			<string key="DokNr" value="15/3369"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-3369.pdf"/>
			<string key="Sb" value="1-44"/>
			<string key="Abstract" value="Neben der Gebührenerhöhung enthält der Staatsvertrag im&lt;br /&gt;Wesentlichen folgende Regelungen:&lt;br /&gt;a) Internetfähige PCs oder Handys werden nunmehr im&lt;br /&gt;    Grundsatz gebührenpflichtig, wenn der Rundfunkteilnehmer&lt;br /&gt;    daneben keine herkömmlichen Rundfunkgeräte bereithält.&lt;br /&gt;b) Im Rahmen der einkommensabhängigen Befreiungen entfällt&lt;br /&gt;    die Grenze des Sozialhilferegelsatzes. Berechtigt sind&lt;br /&gt;    nunmehr die Empfänger von Sozialgeld und Arbeitslosengeld&lt;br /&gt;    II.&lt;br /&gt;c) Anträge auf Befreiung von der Rundfunkgebührenpflicht&lt;br /&gt;    sind nicht mehr an die Bezirksämter zu richten, sondern&lt;br /&gt;    an die Landesrundfunkanstalt selbst.&lt;br /&gt; Mit geändert wurde:&lt;br /&gt; Allgemeines Zuständigkeitsgesetz"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
