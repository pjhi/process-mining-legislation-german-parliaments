			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Beamtenversorgung"/>
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes über die Versorgung der Beamtinnen und Beamten sowie der Richterinnen und Richter des Landes Berlin &lt;br /&gt;(Landesbeamtenversorgungsgesetz - LBeamtVG)"/>
			<string key="DokNr" value="17/2624"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-2624.pdf"/>
			<string key="Sb" value="1-17"/>
			<string key="Abstract" value="Verbesserung  der Hinzuverdienstmöglichkeiten von Versorgungsberechtigten  die beabsichtigen, eine Beschäftigung aufnehmen, die zur Deckung des Personalbedarfs infolge des gestiegenen Zugangs von Flüchtlingen und Asylbegehrenden notwendig ist. Mit der Änderung des Landesbeamtenversorgungsgesetzes wird die Berücksichtigung von Verwendungseinkommen neu geregelt. Befristet bis zum 31. Dezember 2018 soll § 53 LBeamtVG bei Bezug von Verwendungseinkommen, das aus einer solchen Tätigkeit bezogen wird, nicht angewandt werden.&lt;br&gt;Aufhebung § 53 Abs. 3&lt;br&gt;Anfügung § 53 Abs. 8 Satz 5&lt;br&gt;Einfügung § 108b&lt;br /&gt;"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="182166"/>
