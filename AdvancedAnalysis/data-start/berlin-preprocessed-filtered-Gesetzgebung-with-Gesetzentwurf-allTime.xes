			<string key="Desk" value="Bezirksverordnetenversammlung"/>
			<string key="Titel" value="Änderung des Gesetzes über die Entschädigung der Mitglieder der Bezirksverordnetenversammlungen, der Bürgerdeputierten und sonstiger ehrenamtlich tätiger Personen   &lt;br /&gt;(Viertes Gesetz zur Änderung des Gesetzes über die Entschädigung der Mitglieder der Bezirksverordnetenversammlung, der Bürgerdeputierten und sonstiger ehrenamtlich tätiger Personen)"/>
			<string key="DokNr" value="13/3570"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Partei des Demokratischen Sozialismus (PDS)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3570.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Durch die vom Abgeordnetenhaus beschlossene&lt;br /&gt;Bezirksgebietsreform und der damit verbundenen Reduzierung&lt;br /&gt;der Mitgliederzahl der Bezirksverordnetenversammlungen erhöht&lt;br /&gt;sich der Arbeitsaufwand für die Bezirksverordneten&lt;br /&gt;beträchtlich. Eine Anpassung der seit dem 1. Januar 1989&lt;br /&gt;unveränderten Entschädigung ist daher geboten"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
