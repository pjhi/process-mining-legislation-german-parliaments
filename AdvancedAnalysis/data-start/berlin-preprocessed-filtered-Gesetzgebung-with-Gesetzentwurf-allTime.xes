			<string key="Titel" value="Zweites Gesetz zur Änderung des Berliner Ladenöffnungsgesetzes"/>
			<string key="DokNr" value="16/3383"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-3383.pdf"/>
			<string key="Sb" value="1-28"/>
			<string key="Abstract" value="Nachdem das Bundesverfassungsgericht am 01.12.2009 die bisher in Berlin erlaubte  Ladenöffnung an allen vier Adventssonntagen für verfassungswidrig erklärt hat, wird dem Einzelhandel mit dieser Novellierung die Möglichkeit zur Ladenöffnung an insgesamt zehn Sonn- oder Feiertagen pro Jahr eingeräumt. \\nVorabüberweisung an AWiTechFrau"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
