			<string key="Titel" value="Das Berliner Landesfischereigesetz (LFischG)"/>
			<string key="DokNr" value="12/5249"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-5249.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das im Westteil der Stadt geltende Fischereigesetz stammt&lt;br /&gt;aus dem Jahre 1916, das im Ostteil der Stadt geltende aus dem&lt;br /&gt;Jahre 1959. Beide Gesetze sind an die allgemeine&lt;br /&gt;Rechtsentwicklung anzupassen;&lt;br /&gt; Dazu gehören:&lt;br /&gt; Sicherung der beruflichen Fischerei;&lt;br /&gt; Berücksichtigung der Angelfischerei als Freizeitbeschäfti-&lt;br /&gt; gung;&lt;br /&gt; Verpflichtung der Fischereiberechtigten zur Wahrnehmung von&lt;br /&gt; Hegemaßnahmen&lt;br /&gt; und&lt;br /&gt; Definition der Aufgabenstellung der Fischereiverwaltung"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1995"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
