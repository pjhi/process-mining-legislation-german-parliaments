			<string key="Titel" value="Zehntes Gesetz zur Änderung des Landeswahlgesetzes"/>
			<string key="DokNr" value="15/5200"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Partei des Demokratischen Sozialismus (Die Linkspartei.PDS)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-5200.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die bisherigen Formulierungen die u. a. die Unvereinbarkeit einer Mitgliedschaft in der BVV mit der Tätigkeit als Beamter mit Dienstbezügen oder als Angestellter der Verwaltung desselben  Bezirks regeln, können zu einer Ungleichbehandlung von Beamten einerseits und Angestellten andererseits führen. Ein nachvollziehbarer Grund für diese Ungleichbehandlung ist nicht ersichtlich, da die Statusunterschiede zwischen Beamten und Angestellten es nicht rechtfertigen, die Inkompatibilitätsregelungen für Angestellte weiter zu fassen als für Beamte."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
