		<string key="VorgangsDeskriptoren" value="[&apos;Behinderter Schüler&apos;, &apos;Gebühr&apos;, &apos;Grundschule&apos;, &apos;Schulgesetz&apos;, &apos;Sonderpädagogik&apos;]"/>
