			<string key="Desk" value="Privatschule"/>
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes über die Privatschulen und den Privatunterricht (Privatschulgesetz)  &lt;br /&gt; (Siebentes Gesetz zur Änderung des Gesetzes über die Privatschulen und den Privatunterricht (Privatschulgesetz))"/>
			<string key="DokNr" value="12/4774"/>
			<string key="Urheber" value="Freie Demokratische Partei (FDP)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-4774.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Auf Grund der geänderten Ausführungsvorschriften zur Eingliederungshilfe für Behinderte nach dem Bundessozialhilfegesetz sind die Berliner Behindertenschulen in freier Trägerschaft akut gefährdet, weil die Zuschüsse für die Schulgeldkosten nunmehr bei diesen Schulen wegfallen. Im Berliner Haushalt müssen für eine solche Gesetzesänderung ca. 900 000 DM eingestellt werden. Im Land Brandenburg wird z.B. den &quot;Förderschulen für Geistigbehinderte&quot; ein 25prozentiger Sachkostenanteil erstattet."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1994"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
