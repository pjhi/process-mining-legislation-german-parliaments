			<string key="Desk" value="Spielbank"/>
			<string key="Titel" value="Änderung des Gesetzes über die Zulassung öffentlicher Spielbanken in Berlin &lt;br /&gt;(Spielbankengesetz - SpBG) &lt;br /&gt; (Gesetz zur Änderung des Spielbankengesetzes)"/>
			<string key="DokNr" value="13/3862"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3862.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Mit § 4 Abs. 1 des Spielbankengesetzes wird die Entrichtung&lt;br /&gt;einer Zusatzabgabe in Höhe von 11 v.H. des&lt;br /&gt;Bruttospielertrages festgelegt. Ein Teil in Höhe von 7% des&lt;br /&gt;Bruttospielertrages wird als allgemeines Deckungsmittel dem&lt;br /&gt;Landeshaushalt zugeführt, der andere Teil in Höhe von 4% des&lt;br /&gt;Bruttospielertrages wird gemäß § 4 Abs. 3 des&lt;br /&gt;Spielbankengesetzes der Stiftung Deutsche Klassenlotterie&lt;br /&gt;Berlin zur zweckgebundenen Vergabe zur Verfügung gestellt - &lt;br /&gt;die Stiftung hat damit kulturelle, sportliche und&lt;br /&gt;gemeinnützige Zwecke zu fördern."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
