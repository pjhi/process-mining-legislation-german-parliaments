		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="2004-10-05T02:00:00.000+02:00"/>
			<string key="DBID" value="D-142564"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Verfassung"/>
			<string key="Titel" value="Gesetz zur Schaffung eines Gesetzes zu Artikel 29 Verfassung von Berlin und zur Änderung des Kindertagesbetreuungsgesetzes"/>
			<string key="DokNr" value="15/3249"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-3249.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Aufgrund des Urteils des Bundesverfassungsgerichts vom 24.09.2003 (sog. Kopftuch-Urteil) erforderliche Regelung:&lt;br&gt;Beamte, Angestellte und Auszubildende in Schulen, Polizei, Gerichten, Rechtspflege, Justizvollzug dürfen innerhalb des Dienstes keine sichtbaren religiösen oder weltanschaulichen Symbole und keine auffallenden religiös oder weltanschaulich geprägten Kleidungsstücke tragen. Sie sind verpflichtet, sich in ihrem weltanschaulichen oder religiösen Bekenntnis zurückzuhalten.&lt;br&gt;Das Personal in Kindertagesstätten in öffentlicher Trägerschaft soll auf weltanschaulich-religiöse Neutralität achten. Wenn die Erziehungsberechtigten eines Kindes ihre negative Glaubensfreiheit beeinträchtigt sehen, sollen Vermittlungsgespräche stattfinden und ggf. organisatorische Veränderungen erfolgen.&lt;br&gt;(Neutralitätsgesetz/Kopftuchgesetz/Weltanschauungssymbolegesetz/WASymbG)"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="88540"/>
			<date key="DokDat" value="2004-10-05T00:00:00+00:00"/>
			<date key="DokDat_original" value="2004-05-10T00:00:00+00:00"/>
		</event>
