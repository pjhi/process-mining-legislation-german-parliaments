			<string key="Desk" value="Hochschulzulassung"/>
			<string key="Titel" value="Gesetz zur Umsetzung des Staatsvertrages über die Hochschulzulassung"/>
			<string key="DokNr" value="18/2070"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-2070.pdf"/>
			<string key="Sb" value="1-173"/>
			<string key="Abstract" value="Nach einer Entscheidung des Bundesverfassungsgerichts vom 19. Dezember 2017 (1 BvL 3/14) erforderlich gewordene Neuregelung der Vergabe von Studienplätzen in Studiengängen mit bundesweitem NC / Aufhebung des Staatsvertrages über die Errichtung einer gemeinsamen Einrichtung für Hochschulzulassung vom 5. Juni 2008 &lt;br&gt;Medizin, Zahnmedizin, Tiermedizin, Pharmazie: Vorrangig eignungsorientierte Studienplatzvergabe: Abschaffung der Auswahl nach Wartezeit; Festlegung einer Übergangsquote für Altwartende; Erhöhung der Abiturbestenquote von 20 auf 30 Prozent; Einführung der &quot;zusätzlichen Eignungsquote&quot; im Umfang von 10 Prozent&lt;br&gt;&lt;br /&gt;Nicht-medizinische Studiengänge: Stärkung der Gewichtung von außerschulischen Kompetenzen im örtlichen Auswahlverfahren. Begrenzung des Wartezeitkriteriums auf sieben Semester."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
