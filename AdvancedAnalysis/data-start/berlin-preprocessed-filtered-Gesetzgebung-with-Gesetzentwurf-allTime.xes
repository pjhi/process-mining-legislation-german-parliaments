			<string key="DBID" value="D-21453"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Privatschule"/>
			<string key="Titel" value="Gesetz zur Änderung des &quot;Gesetzes über die Privatschulen und den Privatunterricht&quot; (Privatschulgesetz) &lt;br /&gt;(Achtes Gesetz zur Änderung des Privatschulgesetzes)"/>
			<string key="DokNr" value="13/0314"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d0314.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Bezeichnung &quot;Privatschulen&quot; entspricht nicht mehr &lt;br /&gt;der Funktion dieser Schulen innerhalb des öffentlichen &lt;br /&gt;Schulwesens und soll - wie in fast allen &lt;br /&gt;Landesgesetzen der Bundesrepublik - durch &quot;Schulen in &lt;br /&gt;freier Trägerschaft&quot; ersetzt werden. Um den Spielraum &lt;br /&gt;in der Verwendung der Mittel und für eigene &lt;br /&gt;Einnahmen zu vergrößern, werden die Zuschüsse nicht &lt;br /&gt;an den tatsächlichen sondern an den vergleichbaren &lt;br /&gt;Personalkosten bemessen; die Einnahmen können nunmehr &lt;br /&gt;135% betragen, der die vorläufige Genehmigung regelnde &lt;br /&gt;§ 4 Abs. 5 entfällt."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="68406"/>
			<date key="DokDat" value="1996-04-16T00:00:00+00:00"/>
			<date key="DokDat_original" value="1996-04-16T00:00:00+00:00"/>
		</event>
