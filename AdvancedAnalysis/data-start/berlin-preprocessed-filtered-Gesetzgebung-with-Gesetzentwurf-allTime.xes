			<string key="Desk" value="Umweltverträglichkeitsprüfung"/>
			<string key="Titel" value="Berliner Gesetz über die Umweltverträglichkeitsprüfung &lt;br /&gt;(UVPG-Bln)"/>
			<string key="DokNr" value="12/0568"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-0568.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Aufgrund der Richtlinie des Rates der Europäischen Gemeinschaften vom 27. Juni 1985 über die Umweltverträglichkeitsprüfung (UVP) bei bestimmten öffentlichen und privaten Projekten besteht im Land Berlin&lt;br /&gt;ein Regelungsbedarf über das entsprechende Bundesgesetz zur Umsetzung der EG-Richtlinie vom 12. Februar 1990 hinaus.&lt;br&gt;Die Regelungen beziehen sich auf folgende Bereiche:&lt;br&gt; a) Zuständigkeit und Verfahren: Anwendungsbereich,&lt;br /&gt;federführende Behörde und deren Aufgaben, Beteiligung von Sachverständigen, Verwaltungsvorschriften; &lt;br&gt;b) Änderung von Landesrecht: Änderung des Berliner Wassergesetzes, Genehmigung von Rohrleitungsanlagen, Änderung des Berliner&lt;br /&gt;Naturschutzgesetzes, Änderung des Landeswahlgesetzes, Änderung des Gesetzes über Kleinbahnen und Privatanschlußbahnen; &lt;br&gt;c) Übergangs- und Schlußvorschriften."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
