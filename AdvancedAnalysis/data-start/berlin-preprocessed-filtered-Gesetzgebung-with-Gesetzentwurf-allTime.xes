			<string key="DokNr" value="12/4265"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-4265.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Ausgangspunkt ist, daß das in den westlichen Bezirken&lt;br /&gt;erreichte Niveau in der medizinischen Versorgung Maßstab&lt;br /&gt;für ganz Berlin ist. Notwendig ist danach eine&lt;br /&gt;Gesundheitsplanung unter Einbeziehung aller an der&lt;br /&gt;Gesundheitsversorgung beteiligten stationären,&lt;br /&gt;teilstationären und ambulanten Einrichtungen."/>
