			<string key="Titel" value="Zweites Gesetz zur Änderung des Gesetzes über die Anwendung unmittelbaren Zwanges bei der Ausübung öffentlicher Gewalt  &lt;br /&gt;durch Vollzugsbeamte des Landes Berlin"/>
			<string key="DokNr" value="11/1138"/>
