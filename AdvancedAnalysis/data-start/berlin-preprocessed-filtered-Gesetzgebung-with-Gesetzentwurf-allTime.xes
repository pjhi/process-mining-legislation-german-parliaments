			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Museum"/>
			<string key="Titel" value="Gesetz über Museumsstiftungen des Landes Berlin &lt;br /&gt;(Museums-Stiftungs-Gesetz - MusStG)"/>
			<string key="DokNr" value="12/4681"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-4681.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Überleitung der Berlinischen&lt;br /&gt;Galerie und des Bröhan-Museums in jeweils eine rechtsfähige&lt;br /&gt;Stiftung des öffentlichen Rechts. Die beiden bisher privat&lt;br /&gt;getragenen Museen erfüllen im öffentlichen Interesse&lt;br /&gt;liegende Aufgaben. Aufgrund ihrer Größe und Bedeutung ist&lt;br /&gt;die jetzige private Trägerschaft nicht mehr angemessen.&lt;br /&gt; Der 1975 gegründete Verein Berlinische Galerie hat für das&lt;br /&gt; von ihm getragene Museum dem Land Berlin das Gründungs-&lt;br /&gt; und Aufbaurisiko abnehmen wollen. Eine Übernahme durch das&lt;br /&gt; Land Berlin war von Anfang - auch laut Vereinssatzung -&lt;br /&gt; angestrebt. Die Kunstwerke und Dokumente der Galerie sind&lt;br /&gt; Eigentum des Landes Berlin.&lt;br /&gt; Kernbestand des von der Stiftung Bröhan (Stiftung privaten&lt;br /&gt; Rechts) getragenen Bröhan-Museums ist die von Prof. Bröhan&lt;br /&gt; dem Land Berlin 1982 geschenkte Sammlung von Art Deco und&lt;br /&gt; Jugendstil. Prof. Bröhan hat dem Land Berlin auch die seit&lt;br /&gt; jener Schenkung von ihm aus privaten Mitteln erworbenen&lt;br /&gt; umfänglichen und qualitätvollen Bestä \\nVorabüberweisung an AKult f, ARecht&lt;br /&gt;u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1994"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
