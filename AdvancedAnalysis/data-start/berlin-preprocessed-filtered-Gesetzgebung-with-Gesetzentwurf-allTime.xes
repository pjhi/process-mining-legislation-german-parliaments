			<string key="DokNr" value="11/1033"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Bündnis 90/Die GRÜNEN (GRÜNE/AL)&apos;]"/>
