		<string key="VorgangsDeskriptoren" value="[&apos;Berufliche Weiterbildung&apos;, &apos;Bildungsabschluß&apos;, &apos;Europäische Gemeinschaften&apos;, &apos;Rechtsvorschrift&apos;]"/>
		<string key="VTyp" value="Gesetz"/>
