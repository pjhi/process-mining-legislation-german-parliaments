			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Asylverfahrensgesetz"/>
			<string key="Titel" value="Gesetz zur Ausführung des Asylbewerberleistungsgesetzes und zur Änderung des Gesetzes zur Ausführung des Bundessozialhilfegesetzes"/>
			<string key="DokNr" value="13/2479"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d2479.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Beim regelmäßigen automatisierten Datenabgleich von Daten Leistungsberechtigter nach dem &lt;br /&gt;Asylbewerberleistungsgesetz innerhalb des Landes Berlin handelt es sich nicht um einen Datenabgleich &lt;br /&gt;verschiedener Leistungsträger untereinander, welcher bundesrechtlich geregelt ist, sondern um einen &lt;br /&gt;Datenabgleich innerhalb eines einheitlichen Trägers. Insoweit stellt die hierzu erlassende Rechtsverordnung &lt;br /&gt;nach dem BSHG keine ausreichende Rechtsgrundlage für einen Datenabgleich innerhalb des Landes Berlin dar, &lt;br /&gt;so daß die Notwendigkeit besteht, für den Datenabgleich innerhalb des Landes Berlin eine &lt;br /&gt;Regelung zu schaffen.&lt;br /&gt; &lt;br&gt;Mit geändert wurde: Gesetz zur Ausführung des Bundessozialhilfegesetzes"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
