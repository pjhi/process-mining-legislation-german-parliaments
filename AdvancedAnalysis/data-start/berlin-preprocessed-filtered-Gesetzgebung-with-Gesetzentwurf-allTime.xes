		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="2006-05-12T02:00:00.000+02:00"/>
			<string key="DBID" value="D-173646"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Gebührenordnung"/>
			<string key="Titel" value="Zweites Gesetz zur Änderung des Gesetzes über Gebühren und Beiträge"/>
			<string key="DokNr" value="15/5125"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-5125.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Änderung der Bemessungsgrundlage der Verwaltungsgebühren: Neben den Kosten des für die jeweilige Amtshandlung entstehenden Verwaltungsaufwandes ist auch der Wert des Gegenstandes der Amtshandlung, der Nutzen oder die Bedeutung der Amtshandlung für den Gebührenschuldner bei der Gebührenbemessung zu berücksichtigen. - Einführung eines sog. &quot;Auffanggebührentatbestandes&quot;, der es ermöglicht, für neue Amtshandlungen Gebühren zu erheben, ohne auf die Überarbeitung einer bestehenden oder die Einführung einer neuen Tarifstelle in eine Gebührenordnung warten zu müssen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
