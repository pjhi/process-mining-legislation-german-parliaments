			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Lehrer"/>
			<string key="Titel" value="Zweites Gesetz zur Änderung besoldungsrechtlicher und laufbahnrechtlicher Vorschriften"/>
			<string key="DokNr" value="13/3771"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3771.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Für Lehrkräfte war die bisherige Voraussetzung für die Aufstiegsmöglichkeiten zum Studienrat, daß sie nach der&lt;br /&gt;Ernennung zum Beamten auf Lebenszeit in längstens drei Jahren mit insgesamt mindestens 24 Jahreswochenstunden in &lt;br /&gt;der gymnasialen Oberstufe oder im allgemeinbildenden Unterricht an einer berufsbildenden Schule tätig waren.&lt;br /&gt; Nunmehr wird zugunsten dieser Lehrkräfte diese Regelung verbessert, indem sie dahingehend geändert wird, daß sie&lt;br /&gt; nach der Ernennung zum Beamten auf Lebenszeit mindestens zwei Jahre mit insgesamt 24 Jahreswochenstunden in der&lt;br /&gt; gymnasialen Oberstufe oder im allgemeinbildendenUnterricht an einer berufsbildenden Schule tätig waren.&lt;br&gt;&lt;br /&gt; Mit geändert wurde:&lt;br /&gt; Änderung der Verordnung über die Laufbahnen der Beamten des Schul- und Schulaufsichtsdienstes und des&lt;br /&gt; Voklshochschuldienstes \\nVorabüberweisung an AJugFamSchulSport f u. AInn"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
