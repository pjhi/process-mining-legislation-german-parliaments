			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Rechtsbereinigung"/>
			<string key="Titel" value="Gesetz zur Änderung von Vorschriften über die Aufgaben des Landesamtes für Gesundheit und Soziales Berlin und des Landesamtes für Arbeitsschutz, Gesundheitsschutz und technische Sicherheit Berlin sowie anderer Vorschriften"/>
			<string key="DokNr" value="15/2021"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-2021.pdf"/>
			<string key="Sb" value="1-42"/>
			<string key="Abstract" value="Der Senat erwartet aufgrund der Zusammenführung der Aufgabengebiete des öffentlichen Gesundheitsdienstes, der&lt;br /&gt;Gesundheitsförderung, der Prävention, der Obdachlosenhilfe und der Integration (insbesondere Sprachförderung) von&lt;br /&gt;Spätaussiedlern Synergieeffekte sowie mittelfristig Personaleinsparungen&lt;br&gt;Mit geändert wurden:  Allgemeines Sicherheits- und Ordnungsgesetz (ASOG); Allgemeines Zuständigkeitsgesetz; Gesundheitsdienst-Gesetz;  Gesundheitsdienst-Zuständigkeitsverordnung; Verordnung über die Zuständigkeit für einzelne Bezirksaufgaben"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
