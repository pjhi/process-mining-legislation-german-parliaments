			<string key="DBID" value="D-166555"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Abgeordnetengesetz"/>
			<string key="Titel" value="Sechzehntes Gesetz zur Änderung des Landesabgeordnetengesetzes"/>
			<string key="DokNr" value="15/4294"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Partei des Demokratischen Sozialismus (Die Linkspartei.PDS)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-4294.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Einfügung des § 5a zu Verhaltensregeln für Mitglieder des Abgeordnetenhauses. Unter anderem:&lt;br /&gt;Angabe von personengebundenen Daten zur Aufnahme in das Handbuch und den Internetauftritt des&lt;br /&gt;Abgeordnetenhauses;&lt;br /&gt;Anzeige außerberuflicher entgeltlicher Tätigkeiten der Beratung, Interessenvertretung und&lt;br /&gt;Gutachtererstellung;&lt;br /&gt;gesonderte Rechnungsführung über erhaltende Geldspenden für politische Tätigkeiten;&lt;br /&gt;Unterlassung von Hinweisen auf Mitgliedschaft im Abgeordnetenhaus in beruflichen und&lt;br /&gt;geschäftlichen Angelegenheiten;&lt;br /&gt;Unzulässigkeiten der Annahme für die Ausübung des Mandats erfolgender Zuwendungen, die&lt;br /&gt;nicht in diesem Gesetz vorgesehen sind;&lt;br /&gt;Offenlegung bei Interessenverknüpfungen von Ausschussbehandlungen und Entgelttätigkeit.&lt;br /&gt; Änderung von § 7&lt;br /&gt; Abs. 1: Nutzung von Informations- und Kommunikationseinrichtungen&lt;br /&gt; Abs. 2: Für die Beschäftigung von Mitarbeiterinnen und Mitarbeitern zur Unterstützung bei der &lt;br /&gt;               parlamentarischen Arbeit werden jedem Abgeordneten Aufwendungen bis zu"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="81026"/>
			<date key="DokDat" value="2005-09-16T00:00:00+00:00"/>
			<date key="DokDat_original" value="2005-09-16T00:00:00+00:00"/>
		</event>
