			<string key="Desk" value="Frauenförderung"/>
			<string key="Titel" value="Änderung des Landesgleichstellungsgesetzes (LGG) &lt;br /&gt;(Siebentes Gesetz zur Änderung des Landesgleichstellungsgesetzes)"/>
			<string key="DokNr" value="14/1406"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/14/DruckSachen/d141406.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das geltende Landesgleichstellungsgesetz enthält in der&lt;br /&gt;Anlage zu § 19 Vorgaben zur Erhebung umfangreicher&lt;br /&gt;Einzelangaben über die Beschäftigtenstruktur des Berliner&lt;br /&gt;Landesdienstes. Das Verfahren ist mit hohem&lt;br /&gt;Verwaltungsaufwand verbunden, deshalb ist es im Interesse&lt;br /&gt;rationellen Verwaltungshandelns erforderlich, sich auf die&lt;br /&gt;gleichstellungspolitisch wesentlichen Angaben zu&lt;br /&gt;konzentrieren."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="13.10.2001"/>
