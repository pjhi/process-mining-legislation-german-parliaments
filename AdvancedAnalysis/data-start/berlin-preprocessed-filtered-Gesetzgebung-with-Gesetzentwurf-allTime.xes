			<string key="DokNr" value="16/3326"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-3326.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Um dem berechtigten Interesse der Bevölkerung nach mehr Transparenz im Parlament Rechnung zu tragen, sollen die Regeln über die Anzeige und Veröffentlichung von Tätigkeiten von Abgeordneten im Landesabgeordnetengesetz klarer gefasst und verschärft werden. Der vorliegende Gesetzentwurf orientiert sich weitgehend an den Regelungen des Bundestages."/>
