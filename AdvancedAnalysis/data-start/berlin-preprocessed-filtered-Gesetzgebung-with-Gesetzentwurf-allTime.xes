			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Fischerei"/>
			<string key="Titel" value="Gesetz über den Fischereischein &lt;br /&gt;(Landesfischereischeingesetz - LFischScheinG)"/>
			<string key="DokNr" value="12/5407"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-5407.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Anerkennung des Berliner Fischereischeins in anderen&lt;br /&gt;Bundesländern ist in Zukunft in Frage gestellt. Im Vorfeld&lt;br /&gt;verlangen Fischereiberechtigte bereits zusätzliche&lt;br /&gt;Prüfungsnachweise von Berliner Anglern. Der Fischereischein&lt;br /&gt;soll von jedem Bundesland anerkannt werden; diese machen die&lt;br /&gt;Anerkennung von bestimmten Voraussetzungen&lt;br /&gt;(Sachkundenachweis) abhängig. Die Voraussetzungen für die&lt;br /&gt;Anerkennung wird mit der Neufassung geschaffen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1995"/>
			<string key="NrInTyp" value="12/0"/>
