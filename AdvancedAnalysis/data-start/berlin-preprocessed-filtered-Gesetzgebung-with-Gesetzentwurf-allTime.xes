			<string key="Desk" value="Besoldung"/>
			<string key="Titel" value="Gesetz zur Festschreibung der Amtsbezüge und sonstiger Leistungen der Mitglieder des Senats"/>
			<string key="DokNr" value="12/1555"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1555.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Durch die Festschreibung der Amtsbezüge und sonstiger&lt;br /&gt;Leistungen wird erreicht, daß das Amtsgehalt, der&lt;br /&gt;Ortzuschlag, die Dienstaufwandsentschädigung sowie das&lt;br /&gt;Urlaubsgeld und die jährliche Sonderzuwendung bis zum 30.&lt;br /&gt;Juni 1993 an allgemeinen Besoldungsverbesserungen des&lt;br /&gt;Jahres 1992 nicht teilnehmen. Durch § 1 Abs. 2 wird&lt;br /&gt;sichergestellt, daß nur Senatsmitglieder (West) von der&lt;br /&gt;Festschreibung erfaßt werden."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
