			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Sicherungsverwahrung"/>
			<string key="Titel" value="Gesetz zur Weiterentwicklung des Berliner Justizvollzugs"/>
			<string key="DokNr" value="17/2442"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-2442.pdf"/>
			<string key="Sb" value="1-635"/>
			<string key="Abstract" value="Mit diesem Gesetz wird der Vollzug der Strafhaft erstmalig durch ein landeseigenes Gesetz geregelt. Übernahme der Inhalte des Strafvollzugsgesetzes des Bundes. Redaktionelle Anpassung der Gesetze zur Jugendstrafhaft, Untersuchungshaft und der Sicherungsverwahrung.&lt;br&gt;&lt;br /&gt;Die Eckpunkte sind:&lt;br&gt;&lt;br /&gt;Stärkerer Schutz der Opfer von Straftaten; Einführung eines standardisierten Diagnostikverfahrens zur genaueren Analyse der Ursachen von Straffälligkeit; Eingliederung der Gefangenen in das Leben in Freiheit; Maßnahmen zur Erreichung des Vollzugsziels (z.B. Behandlung von Suchtmittelabhängigkeit) entscheidet ist die Auseinandersetzung des Straftäters mit seiner Tat; Neuausrichtung der Sozialtherapie, nicht nur für Gefangene von Sexualstraftaten sondern auch für andere Gefangenengruppen (z.B. Gewalttäter); Individuelle Förderung von Gefangenen durch Weiterbildungs- und Qualifizierungsmöglichkeiten für eine bessere berufliche Eingliederung.&lt;br&gt;&lt;br /&gt;Artikelgesetz:&lt;br&gt;Artikel I: Gesetz über den Vollzug der FreiheitssVorabüberweisung an ARecht"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="180250"/>
			<date key="DokDat" value="2015-09-08T00:00:00+00:00"/>
			<date key="DokDat_original" value="2015-08-09T00:00:00+00:00"/>
		</event>
