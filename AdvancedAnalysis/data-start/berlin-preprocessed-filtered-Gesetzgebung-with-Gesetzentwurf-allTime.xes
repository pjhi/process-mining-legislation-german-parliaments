			<string key="Titel" value="Achtes Gesetz zur Änderung der Verfassung von Berlin"/>
			<string key="DokNr" value="15/5038"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Partei des Demokratischen Sozialismus (Die Linkspartei.PDS)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-5038.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Ausbau der Kontrollrechte der einzelnen Abgeordneten und des Abgeordnetenhauses insgesamt (Recht auf Akteneinsicht und Auskunftpflicht); Stärkung der Verantwortlichkeit des Regierenden Bürgermeisters gegenüber dem Abgeordnetenhaus (Ernennung und Entlassung der Senatorinnen und Senatoren durch den Regierenden Bürgermeister); Erweiterung der Gegenstände der Volksinitiative und Volksgesetzgebung als Instrumente der direkten Demokratie.&lt;br&gt;&lt;br /&gt;Änderung Art. 45; Einfügung Abs. 2&lt;br&gt;Einfügung Art. 49 a&lt;br&gt;Änderung  Art. 55, 56, 57, 58, 61, 62, 63"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
