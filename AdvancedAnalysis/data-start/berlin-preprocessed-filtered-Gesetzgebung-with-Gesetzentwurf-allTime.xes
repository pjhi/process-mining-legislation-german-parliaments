			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Grundstück"/>
			<string key="Titel" value="Gesetz zur Übertragung von Grund und Boden an Wohnungsbaugenossenschaften &lt;br /&gt;Gesetz über die Veräußerung von Grundstücken Berlins an Wohnungsgenossenschaften"/>
			<string key="DokNr" value="12/1674"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1674.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Den Wohnungsbaugenossenschaften im Ostteil Berlins ist der&lt;br /&gt;ehem. volkseigene Grund und Boden, auf dem Ihre&lt;br /&gt;Wohngebäude errichtet sind, als Eigentum zu übertragen.&lt;br /&gt;Der Kaufpreis ist dabei so zu bemessen, daß Ihre&lt;br /&gt;finanzielle Fähigkeit, den Wohnungsbestand instandzusetzen&lt;br /&gt;und zu modernisieren, nicht gefährdet wird."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
