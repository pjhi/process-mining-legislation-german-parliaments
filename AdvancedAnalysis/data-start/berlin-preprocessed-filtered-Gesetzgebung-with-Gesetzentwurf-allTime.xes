			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Anstalt des öffentlichen Rechts"/>
			<string key="Titel" value="Gesetz über die Errichtung einer Landesanstalt Schienenfahrzeuge Berlin (LSFB-Errichtungsgesetz - LSFBG)"/>
			<string key="DokNr" value="18/3190"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-3190.pdf"/>
			<string key="Sb" value="1-70"/>
			<string key="Abstract" value="Die Landesanstalt ist für die Beschaffung, Verwaltung und Nutzungsüberlassung von Fahrzeugen zuständig, die für den Schienenpersonennahverkehr in Berlin und im Gebiet des Verkehrsverbundes Berlin-Brandenburg (VBB) ausschließlich im Rahmen der von den zuständigen Aufgabenträgern finanzierten S-Bahn-Verkehre eingesetzt und hierfür Verkehrsunternehmen beigestellt werden. Darüber hinaus hat die Landesanstalt die Aufgabe den Erwerb und die Nutzungsüberlassung von Grundstücken für die Errichtung von Serviceeinheiten wie beispielsweise Werkstattanlagen und Abstellgleise an entsprechende Betreiber zu übertragen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
