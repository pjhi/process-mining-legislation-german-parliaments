			<string key="Titel" value="Gesetz zur Änderung des Allgemeinen Sicherheits- und Ordnungsgesetzes sowie der Verordnung über die Erhebung von Gebühren im Gesundheits- und Sozialwesen"/>
			<string key="DokNr" value="16/2367"/>
			<string key="Urheber" value="nan"/>
