			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3629.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Es ist beabsichtigt, die Staatsanwaltschaft II bei dem Landgericht Berlin zum 30. September 1999 aufzulösen. Die noch offenen Verfahren wird die Staatsanwaltschaft I bei dem Landgericht Berlin abschließend erledigen. Einer eigenständigen Staatsanwaltschaft, die für die Verfolgung der Regierungskriminalität und der im Zusammenhang mit der Vereinigung stehenden Kriminalität sowie des Justizunrechts zuständig ist, bedarf des zukünftig nicht mehr."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
