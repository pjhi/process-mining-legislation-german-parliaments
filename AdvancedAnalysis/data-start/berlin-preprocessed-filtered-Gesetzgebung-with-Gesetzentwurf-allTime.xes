			<string key="Desk" value="Verwaltungsreform"/>
			<string key="Titel" value="Drittes Gesetz zur Reform der Berliner Verwaltung &lt;br /&gt;(Verwaltungsreform-Grundsätze-Gesetz - VGG)"/>
			<string key="DokNr" value="13/3415"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3415.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Festlegung grundlegender Maßnahmen der Personalplanung sowie haushaltsrechtlicher Bestimmungen in Zusammenhang mit der Umsetzung der Verwaltungsreform.&lt;br /&gt; &lt;br&gt;Mit geändert wurden:  Änderung des Bezirksverwaltungsgesetzes; Änderung des Landesbeamtengesetzes; Änderung des Laufbahngesetzes;  Änderung der Landeshaushaltsordnung; Änderung des Gesetzes zur Ausführung des Gerichtsverfassungsgesetzes; Änderung des Gesetzes zur Ausführung der Verwaltungsgerichtsordnung; Änderung des Gesetzes zur Ausführung der  Finanzgerichtsordnung; Änderung des Gesetzes zur Ausführung des Sozialgerichtsgesetzes; Änderung des Gesetzes zur Ausführung des Arbeitsgerichtsgesetzes \\nVorabüberweisung an ASonVerwRef u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
