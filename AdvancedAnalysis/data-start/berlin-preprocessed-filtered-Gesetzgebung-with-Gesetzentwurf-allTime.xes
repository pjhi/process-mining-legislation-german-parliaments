			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Kammergericht"/>
			<string key="Titel" value="Gesetz über die Wahl der Präsidentinnen und Präsidenten der oberen Landesgerichte"/>
			<string key="DokNr" value="15/0842"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-0842.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Wahl und die Abberufung der Generalstaatsanwältinnen und&lt;br /&gt;Generalstaatsanwälte auf Vorschlag des Senats durch das&lt;br /&gt;Abgeordnetenhaus ist seit Inkrafttreten der Verfassung von&lt;br /&gt;Berlin vom 23. November 1995 von Verfassungs wegen nicht mehr&lt;br /&gt;geboten. Das vorliegende Gesetz ist begrenzt auf die Wahl der&lt;br /&gt;Präsidentinnen und Präsidenten der oberen Landesgerichte. Die&lt;br /&gt;in dem bisherigen Gesetz (§2 Abs. 2) vorgesehene Altersgrenze&lt;br /&gt;entfällt. Die Ermächtigung zum Erlass von&lt;br /&gt;Verwaltungsvorschriften gem. § 8 des Gesetz über die Wahl der&lt;br /&gt;Präsidenten der oberen Landesgerichte und der&lt;br /&gt;Generalstaatsanwälte wird gestrichen. Die&lt;br /&gt;Generalstaatsanwältinnen und Generalstaatsanwälte werden zu&lt;br /&gt;Laufbahnbeamten."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
