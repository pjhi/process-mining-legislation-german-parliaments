			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Öffentliche Sicherheit und Ordnung"/>
			<string key="Titel" value="Gesetz zur Änderung des Allgemeinen Sicherheits- und Ordnungsgesetzes (ASOG)"/>
			<string key="DokNr" value="13/3511"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3511.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Es hat sich gezeigt, daß neben der Strafverfolgung die präventive Kriminalitätsbekämpfung eine immer größer werdende&lt;br /&gt;Bedeutung in Berlin hat. Dabei spielt für den Berliner Raum die grenzüberschreitende Kriminalität eine besondere Rolle.&lt;br /&gt;Die Bekämpfung dieser Kriminalitätsform kann heute nicht mehr streng fallbezogen erfolgen. Der Berliner Polizei sollte&lt;br /&gt;daher stärker als bisher die gesetzliche Möglichkeit an die Hand gegeben werden, grenzüberschreitende Kriminalität vorbeugend zu bekämpfen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
