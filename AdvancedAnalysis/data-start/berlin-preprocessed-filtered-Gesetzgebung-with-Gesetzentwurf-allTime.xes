			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Abgeordnetengesetz"/>
			<string key="Titel" value="Finanzierung der Mehrkosten bei Änderung des Landesabgeordnetengesetzes"/>
			<string key="DokNr" value="15/4295"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-4295.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Mit Einführung des § 7 b in das Landesabgeordnetengesetz (&quot;Beschäftigung von Mitarbeiterinnen und Mitarbeitern&quot;) entstehen in der laufenden Wahlperiode Kosten in Höhe von ca. 850.00 Euro jährlich. Diese sollen nicht als zusätzliche Mehrkosten des Parlaments zu Lasten der Landeskasse anfallen: Laut Präsidiumsbeschluss vom 30.8.2005 können die im Haushaltsentwurf 2006/2007 für Diäten- und Fraktionszuschusserhöhungen eingestellten 360.000 bzw. 390.000 Euro für die Finanzierung dieser Personalaufwendungen eingesetzt werden. Darüber hinaus bietet der Einzelplan 01 im Haushalt des Abgeordnetenhauses weitere Einsparpositionen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
