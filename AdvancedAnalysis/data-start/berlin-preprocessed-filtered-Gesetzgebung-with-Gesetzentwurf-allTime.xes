			<string key="Desk" value="Abfallwirtschaft"/>
			<string key="Titel" value="Gesetz über die Vermeidung und Entsorgung von Abfällen im Land Berlin (Landesabfallgesetz - LAbfG)"/>
			<string key="DokNr" value="13/3409"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3409.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Ziel einer zukunftsweisenden Abfallwirtschaftspolitik muß es sein, die Abfallwirtschaft im Sinne der Daseinsvorsorge dauerhaft öffentlich und nach ökologischen Kriterien zu organisieren. Zu den ökologischen Kriterien gehört insbesondere eine klare formulierte Zielhierachie - Vorrang der Abfallvermeidung vor der Verwertung, als auch der Vorrand der Verwertung vor der Beseitigung."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
