			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Psychiatrie"/>
			<string key="Titel" value="Gesetz über Hilfen und Schutzmaßnahmen bei psychischen Krankheiten (PsychKG)        &lt;br /&gt;(Gesetz zur Neuregelung des Rechts für psychisch erkrankte Personen)"/>
			<string key="DokNr" value="17/2696"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-2696.pdf"/>
			<string key="Sb" value="1-310"/>
			<string key="Abstract" value="Umsetzung von Vorgaben der UN-Behindertenrechtskonvention sowie von Urteilen des Bundesverfassungsgerichts und des Bundesgerichtshofes zu Patientenautonomie und Zwangsmedikation:&lt;br /&gt;Rechtfertigung von Zwangsbehandlungen nur bei Selbst- oder Fremdgefährdung oder wenn Patienten nicht in der Lage sind, über die Behandlung zu entscheiden. - Erweiterung der Dokumentationspflichten. - Besondere interne und externe Überprüfung vor und während der Durchführung von Zwangsbehandlungen.&lt;br&gt;&lt;br /&gt;Artikelgesetz:&lt;br&gt;Artikel I: Gesetz über Hilfen und Schutzmaßnahmen bei psychischen Krankheiten (PsychKG)&lt;br&gt;Artikel II: Gesundheitsdienst-Gesetz; Landeskrankenhausgesetz; Wohnteilhabegesetz; Allgemeines Sicherheits- und Ordnungsgesetz (ASOG)"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
