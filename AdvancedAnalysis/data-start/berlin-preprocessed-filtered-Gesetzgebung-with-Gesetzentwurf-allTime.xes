			<string key="Desk" value="Baugesetzbuch"/>
			<string key="Titel" value="Drittes Gesetz zur Änderung des Gesetzes zur Ausführung des Baugesetzbuches (AGBauGB)"/>
			<string key="DokNr" value="13/2721"/>
			<string key="Urheber" value="Partei des Demokratischen Sozialismus (PDS)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d2721.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Mit der Aufnahme der Verfahrensregelung für die Aufstellung von Bereichsentwicklungsplänen (BEP) in das AGBauGB wird der Tatsache Rechnung getragen, daß die BEP der Konkretisierung des Flächennutzungsplanes (FNP) auf bezirklicher Ebene dient und somit dem FNP rechtlich und verfahrensgemäßig gleichzustellen ist. Damit ist zugleich klargestellt, daß es sich bei der Aufstellung von BEP um eine Pflichtaufgabe der Bezirke handelt, deren Erfüllung durch die Bereitstellung von Personal und Ressourcen gesichert werden muß."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
