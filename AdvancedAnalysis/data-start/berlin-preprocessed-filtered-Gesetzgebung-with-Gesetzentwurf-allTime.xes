			<string key="Desk" value="Whistleblowing"/>
			<string key="Titel" value="Spielräume auf Landesebene für den Schutz von Hinweisgeber/-innen nutzen (I)             &lt;br /&gt;(Gesetz zur Verbesserung des Schutzes von Hinweisgeber/-innen)"/>
			<string key="DokNr" value="17/2082"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-2082.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Konkretisierung der Voraussetzungen für die Einstellung eines Disziplinarverfahrens bei Verletzung der Verschwiegenheitspflicht durch HinweisgeberInnen. - Angehörigen des Verfassungsschutzes wird die direkte Kontaktaufnahme mit dem Ausschuss für Verfassungsschutz ermöglicht. - Als weitere Voraussetzung für die Beteiligung Berlins an privatrechtlichen Unternehmen wird ein den unternehmerischen oder betrieblichen Umständen angepasstes unternehmens- oder betriebsinternes Hinweisgebersystem zur Aufklärung von Missständen gefordert. - &lt;br /&gt;Bei der Vergabe von öffentlichen Aufträgen werden die ausführenden Unternehmen zum Schutz von HinweisgeberInnen verpflichtet.&lt;br&gt; &lt;br /&gt;Artikelgesetz:&lt;br&gt;Artikel I: Änderung des Disziplinargesetzes&lt;br&gt;Artikel II: Änderung des Gesetzes über den Verfassungsschutz&lt;br&gt;Artikel III: Änderung der Landeshaushaltsordnung&lt;br&gt;Artikel IV: Änderung des Berliner Ausschreibungs- und Vergabegesetzes"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="175451"/>
