			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Berufliche Weiterbildung"/>
			<string key="Titel" value="Drittes Gesetz zur Änderung des Gesetzes über die Weiterbildung von Ärzten, Zahnärzten, Tierärzten und Apothekern"/>
			<string key="DokNr" value="12/1010"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1010.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Mit dem Änderungsgesetz wird die versehentliche Reduzierung&lt;br /&gt;auf ärztliche Weiterbildungsstätten in der bisherigen&lt;br /&gt;Fassung beseitigt; Weiterbildung kann damit auch in&lt;br /&gt;Einrichtungen der zahnärztlichen, tierärztlichen und&lt;br /&gt;pharmazeutischen Versorgung durchgeführt werden. Ebenso&lt;br /&gt;wird den Kammern ermöglicht, alternative einer Prüfung&lt;br /&gt;gleichwertige Überprüfungsformen in die&lt;br /&gt;Weiterbildungsordnungen aufzunehmen.&lt;br /&gt; Änderung von § 6 Abs. 1 und von § 9 Abs. 2 Nr. 5"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
