			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Datenschutz"/>
			<string key="Titel" value="Gesetz über die Schaffung bereichsspezifischer Regelungen für die Verarbeitung personenbezogener Daten"/>
			<string key="DokNr" value="12/1029"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-1029.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Schaffung der nach § 6 Abs. 1 Berliner Datenschutzgesetz vom 17.12.1990 in den einzelnen Verwaltungsgebieten  erforderlichen Rechtsgrundlagen für die Verarbeitung personenbezogener Daten. Geregelt werden Verwaltungsprozesse im Zusammenhang mit: &lt;br&gt;&lt;br /&gt;1. Beseitigung von Leerstand und Zweckentfremdung,&lt;br&gt;&lt;br /&gt;2. Führung des Liegenschaftskatasters und der Bodenwirtschaftlichen Datei;&lt;br&gt;&lt;br /&gt;3.  Haushaltsplan;&lt;br&gt;&lt;br /&gt;4. Anzeigepflicht der Mitglieder des Vertretungsorgans rechtsfähiger Stiftungen sowie Auskunft aus dem Stiftungsverzeichnis &lt;br&gt;&lt;br /&gt;5. bestimmten konzessionierten Vereinen;&lt;br&gt;&lt;br /&gt;6. Erhebung und Verarbeitung von Studentendaten.&lt;br&gt;&lt;br /&gt;Änderungen: Gesundheitsgesetz, Berliner Kammergesetz, Gesetz über Pflegeleistungen.&lt;br&gt;&lt;br /&gt;Ferner Anpassungen des Berliner Datenschutzgesetzes an das Gesetz zur Fortentwicklung der Datenverarbeitung und des Datenschutzes vom 20. Dezember 1990 (BGBl 1990 Teil 1 S. 1954)."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
