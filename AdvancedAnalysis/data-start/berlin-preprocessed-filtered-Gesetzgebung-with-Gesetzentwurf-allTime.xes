			<string key="Desk" value="Stiftung"/>
			<string key="Titel" value="Gesetz über die Errichtung der Stiftung &quot;Max-Delbrück-Centrum für molekulare Medizin&quot;"/>
			<string key="DokNr" value="12/0886"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0886.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der Bund und das Land Berlin haben die Gründung des Forschungszentrums für molekulare Medizin vereinbart und sich verpflichtet, das Forschungszentrum zur Erfüllung seiner Aufgaben gemeinsam zu fördern. Das Forschungszentrum soll nach der Vereinbarung die Rechtsform einer Stiftung des öffentlichen Rechts des Landes Berlin bekommen. Bund und Land haben über die grundlegenden Organisationselemente der Stiftung Einigkeit erzielt, wobei die nähere Ausfüllung der Organisation der Stiftung einer Satzungsregelung überlassen bleiben soll."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
