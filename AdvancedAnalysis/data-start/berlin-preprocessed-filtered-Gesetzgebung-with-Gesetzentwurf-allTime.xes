			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Schulgesetz"/>
			<string key="Titel" value="Achtundzwanzigstes Gesetz zur Änderung des Schulgesetzes für Berlin  &lt;br /&gt;(28. ÄndSchulG)"/>
			<string key="DokNr" value="15/1604"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-1604.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Modifizierung des bisherigen Systems der Lernmittelfreiheit: Beteiligung der Eltern an den Kosten der Lernmittelbeschaffung durch einen auf 100 Euro (bezogen auf den Nennwert) begrenzten Eigenanteil pro SchülerIn und Schuljahr. Im Umfang des Eigenanteils gehen die Lernmittel (Schulbücher und ergänzende Druckschriften) in das Eigentum der Eltern über. Über den Eigenanteil hinausgehende Lernmittel werden wie bisher leihweise zur Verfügung gestellt. Wenn die Eltern nicht mehr unterhaltspflichtig sind, ist der Eigenanteil durch die volljährigen SchülerInnen zu erbringen. Die Festlegung der Höhe des Eigenanteils bleibt der Regelung durch Rechtsverordnung ebenso vorbehalten wie die Festlegung des Personenkreises, der auf Grund seiner finanziellen Situation von der Zahlung eines Eigenanteils befreit wird"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="76714"/>
