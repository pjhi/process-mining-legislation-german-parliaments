			<string key="Desk" value="Umweltverträglichkeitsprüfung"/>
			<string key="Titel" value="Gesetz über die Prüfung von Umweltauswirkungen bei bestimmten Vorhaben, Plänen und Programmen im Land Berlin -     &lt;br /&gt;Berliner Gesetz über die Umweltverträglichkeitsprüfung (UVPG-Bln)"/>
			<string key="DokNr" value="16/0179"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-0179.pdf"/>
			<string key="Sb" value="1-87"/>
			<string key="Abstract" value="Zweck dieses Gesetzes ist es sicherzustellen, dass bei bestimmten öffentlichen und privaten Vorhaben sowie bei Plänen und Programmen zur Umweltvorsorge nach einheitlichen Grundsätzen die Auswirkungen auf die Umwelt frühzeitig und umfassend ermittelt, beschrieben und bewertet werden und die Ergebnisse der durchgeführten Umweltprüfungen so früh wie möglich berücksichtigt werden.&lt;br&gt;Mit geändert wurden:&lt;br&gt;Berliner Straßengesetz; Bauordnung für Berlin; Landesseilbahngesetz \\nVorabüberweisung an AGesUmVer f u. AStadtVerk"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
