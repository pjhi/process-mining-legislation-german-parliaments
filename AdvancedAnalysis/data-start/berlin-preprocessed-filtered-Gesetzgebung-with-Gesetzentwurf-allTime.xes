		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1998-11-13T01:00:00.000+01:00"/>
			<string key="DBID" value="D-21514"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Baugesetzbuch"/>
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes zur Ausführung des Baugesetzbuchs - Beteiligung des Rats der Bürgermeister"/>
			<string key="DokNr" value="13/3259"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3259.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der Rat der Bürgermeister (RdB) wird bei Bebauungsplänen von&lt;br /&gt;gesamtstädtischer Bedeutung im Gegensatz zu den Verfahren von&lt;br /&gt;außergewöhnliche stadtpolitischer Bedeutung bisher nicht&lt;br /&gt;beteiligt. Eine vorherige Beteiligung des RdB soll künftig&lt;br /&gt;daher auch dann vorgeschrieben werden, wenn der Senat ein&lt;br /&gt;Bebauungsplanverfahren aufgrund gesamtstädtischer Bedeutung an&lt;br /&gt;sich ziehen will."/>
