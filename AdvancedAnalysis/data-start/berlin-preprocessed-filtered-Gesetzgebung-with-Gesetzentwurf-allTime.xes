			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Fehlbelegungsabgabe"/>
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes über den Abbau der Fehlsubventionierung im Berliner Wohnungswesen (AFWoG Bln)"/>
			<string key="DokNr" value="12/3460"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-3460.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die bisherige Regelung sieht bei nicht fristgemäßem Nachweis der Einkommensverhältnisse vor, daß der Zahlungspflichtige&lt;br /&gt;den Höchstbetrag zu entrichten hat. Erfolgt der Einkommensnachweis verspätet, darf nach geltendem Recht die Leistungspflicht nur für die Zukunft herabgesetzt werden. Diese Regelung führte zu nicht vertretbaren Härten. Daher soll eine &quot;Härteklausel&quot; geschaffen werden."/>
