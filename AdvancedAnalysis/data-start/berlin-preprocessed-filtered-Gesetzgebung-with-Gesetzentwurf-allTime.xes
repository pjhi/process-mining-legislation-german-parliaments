			<string key="Desk" value="Beamtenrecht"/>
			<string key="Titel" value="Gesetz zur Änderung dienstrechtlicher und haushaltsrechtlicher Vorschriften"/>
			<string key="DokNr" value="13/3416"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3416.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="- Dauer der Erprobungszeit vor Beförderungen verlängern;&lt;br /&gt; - Anhebung der Antragsaltersgrenze auf das 63. Lebensjahr;&lt;br /&gt; - Übernahme der für Bundesbeamte geltenden Bestimmungen über&lt;br /&gt;   Teilzeitbeschäftigung und&lt;br /&gt; - Einführung der Altersteilzeit&lt;br /&gt; &lt;br&gt;Mit geändert wurden:  Änderung des Landesbeamtengesetzes; Änderung des Laufbahngesetzes; Änderung des Gesetzes über die Vereinheitlichung des Berliner Landesrechts; Änderung des&lt;br /&gt; Haushaltsstrukturgesetzes 1996; Änderung der Landeshaushaltsordnung; Gesetz über laufbahnrechtliche Regelungen für den Vollzugsdienst an Jusitzvollzugsanstalten; Änderung der Arbeitszeitverordnung; Änderung des Bezirksverwaltungsgesetzes; Änderung des Personalvertretungsgesetzes; Änderung des Verwaltungsreform-Grundsätze-Gesetzes"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
