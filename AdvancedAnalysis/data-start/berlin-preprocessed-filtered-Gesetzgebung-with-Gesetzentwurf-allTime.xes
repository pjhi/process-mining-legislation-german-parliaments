			<string key="Desk" value="Beherbergungsgewerbe"/>
			<string key="Titel" value="Entwurf eines Gesetzes zur Bereinigung der Rechtsverhältnisse nach dem Gesetz über die Erhebung einer Abgabe der Beherbergungsbetriebe zur Förderung des Tourismus"/>
			<string key="DokNr" value="13/3926"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3926.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Wegen der ausschließlichen Belastung der&lt;br /&gt;Beherbergungsbetriebe sah ein Teil der Hotellerie das&lt;br /&gt;Gleichbehandlungsprinzip verletzt. Es wurden Klagen gegen das&lt;br /&gt;Land Berlin angestrebt und das Verwaltungsgericht Berlin hat&lt;br /&gt;verfassungsrechtliche Bedenken geäußert. Das OVG Berlin hat&lt;br /&gt;diese Bedenken bestätigt. Daraufhin wird nach Gütegesprächen&lt;br /&gt;ein Vergleich angestrebt. \\nVorabüberweisung an AWiBetr u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
