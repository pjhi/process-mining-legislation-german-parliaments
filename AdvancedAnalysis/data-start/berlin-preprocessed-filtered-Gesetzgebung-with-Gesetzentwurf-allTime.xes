			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Unmittelbarer Zwang"/>
			<string key="Titel" value="Änderung des Gesetzes über die Anwendung unmittelbaren Zwanges bei der Ausübung öffentlicher Gewalt durch &lt;br /&gt;Vollzugsbeamte des Landes Berlin (VZwG Bln)"/>
			<string key="DokNr" value="11/0406"/>
			<string key="Urheber" value="Die Republikaner (REP)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/11/DruckSachen/d11-0406.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Angesichts der Zunahme der Gewaltkriminalität würde die Polizei Ermächtigungsgrundlagen benötigen, die auch in&lt;br /&gt;extremen Einsatzsituationen ein einwandfrei rechtmäßiges hoheitliches Handeln der Polizeibehörde ermöglichen. Denn&lt;br /&gt;der Beamte kann nach Abgabe eines finalen Rettungsschusses nach derzeit geltendem Recht allenfalls als strafrechtlich&lt;br /&gt;gerechtfertigt gelten, nicht aber seine Handlung als verwaltungsrechtlich rechtmäßig. Eine verwaltungsrechtliche Rechtfertigung scheitert nämlich&lt;br /&gt;nach geltendem Berliner Landesrecht an dem Fehlen einer&lt;br /&gt;Ermächtigungsgrundlage."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1989"/>
			<string key="NrInTyp" value="11/0"/>
			<string key="VkDat" value="nan"/>
