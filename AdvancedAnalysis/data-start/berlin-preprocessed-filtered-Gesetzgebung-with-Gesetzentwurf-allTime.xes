			<string key="Desk" value="Pflegeberuf"/>
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes über die Durchführung von Modellprojekten zur Weiterentwicklung der Pflegeberufe"/>
			<string key="DokNr" value="16/2221"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-2221.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der Gesetzentwurf dient ausschließlich der Verlängerung der Frist, in der Modellprojekte zur Weiterentwicklung der Pflegeberufe auf der Grundlage von § 4 Abs. 6 des Krankenpflegegesetzes durchgeführt werden können. &lt;br&gt;Eine Verlängerung um drei Jahre würde bedeuten, dass ca. 75 zusätzliche Krankenpflegekräfte im Gesundheitswesen tätig werden, die sowohl über einen Berufsabschluss als Gesundheits- und Krankenpflegerin oder Gesundheits- und Krankenpfleger als auch über einen einschlägigen Bachelor-Abschluss verfügen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
