			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Statistik"/>
			<string key="Titel" value="Gesetz über die Statistik im Land Berlin &lt;br /&gt;(Landesstatistikgesetz - LStatG)"/>
			<string key="DokNr" value="11/1086"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/11/DruckSachen/d11-1086.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Einer gesetzlichen Regelung bedürfen:&lt;br&gt; a) Organisations- und&lt;br /&gt;Zuständigkeitsfragen bei der Durchführung von EG-, Bundes-&lt;br /&gt;und Landesstatistiken, insbesondere die Rechtsstellung und&lt;br /&gt;die Zuständigkeit des Statistischen Landesamtes,&lt;br&gt; b) die&lt;br /&gt;Anordnung und Durchführung von Landesstatistiken, auf die&lt;br /&gt;das Bundesstatistikgesetz nicht anwendbar ist,&lt;br /&gt;einschließlich der statistischen Geheimhaltung in diesem&lt;br /&gt;Bereich,&lt;br&gt;c) die Befugnis des Statistischen Landesamtes, im&lt;br /&gt;Rahmen des Statistischen Informationssystems Daten der&lt;br /&gt;Vollzugsverwaltung für statistische Auswertungen zu&lt;br /&gt;verwenden, und die Voraussetzungen, unter denen dem&lt;br /&gt;Statistischen Landesamt Daten der Vollzugsverwaltung für&lt;br /&gt;diesen Zweck zur Verfügung gestellt werden können."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1990"/>
			<string key="NrInTyp" value="11/0"/>
			<string key="VkDat" value="nan"/>
