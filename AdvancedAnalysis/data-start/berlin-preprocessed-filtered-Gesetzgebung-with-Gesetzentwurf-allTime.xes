		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="2006-03-14T01:00:00.000+01:00"/>
			<string key="DBID" value="D-171725"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Frauenvertreterin"/>
			<string key="Titel" value="Änderung des Landesgleichstellungsgesetzes (LGG)&lt;br /&gt;(Achtes Gesetz zur Änderung des Landesgleichstellungsgesetzes)"/>
			<string key="DokNr" value="15/4887"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-4887.pdf"/>
			<string key="Sb" value="1-15"/>
			<string key="Abstract" value="Die durch die aktuelle oberverwaltungsgerichtliche Rechtsprechung entstandenen Zweifel an der Klagebefugnis der Frauenvertreterin bzw. Gesamtfrauenvertreterin sind auszuräumen. Im Landesgleichstellungsgesetz ist die Klagebefugnis der Amtsinhaberin ausdrücklich zu verankern und auf die gerichtliche Überprüfbarkeit einer Verletzung ihrer Rechte aus dem LGG durch die Dienststelle zu beschränken. Mit dieser Regelung wird im Vergleich zur bisherigen verwaltungsgerichtlichen Spruchpraxis eine Verschlechterung der Rechtsposition der von den weiblichen Beschäftigten gewählten Interessenvertreterin vermieden."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
