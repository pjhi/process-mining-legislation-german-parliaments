			<string key="Desk" value="Rechtsvorschrift"/>
			<string key="Titel" value="Sechstes Gesetz zur Aufhebung von Rechtsvorschriften&lt;br /&gt;(6. Aufhebungsgesetz)"/>
			<string key="DokNr" value="14/1164"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/14/DruckSachen/d141164.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der vorliegende Gesetzentwurf enthält 135 aufzuhebende&lt;br /&gt;Rechtsvorschriften bzw. Teile von ihnen. Ein bereits im&lt;br /&gt;August 1997 beim Abgeordnetenhaus eingebrachter&lt;br /&gt;entsprechender Gesetzentwurf, der 47 aufzuhebende&lt;br /&gt;Vorschriften vorsah, ist seinerzeit der Diskontinuität anheim&lt;br /&gt;gefallen. In der Zwischenzeit haben zahlreiche weitere&lt;br /&gt;Rechtsvorschriften ihre praktische Bedeutung verloren.&lt;br /&gt;Hieraus erklärt sich der große Umfang aufzuhebender&lt;br /&gt;Vorschriften."/>
