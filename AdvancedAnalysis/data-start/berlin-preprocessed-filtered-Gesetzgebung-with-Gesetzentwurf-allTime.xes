			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Bauordnung"/>
			<string key="Titel" value="Drittes Gesetz zur Änderung der Bauordnung für Berlin"/>
			<string key="DokNr" value="17/2713"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-2713.pdf"/>
			<string key="Sb" value="1-282"/>
			<string key="Abstract" value="Anpassungen an die Musterbauordnung 2012 (MBO); Annäherung bauordnungsrechtlicher Anforderungen in der Region Berlin/ Brandenburg vor dem Hintergrund einer beabsichtigten weitgehenden Annäherung der Brandenburgischen Bauordnung (BbgBO) an die MBO, Vereinfachung der Berliner Bauordnung.&lt;br /&gt;Im Einzelnen u.a.: Neuregelung des Abstandsflächenrechts, Erleichterung der nachträglichen Errichtung von Aufzügen; Verpflichtung zum Einbau von Rauchwarnmeldern in Wohnungen; Reduzierung der baulichen Anforderungen für bestimmte Tagespflegeeinrichtungen und Pflegewohngemeinschaften; Verpflichtung zum Ausbau der Barrierefreiheit (Festsetzung des Anteils barrierefreier Wohnungen sowie Einrichtung barrierefreier Abstellräume für Rollstühle, Kinderwagen und Fahrräder in neuerrichteten Wohngebäuden; behindertengerechte Toilettenräume in Verkaufsflächen mit mehr als 300 Quadratmetern)"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
