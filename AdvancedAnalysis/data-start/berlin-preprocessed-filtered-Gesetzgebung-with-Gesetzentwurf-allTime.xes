			<string key="Titel" value="Gesetz zur Errichtung bezirklicher Ordnungsämter (OÄErrG)"/>
			<string key="DokNr" value="15/2843"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-2843.pdf"/>
			<string key="Sb" value="1-64"/>
			<string key="Abstract" value="Schaffung der Voraussetzungen für die Errichtung bezirklicher Ordnungsämter; Verlagerung der Aufgaben der Straßenverkehrsbehörde; Vorbereitungen für die Übergabe weiterer Ordnungsaufgaben an die Bezirke; Abgrenzung zu den Aufgaben der Bürgerämter unter Berücksichtigung des Standardaufgabenkataloges&lt;br&gt; Mit geändert wurden:  Bezirksverwaltungsgesetz; Allgemeines Sicherheits- und Ordnungsgesetz (ASOG); Gesetz über die Anwendung unmittelbaren  Zwangs bei der Ausübung öffentlicher Gewalt durch Vollzugsbeamte des Landes Berlin; Verordnung über sachliche Zuständigkeiten für die Verfolgung und Ahndung von Ordnungswidrigkeiten; Verordnung über die Wahrnehmung bestimmter polizeilicher Aufgaben durch Dienstkräfte der Polizei; Gesetz über das Verfahren der Berliner Verwaltung; Berliner Straßengesetz und das Haushaltsstrukturgesetz 1997 \\nVorabüberweisung an AInnSichO f, AVerwRefKIT u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
