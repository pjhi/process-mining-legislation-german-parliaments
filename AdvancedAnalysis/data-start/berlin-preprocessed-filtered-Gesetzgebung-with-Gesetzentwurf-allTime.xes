			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Gericht"/>
			<string key="Titel" value="Gesetz zur Schaffung dezentraler Verwaltungsstrukturen in der ordentlichen Gerichtsbarkeit"/>
			<string key="DokNr" value="15/3246"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-3246.pdf"/>
			<string key="Sb" value="1-17"/>
			<string key="Abstract" value="Um in der ordentlichen Gerichtsbarkeit in Berlin schwerfällige&lt;br /&gt;zeitraubende Verwaltungsabläufe künftig zu vermeiden, sind&lt;br /&gt;dezentrale Verwaltungsstrukturen mit voller Fach- und&lt;br /&gt;Ressourcenverantwortung zu schaffen. Dazu sollen&lt;br /&gt;Entscheidungsbefugnisse und Verantwortung für Finanz-, Sach- &lt;br /&gt;und Personalmittel von der bislang zuständigen Präsidentin des&lt;br /&gt;Kammergerichts auf das Landgericht und die einzelnen&lt;br /&gt;Amtsgerichte nicht mehr durch Direktoren sondern durch&lt;br /&gt;Präsidenten und Präsidentinnen geleitet werden. Damit&lt;br /&gt;verbunden ist eine Anhebung der Bezüge der Gerichtsvorstände&lt;br /&gt;i.d.R. um eine halbe Gehaltsstufe.&lt;br /&gt; Mit geändert wurde:&lt;br /&gt; Berliner Schiedsamtsgesetz \\nVorabüberweisung an ARecht u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
