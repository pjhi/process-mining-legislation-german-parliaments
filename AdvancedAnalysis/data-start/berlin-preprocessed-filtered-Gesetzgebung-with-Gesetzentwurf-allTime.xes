			<string key="Desk" value="Berliner Wasserbetriebe"/>
			<string key="Titel" value="Gesetz über demokratische Kontrollrechte bei der Teilprivatisierung der Berliner Wasserbetriebe"/>
			<string key="DokNr" value="14/0174"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
