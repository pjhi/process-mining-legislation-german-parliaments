			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Bodenschutz"/>
			<string key="Titel" value="Gesetz zur Vermeidung und Sanierung von Bodenverunreinigungen &lt;br /&gt; (Berliner Bodenschutzgesetz - Bln BodSchG -)"/>
			<string key="DokNr" value="12/5250"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-5250.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Umweltgesetzgebung schützt den Boden nur mittelbar bzw.&lt;br /&gt;nur in spezifischen Sachzusammenhängen. Hierdurch entstehen&lt;br /&gt;erhebliche Regelungslücken. Sanierungsmaßnahmen sind nur&lt;br /&gt;unter sehr engen Voraussetzungen, effektive Vorsorgemaßnahmen&lt;br /&gt;nur in Einzelfällen möglich. Mangelnde Informationen über&lt;br /&gt;mögliche Bodenverunreinigungen und Unklarheiten über&lt;br /&gt;Sanierungserfordernisse hemmen die Bauleitplanung."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1995"/>
			<string key="NrInTyp" value="12/0"/>
