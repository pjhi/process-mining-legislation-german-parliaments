			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-0897.pdf"/>
			<string key="Sb" value="1-107"/>
			<string key="Abstract" value="Schwerpunkte des Gesetzentwurfes sind:&lt;br /&gt; - ergänzende Regelungen zu der Übertragung von Ämtern mit&lt;br /&gt;   leitender Funktion im Beamtenverhältnis auf Probe und&lt;br /&gt;   auf Zeit,&lt;br /&gt; - Erweiterung der Bestimmungen über die Altersteilzeit,&lt;br /&gt; - Wegfall der Beteiligung des Landespersonalausschusses&lt;br /&gt; bei der Vorbereitung allgemeiner Regelungen der&lt;br /&gt;   beamtenrechtlichen Verhältnisse,&lt;br /&gt; - Wegfall der laufbahnrechtlichen Erprobungszeit bei&lt;br /&gt;   kostenneutraler Beförderung,&lt;br /&gt; - Änderung zum Inhalt der Beurteilung von Beamten,&lt;br /&gt; - Erweiterung der Ausnahmen von laufbahnrechtlichen&lt;br /&gt; Vorschriften durch Beschluss des&lt;br /&gt;   Landespersonalausschusses,&lt;br /&gt; - Wegfall der Verpflichtung zum Freihalten von zwei Stellen&lt;br /&gt;   für die Neueinstellung (sog. 2/3 - Regelung oder&lt;br /&gt;   Einstellungskorridor) sowie&lt;br /&gt; - weitere Flexibilisierung der Arbeitszeitverordnung für&lt;br /&gt;  Beamte.&lt;br /&gt; Mit geändert wurden:&lt;br /&gt; Landesbeamtengesetz; Laufbahngesetz; Haushaltsstrukturgesetz&lt;br /&gt; 1996 und 1997; Landesbesoldungsrecht;&lt;br /&gt;Landeshaushaltsordnung; Arbeitszeit"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
