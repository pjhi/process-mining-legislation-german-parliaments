			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Landesbürgschaft"/>
			<string key="Titel" value="Drittes Gesetz zur Änderung des Rückbürgschaftsgesetzes"/>
			<string key="DokNr" value="12/0997"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0997.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Förderung der Berliner Wirtschaft durch&lt;br /&gt;Bürgschaftsübernahme der Kreditgarantiegemeinschaften, die&lt;br /&gt;wiederum durch Rückbürgschaften Berlins und des Bundes&lt;br /&gt;abgesichert werden, ist derzeit noch auf Antragsteller&lt;br /&gt;gewerblicher Betriebe eingeschränkt. Für die Angehörigen&lt;br /&gt;freier Berufe besteht keine Möglichkeit der&lt;br /&gt;Kreditbesicherung, weil das Bürgschaftsprogramm des&lt;br /&gt;ERP-Sondervermögens wegen des Verbots der Doppelförderung&lt;br /&gt;nicht zur Absicherung von ERP-Krediten einsetzbar ist. Mit&lt;br /&gt;der Gesetzesänderung wird der Kreis der Begünstigten um&lt;br /&gt;die Freiberufler erweitert. Zur Gewährleistung der&lt;br /&gt;Rechtsgleichheit sollen künftig auch Freiberufler aus dem&lt;br /&gt;Westteil der Stadt durch Bürgschaften der&lt;br /&gt;Kreditgarantiegemeinschaft gefördert werden, die von&lt;br /&gt;Berliner Rückbürgschaften abgesichert sind.&lt;br /&gt; Änderung von § 3 Abs. 2"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
