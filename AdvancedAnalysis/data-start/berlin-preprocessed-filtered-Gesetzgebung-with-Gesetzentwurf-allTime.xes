			<string key="Titel" value="Gesetz zur Ergänzung des Berliner Hochschulgesetzes"/>
			<string key="DokNr" value="12/0227"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (B90/Gr)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0227.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Gemäß § 1 Abs. 4 BerlHG sind die Rechtsverhältnisse der&lt;br /&gt;durch die Vereinigung im Land Berlin hinzutretenden&lt;br /&gt;staatlichen Hochschulen durch ein Ergänzungsgesetz zum&lt;br /&gt;Berliner Hochschulgesetz zu regeln. Eine der wichtigsten&lt;br /&gt;Aufgaben dieses Gesetzes ist es, die Voraussetzungen für&lt;br /&gt;die strukturelle und personelle Erneuerung der Hochschulen&lt;br /&gt;im Ostteil Berlins zu schaffen."/>
