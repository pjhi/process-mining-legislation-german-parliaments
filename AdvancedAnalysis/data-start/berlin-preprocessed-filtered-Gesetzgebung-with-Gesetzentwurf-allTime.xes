			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Unmittelbarer Zwang"/>
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes über die Anwendung unmittelbaren Zwanges bei der Ausübung öffentlicher Gewalt &lt;br /&gt;durch Vollzugsbeamte des Landes Berlin (UZwG Bln)"/>
			<string key="DokNr" value="12/0273"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0273.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Mit der Vereinigung Berlins sind die Regelungen dieses Gesetzes soweit sie auf der äußeren militärischen Bedrohung und entsprechenden alliierten Anordnungen beruhten, aufzuheben. Künftig ist keine polizeiliche Gefahrensituation mehr denkbar, die mit atypischen polizeilichen Waffen wie Maschinengewehren und Handgranaten (§ 2 Abs. 4 Nr. 2 UZwG Bln) gelöst werden müßte. Auch die Regelungen über einen Schußwaffengebrauch im Bereich der Demarkationslinie (§ 17 UZwG Bln) sind obsolet geworden."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
