			<string key="Desk" value="Auskunfterteilung"/>
			<string key="Titel" value="Gesetz zur Förderung der Informationsfreiheit (Informationsfreiheitsgesetz - IFG)"/>
			<string key="DokNr" value="11/0958"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Bündnis 90/Die GRÜNEN (AL)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/\VT\11\DruckSachen\d11-0958.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Zweck dieses Gesetzes ist es, durch ein umfassendes&lt;br /&gt;Informationsrecht das in Akten festgehaltene Wissen und&lt;br /&gt;Handeln öffentlicher Stellen mit Ausnahme&lt;br /&gt;personenbezogener Daten unmittelbar der Allgemeinheit&lt;br /&gt;zugänglich zu machen, um über die bestehenden&lt;br /&gt;Informationsmöglichkeiten hinaus die demokratische&lt;br /&gt;Meinungs- und Willensbildung zu fördern und eine Kontrolle&lt;br /&gt;des staatlichen Handelns zu ermöglichen."/>
