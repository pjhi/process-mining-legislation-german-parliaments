			<string key="Desk" value="Lotterie"/>
			<string key="Titel" value="Gesetz zur Änderung des Gesetzes über die Deutsche Klassenlotterie Berlin und die Stiftung Deutsche Klassenlotterie Berlin (DKLB-Gesetz) &lt;br /&gt; (Fünftes Gesetz zur Änderung des Gesetzes über die Deutsche Klassenlotterie Berlin und die Stiftung Deutsche Klassenlotterie Berlin)"/>
