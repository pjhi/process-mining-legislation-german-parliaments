			<string key="Titel" value="Neuntes Gesetz zur Änderung des Straßenreinigungsgesetzes &lt;br /&gt;(Achtes Gesetz zur Änderung des Straßenreinigungsgesetzes)"/>
			<string key="DokNr" value="19/0721"/>
