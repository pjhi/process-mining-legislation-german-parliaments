			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Öffentliche Sicherheit und Ordnung"/>
			<string key="Titel" value="Gesetz zur Änderung des Allgemeinen Gesetzes zum Schutz der öffentlichen Sicherheit und Ordnung in Berlin"/>
			<string key="DokNr" value="12/0477"/>
			<string key="Urheber" value="Freie Demokratische Partei (FDP)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0477.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Bundesverfassungsgericht hat in seinem&lt;br /&gt;Volkszählungsurteil vom 15. Dezember 1983 aus dem&lt;br /&gt;allgemeinen Persönlichkeitsrecht das informationelle&lt;br /&gt;Selbstbestimmungsrecht abgeleitet und die&lt;br /&gt;verfassungsrechtlichen Anforderungen an Erhebung und&lt;br /&gt;Verarbeitung personenbezogener Daten präzisiert.&lt;br /&gt;Wegen der Eingriffsintensität und -häufigkeit wird der&lt;br /&gt;Polizeibereich als besonders regelungsbedürftig&lt;br /&gt;eingeschätzt. Ziel des Entwurfes ist es, die Anforderungen&lt;br /&gt;des Datenschutzes, der Normenklarheit und der&lt;br /&gt;Verhältnismäßigkeit der Mittel zu einem angemessenen&lt;br /&gt;Ausgleich zu bringen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="48316"/>
			<date key="DokDat" value="1991-06-19T00:00:00+00:00"/>
			<date key="DokDat_original" value="1991-06-19T00:00:00+00:00"/>
		</event>
