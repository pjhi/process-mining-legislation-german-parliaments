			<string key="Desk" value="Besoldungsrecht"/>
			<string key="Titel" value="Gesetz zur Änderung besoldungsrechtlicher Regelungen für Anwärterinnen und Anwärter sowie für begrenzt Dienstfähige"/>
			<string key="DokNr" value="18/2029"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-2029.pdf"/>
			<string key="Sb" value="1-30"/>
			<string key="Abstract" value="Reduzierung der wöchentlichen Arbeitszeit auf 44 Wochenarbeitsstunden für Brandmeister-Anwärterinnen und -Anwärter, die im Rahmen ihres Vorbereitungsdienstes ein Praktikum absolvieren&lt;br&gt;&lt;br /&gt;Schaffung der besoldungsrechtlichen Grundlage für Beamtinnen und Beamte auf Widerruf im Vorbereitungsdienst (Regelung über einen Vorschuss und dessen Inanspruchnahme im Falle der Familienpflegezeit oder Pflegezeit)&lt;br&gt;&lt;br /&gt;Außerkraftsetzung der Verordnung über Zuschläge bei Dienstbezügen im Falle begrenzter Dienstfähigkeit&lt;br&gt;&lt;br /&gt;Artikelgesetz:&lt;br&gt;Artikel 1: Änderung des Landesbesoldungsgesetzes&lt;br&gt;Artikel 2: Änderung des Bundesbesoldungsgesetzes in der Überleitungsfassung für Berlin"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
