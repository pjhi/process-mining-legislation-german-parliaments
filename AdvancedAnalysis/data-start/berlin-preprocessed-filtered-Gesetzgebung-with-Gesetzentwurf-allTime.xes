			<string key="Desk" value="Spielbank"/>
			<string key="Titel" value="Gesetz zur Änderung des Spielbankengesetzes"/>
			<string key="DokNr" value="15/1922"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-1922.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Höhe der Spielbankabgabe bemisst sich künftig nach einer&lt;br /&gt;abgestuften Regelung in Abhängigkeit von der Höhe des&lt;br /&gt;Bruttospielertrags des jeweiligen Spielbetriebs. Die&lt;br /&gt;Abgabensätze betragen 50, 55 und 60 vom Hundert des&lt;br /&gt;Bruttospielertrags."/>
