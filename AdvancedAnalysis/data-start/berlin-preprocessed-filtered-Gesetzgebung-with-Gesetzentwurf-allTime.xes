			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Berufliche Weiterbildung"/>
			<string key="Titel" value="Gesetz zur Umsetzung der Richtlinie des Rates der EG vom 15. September 1986 über eine spezifische Ausbildung in der Allgemeinmedizin (86/457/EWG) in deutsches Recht"/>
			<string key="DokNr" value="12/0471"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0471.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Richtlinie ist auf eine bessere allgemeine ärztliche&lt;br /&gt;Qualifikation der Nachwuchsärzte ausgerichtet, ohne die&lt;br /&gt;vorgesehene zweijährige Zusatzausbildung auf das Niveau&lt;br /&gt;der vierjährigen Weiterbildung in der Allgemeinmedizin&lt;br /&gt;anzuheben.&lt;br /&gt; Die nach Maßgabe der Richtlinie einzuführende&lt;br /&gt;Zusatzqualifikation erfolgt im Rahmen der Berufsausübung&lt;br /&gt;als Arzt. Es ist daher Ländersache, die Richtlinie in Form&lt;br /&gt;eines Landesgesetzes umzusetzen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
