			<string key="Desk" value="Verfassungsgericht"/>
			<string key="Titel" value="Verfassungsgerichtshofsgesetz"/>
			<string key="DokNr" value="11/1066"/>
			<string key="Urheber" value="Christlich Demokratische Union Deutschlands (CDU)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/11/DruckSachen/d11-1066.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Ausfüllung des Artikels 72 VvB, der die näheren Regelungen für die&lt;br /&gt;Bildung eines Verfassungsgerichtshofes einem Gesetz&lt;br /&gt;vorbehält. Mit dem zu erwartenden Vollzug der deutschen&lt;br /&gt;und damit auch Berliner Einheit und den wegfallenden&lt;br /&gt;alliierten Vorbehalten steht der Bildung eines Berliner&lt;br /&gt;Verfassungsgerichtshofes nichts mehr im Wege."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
