			<string key="Desk" value="Obduktion"/>
			<string key="Titel" value="Gesetz zum Schutz von Patientenrechten bei klinischen und anatomischen Sektionen sowie bei Gewebeentnahmen &lt;br /&gt;(Sektionsgesetz)"/>
			<string key="DokNr" value="13/0313"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d0313.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Zum Schutz der Selbstbestimmungsrechte der Patienten &lt;br /&gt;bei Sektionen wird ausgeschlossen, daß diese ohne &lt;br /&gt;vorliegende Einwilligung durchgeführt werden dürfen. &lt;br /&gt;Die Entnahme und Weitergabe von Geweben zur &lt;br /&gt;Herstellung von Arzneimitteln wird mit einer &lt;br /&gt;Extra-Zustimmungslösung und einer Qualitätskontrolle &lt;br /&gt;verbunden."/>
