			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Richtergesetz"/>
			<string key="Titel" value="Umlandproblematik bei den Richtervertretungen -  &lt;br /&gt; Gesetz zur Änderung des Berliner Richtergesetzes  &lt;br /&gt; (Siebentes Gesetz zur Änderung des Berliner Richtergesetzes)"/>
			<string key="DokNr" value="14/1063"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/14/DruckSachen/d141063.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Als Richtervertretungen existieren an Berliner Gerichten Richterräte und Präsidialräte. Wahlberechtigung und Wählbarkeit ist in § 62 des Gesetzes geregelt. Nach der bisherigen Fassung ist nur wählbar, wer auch zum Abgeordnetenhaus wählbar ist. Dies führt dazu, dass Richterinnen und Richter, die in Brandenburg wohnen, nicht wählbar sind. Diese Regelung ist im Hinblick auf&lt;br /&gt;Fusionsüberlegungen der beiden Bundesländer unhaltbar."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="28.07.2001"/>
