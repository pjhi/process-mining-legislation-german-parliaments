			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Rauchverbot"/>
			<string key="Titel" value="Inhabergeführte Einraumkneipen vom Rauchverbot ausnehmen!"/>
			<string key="DokNr" value="16/1407"/>
			<string key="Urheber" value="Christlich Demokratische Union Deutschlands (CDU)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-1407.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Änderung des Nichtraucherschutzgesetzes - NSRG vom 16.11.2007. § 4 Abs. 4 und 5:&lt;br&gt; Inhaber von kleinen gastronomischen Einrichtungen, deren Lokalitäten nur aus einem Raum bestehen, können selbst entscheiden, ob ihre Einrichtung ausschließlich rauchenden oder nichtrauchenden Gästen vorbehalten sei soll. Entsprechend deutlicher Hinweis bereits von außen.&lt;br&gt;&lt;br /&gt;Ausnahme nach Abs. 4 gilt auch für das Rauchen von Wasserpfeifen, wenn der Betreiber ausschließlich seine Verdienste daraus erzielt."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
