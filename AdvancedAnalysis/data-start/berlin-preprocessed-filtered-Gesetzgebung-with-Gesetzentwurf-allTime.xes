			<string key="Desk" value="Haushaltsgesetz 1998"/>
			<string key="Titel" value="Gesetz zur Beseitigung des strukturellen Ungleichgewichts des Haushalts 1998  &lt;br /&gt;(Haushaltsstrukturgesetz 1998 - HStrG 98)"/>
			<string key="DokNr" value="13/2100"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d2100.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="U.a. Art. II Gesetz zur Einführung der Zweitwohnungsteuer im Land Berlin (Berliner Zweitwohnungsteuergesetz - BlnZwStG) Das Innehaben einer Zweitwohnung im Land Berlin unterliegt der Zweitwohnungsteuer. Die Steuer bemißt sich nach der Nettokaltmiete und beträgt acht vom Hundert der Bemessungsgrundlage.&lt;br /&gt; &lt;br&gt;Mit geändert wurden: Haushaltsstrukturgesetz 1996; Gesetz zur Einführung der Zweitwohnungssteuer im Land Berlin; Änderung des Landesbeamtengesetzes; Änderung des Gesundheitsdienst-Gesetzes; Änderung des Laufbahngesetzes; Änderung des Sportförderungsgesetzes; Änderung des Berliner Hochschulgesetzes; Gesetz zur Bindung von Rückflüssen aus Darlehen zur Förderung des Wohnungsbaues (Rückflußbindungsgesetz); Änderung des&lt;br /&gt; Landeskrankenhausgesetzes; Neubekanntmachung des Artikels I des Haushaltsstrukturgesetzes 1996; \\nVorabüberweisung an ABauWohnV, AInn; AGesSozMi, &lt;br /&gt;AJugFamSchulSport, AWissFoKult u. ARecht"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
