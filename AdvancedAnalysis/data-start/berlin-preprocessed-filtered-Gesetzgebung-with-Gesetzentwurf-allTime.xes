			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Lebenspartnerschaftsgesetz"/>
			<string key="Titel" value="Rechtliche Gleichstellung lesbischer und schwuler Paare in Berlin  &lt;br /&gt;Gesetz zur Anpassung des Landesrechts auf Grund der Einführung der Eingetragenen Lebenspartnerschaft"/>
			<string key="DokNr" value="14/1179"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/14/DruckSachen/d141179.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="§ 1 Generalklausel: In Gesetzen, Rechtsverordnungen oder&lt;br /&gt;    Verwaltungsvorschriften des Landes ist die&lt;br /&gt;    Lebensparnterschaft der Ehe, die Lebenspartnerin/der&lt;br /&gt;    Lebenspartner gleichzustellen.&lt;br /&gt; § 2 Rechtsbereinigung: Dieses Gesetz, das sich auf die&lt;br /&gt;     mittelbare Landesverwaltung erstreckt, tritt zusammen&lt;br /&gt;     mit dem Lebenspartnerschaftsgesetz am 1. August 2001&lt;br /&gt;     in Kraft.&lt;br /&gt; Mit geändert wurden:&lt;br /&gt; Landesabgeordnetengesetz; Gesetz über den&lt;br /&gt; Verfassungsgerichtshof; Berliner&lt;br /&gt;Sicherheitsüberprüfungsgesetz; Gesetz über das Verfahren&lt;br /&gt; der Berliner Verwaltung; Gesetz über die Entschädigung der&lt;br /&gt; Mitglieder der Bezirksverordnetenversammlungen, der&lt;br /&gt; Bürgerdeputierten und sonstiger ehrenamtlich tätiger&lt;br /&gt; Personen; Landesbeamtengesetz; Laufbahngesetz;&lt;br /&gt; Landesdisziplinarordnung; Gesetz zur Ausführung des&lt;br /&gt; Lebenspartnerschaftsgesetzes; Berliner Kammergesetz;&lt;br /&gt; Gesetz über die Ausübung des Berufs der Hebamme und des&lt;br /&gt; Entbindungspflegers; Krebsregistergesetz; \\nGesetz über die Gutachterstelle für freiwillige Kastration und andere Behandlungsmethoden; Bestattungsgesetz; Sektionsgesetz; Nachwuchsförderungsgesetz; Kirchenaustrittsgesetz;  Schulverfassungsgesetz; Archivgesetz; Erschließungsbeitragsgesetz."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="20.10.2001"/>
