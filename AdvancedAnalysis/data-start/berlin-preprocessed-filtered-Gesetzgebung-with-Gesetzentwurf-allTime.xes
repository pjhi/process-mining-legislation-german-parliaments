			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Berufliche Weiterbildung"/>
			<string key="Titel" value="Erstes Gesetz zur Änderung des Gesetzes über die Weiterbildung in den Medizinalfachberufen"/>
			<string key="DokNr" value="12/1003"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1003.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Gesetz über die Weiterbildung in den&lt;br /&gt;Medizinalfachberufen (WMFG) ist am 9. Februar 1979&lt;br /&gt;erlassen worden. Aus den Erfahrungen von inzwischen über&lt;br /&gt;12 Jahren verweisen die Fachkreise (Deutsche&lt;br /&gt;Krankenhausgesellschaft, Universitäten,&lt;br /&gt;Weiterbildungsstätten, Berufsverbände, Gewerkschaften&lt;br /&gt;usw.) auf die Notwendigkeit, bei den&lt;br /&gt;Zulassungsvoraussetzungen für die Weiterbildungen mehr&lt;br /&gt;Handlungsspielraum zu schaffen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
