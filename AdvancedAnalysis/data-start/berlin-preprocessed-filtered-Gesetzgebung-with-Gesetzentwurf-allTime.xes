			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Rechtsbereinigung"/>
			<string key="Titel" value="Erstes Gesetz zur Rechtsvereinfachung und Entbürokratisierung"/>
			<string key="DokNr" value="15/1972"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-1972.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der vorgelegte Gesetzentwurf sieht in unterschiedlichen&lt;br /&gt;Rechtsbereichen die Aufhebung von nicht mehr benötigten&lt;br /&gt;Rechtsvorschriften sowie die Entlastung der Verwaltung von&lt;br /&gt;nicht zwingend erforderlichen Aufgaben vor.&lt;br /&gt; Mit geändert wurden:&lt;br /&gt; Gesetz über die Durchführung des Arbeitsschutzes; Verordnung&lt;br /&gt; über die Entseuchung und Entwesung der zur Krankenbeförderung&lt;br /&gt; benutzten Transportmittel; Verordnung über die&lt;br /&gt; Gewährleistung eines Mindesteinkommens der Hebammen;&lt;br /&gt;Sammlungsgesetz; Landeswaldgesetz; Feldschutzgesetz;&lt;br /&gt; Zweckentfremdungsbeseitigungsgesetz; Landesstatistikgesetz;&lt;br /&gt; Verordnung über den Statistischen Beirat; Berliner&lt;br /&gt; Landesfischereigesetz; Kinderspielplatzgesetz; Gesetz über&lt;br /&gt; die Aufgaben und die Weiterentwicklung des öffentlichen&lt;br /&gt; Personennahverkehrs im Land Berlin;&lt;br /&gt; Zuverlässigkeitsverordnung Bewachungsgewerbe; Berliner&lt;br /&gt; Naturschutzgesetz; Berliner Sicherheitsüberprüfungsgesetz"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
