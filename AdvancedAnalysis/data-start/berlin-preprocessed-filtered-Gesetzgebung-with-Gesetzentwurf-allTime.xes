			<date key="time:timestamp" value="1990-08-28T02:00:00.000+02:00"/>
			<string key="DBID" value="D-84"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Wiedergutmachung nationalsozialistischen Unrechts"/>
			<string key="Titel" value="Zwölftes Gesetz zur Änderung des Gesetzes über die Anerkennung und Versorgung der politisch, rassisch oder religiös Verfolgten des Nationalsozialismus (12. ÄndG-PrVG)"/>
			<string key="DokNr" value="11/1075"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Bündnis 90/Die GRÜNEN (GRÜNE/AL)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/11/DruckSachen/d11-1075.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der Gesetzesentwurf sieht u.a. folgende strukturelle Verbesserungen vor:&lt;br&gt;a) Einbeziehung von Verfolgten, die weder die deutsche Staatsangehörigkeit, noch ihren Wohnsitz in Deutschland hatten;&lt;br&gt;b) neue Anerkennungstatbestände, so daß auch Deserteure, Homosexuelle und Zwangssterilisierte PrVG-Rente beziehen können;&lt;br&gt;c) Erleichterung der Nachweispflicht bei Gesundheitsschäden;&lt;br&gt; d) bei 5jährigem Aufenthalt in Berlin auch nach Umzug ins Ausland weiter Erhalt der PrVG-Rente;&lt;br&gt; e) Versorgung für Witwen/Witwer von Verfolgten, sofern die Ehe mindestens fünf Jahre bestanden hat."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1990"/>
			<string key="NrInTyp" value="11/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="75358"/>
			<date key="DokDat" value="1990-08-28T00:00:00+00:00"/>
			<date key="DokDat_original" value="1990-08-28T00:00:00+00:00"/>
		</event>
