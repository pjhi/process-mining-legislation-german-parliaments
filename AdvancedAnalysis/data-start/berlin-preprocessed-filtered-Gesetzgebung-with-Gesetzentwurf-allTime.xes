		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="2000-02-02T01:00:00.000+01:00"/>
			<string key="DBID" value="D-31689"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Haushaltsgesetz 2000"/>
			<string key="Titel" value="Gesetz über die Feststellung des Haushaltsplans von Berlin für das Haushaltsjahr 2000 &lt;br /&gt;(Haushaltsgesetz 2000 - HG 2000)"/>
			<string key="DokNr" value="14/0150"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/14/DruckSachen/d140150-00.pdf"/>
			<string key="Sb" value="1-15"/>
			<string key="Abstract" value="Aus der Begründung:&lt;br /&gt; Der Entwurf enthält die erforderlichen Regelungen über die&lt;br /&gt; Feststellung des Haushaltsplans (§ 1), die Festsetzung der&lt;br /&gt; Hebesätze für die Gemeindesteuern, die jährlich neu&lt;br /&gt; festsetzt werden (§ 2), die Höchstbeträge der&lt;br /&gt; Kreditermächtigungen (§ 3), die Ermächtigungen zur Übernahme&lt;br /&gt; von Bürgschaften und Garantien (§ 4), sonstige&lt;br /&gt; Gewährleistungen (§ 5) und Sonderfinanzierung (§ 6), sowie&lt;br /&gt; personalwirtschaftliche Regelungen und Personalausgaben&lt;br /&gt; (§ 7).&lt;br /&gt; Das Ziel der konsequenten Konsolidierungspolitik liegt in&lt;br /&gt; der finanzpolitischen Perspektive auf das Jahr 2009. Bis&lt;br /&gt; dahin sollen das strukturelle Finanzierungsdefizit&lt;br /&gt; (1999: 6,8 Mrd DM) und die Neuverschuldung (1999: 4,1 Mrd DM)&lt;br /&gt; vollständig abgebaut sein. \\nVorabüberweisung an AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="27.04.2000"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="109791"/>
			<date key="DokDat" value="2000-02-02T00:00:00+00:00"/>
			<date key="DokDat_original" value="2000-02-02T00:00:00+00:00"/>
		</event>
