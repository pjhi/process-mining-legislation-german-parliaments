			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Bauordnung"/>
			<string key="Titel" value="Neuntes Gesetz zur Änderung der Bauordnung für Berlin - Beseitigung von diskriminierenden und benachteiligenden Regelungen für Menschen mit Behinderungen"/>
			<string key="DokNr" value="13/3212"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3212.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Gesetz sieht sowohl Verbesserungen beim Wohnungsbau und -bestand als auch beim Neubau von öffentlich zugänglichen&lt;br /&gt;Gebäuden sowie deren Bestand vor. Das beinhaltet den behindertengerechten Bau von Erdgeschoß-Wohnungen beim&lt;br /&gt;Neubau von Wohngebäuden, den Einbau behindertengerechter Aufzüge beim Neubau von Gebäuden ab 5 Geschosse, den&lt;br /&gt;behindertengerechten Neubau von öffentlich zugänglichen Gebäuden sowie die Ahndung von Verstößen gegen&lt;br /&gt;behindertengerechtes Bauen als Ordnungwidrigkeit."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
