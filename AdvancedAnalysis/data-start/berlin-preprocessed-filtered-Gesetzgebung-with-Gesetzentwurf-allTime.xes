			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Archivgesetz"/>
			<string key="Titel" value="Archivgesetz des Landes Berlin"/>
			<string key="DokNr" value="12/0299"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (B90/Gr)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0299.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die staatlichen Archive des Landes Berlin stehen vor einer grundlegenden Neuordnung: der Integration des Berliner&lt;br /&gt;Stadtarchivs, des Landesarchivs Berlin und möglicherweise des Büros für stadtgeschichtliche Dokumentation in das&lt;br /&gt;künftige Landesarchiv Berlin. Um eine kritische Geschichtsaufarbeitung möglich zu machen, wird eine&lt;br /&gt;Pflicht aller Stellen des Landes Berlin eingeführt, nicht mehr benötigte Materialien dem Landesarchiv Berlin anzubieten.&lt;br /&gt; &lt;br&gt;Der Gesetzentwurf enthält Regelungen zu folgenden Punkten:&lt;br /&gt;&lt;br&gt;a) Organisation und Zuständigkeit im Archivwesen im Land&lt;br /&gt;Berlin; &lt;br&gt;b) Aufgaben des Landesarchivs Berlin; &lt;br&gt;c)&lt;br /&gt;Archivgut; &lt;br&gt;d) Aussonderung und Anbietung von Archivgut; &lt;br&gt;e)&lt;br /&gt;Übernahme des Archivguts; &lt;br&gt;f) Sicherung des Archivguts; &lt;br&gt;g)&lt;br /&gt;Nutzung des Archivguts; &lt;br&gt;h) Recht auf Auskunft und&lt;br /&gt;Gegendarstellung; &lt;br&gt;i) Landesbildstelle Berlin; &lt;br&gt;j) Änderung&lt;br /&gt;des zweiten Gesetzes zum Abschluss der Entnazifizierung."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
