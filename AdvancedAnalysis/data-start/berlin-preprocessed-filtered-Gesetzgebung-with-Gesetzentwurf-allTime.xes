			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Denkmalschutz"/>
			<string key="Titel" value="Gesetz zum Schutz von Denkmalen in Berlin &lt;br /&gt;(Denkmalschutzgesetz Berlin - DSchG Bln)"/>
			<string key="DokNr" value="12/4977"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-4977.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Fortschreibung des Denkmalschutzgesetzes Berlin vom 22. Dezember 1977 vor dem Hintergrund des gewachsenen Stellenwerts von Denkmalschutz und Denkmalpflege.&lt;br&gt;Differenzierung des Denkmalbegriffs: Baudenkmale, Denkmalbereiche, Gartendenkmale, Bodendenkmale.&lt;br&gt;Schaffung eines „Landesdenkmalamtes Berlin“ als eine dem zuständigen Senator nachgeordnete Denkmalfachbehörde sowie unterer Denkmalschutzbehörden auch für die westlichen Bezirke Berlins.&lt;br&gt;Ablösung des bisherigen konstitutiven Eintragungsverfahrens durch die Einführung des deklaratorischen Listenverfahrens.&lt;br&gt;Anpassung der Entschädigungsregelung.&lt;br&gt;Vorkaufsrechts für Bau-, Garten- und ortsfeste Bodendenkmale."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1994"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
