		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1991-10-28T01:00:00.000+01:00"/>
			<string key="DBID" value="D-7614"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Statistik"/>
			<string key="Titel" value="Gesetz über die Statistik im Land Berlin &lt;br /&gt;(Landesstatistikgesetz - LStatG -)"/>
			<string key="DokNr" value="12/0820"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-0820.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Einer gesetzlichen Regelung bedürfen:&lt;br&gt;&lt;br /&gt; a) Organisations- und Zuständigkeitsfragen bei der&lt;br /&gt;Durchführung von EG-, Bundes- und Landesstatistiken,&lt;br /&gt;insbesondere die Rechtsstellung und die Zuständigkeit des&lt;br /&gt;Statistischen Landesamtes,&lt;br&gt;&lt;br /&gt; b) die Anordnung und Durchführung von Landesstatistiken,&lt;br /&gt;auf die das Bundesstatistikgesetz nicht anwendbar ist,&lt;br /&gt;einschließlich der statistischen Geheimhaltung in diesem&lt;br /&gt;Bereich,&lt;br&gt;&lt;br /&gt; c) die Befugnis des Statistischen Landesamtes, im Rahmen&lt;br /&gt;des Statistischen Informationssystems Daten der&lt;br /&gt;Vollzugsverwaltung für statistische Auswertungen zu&lt;br /&gt;verwenden, und die Voraussetzungen, unter denen dem&lt;br /&gt;Statistischen Landesamt Daten der Vollzugsverwaltung für&lt;br /&gt;diesen Zweck zur Verfügung gestellt werden können."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
