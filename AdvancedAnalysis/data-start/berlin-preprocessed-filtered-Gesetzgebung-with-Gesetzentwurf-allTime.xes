			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Integrationspolitik"/>
			<string key="Titel" value="Erstes Gesetz zur Änderung des Partizipationsgesetzes"/>
			<string key="DokNr" value="19/0549"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Die Linke Fraktion Berlin (Die Linke)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/19/DruckSachen/d19-0549.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Mit dem Partizipationsgesetz (PartMigG) will das Land Berlin die Partizipation fördern und die gleichberechtigte Teilhabe von Menschen mit Migrationsgeschichte in allen Lebensbereichen in der durch Vielfalt und Migration geprägten Berliner Stadtgesellschaft sicherstellen. Insbesondere ist die Repräsentanz von Menschen mit Migrationsgeschichte in der Verwaltung von&lt;br /&gt;besonderer Bedeutung und hat eine Vorbildfunktion. Mit dem Abschnitt 3 (§§ 7 ff.) des PartMigG will das Land Berlin die Beschäftigung von Menschen mit Migrationshintergrund im Öffentlichen Dienst gezielt fördern.&lt;br /&gt;Änderung § 8 Abs. 1, Abs. 2 Nr. 4, 5, § 17 Abs. 2 Nr. 1"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
