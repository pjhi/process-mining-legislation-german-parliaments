			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Bezirksverwaltungsgesetz"/>
			<string key="Titel" value="Gesetz zur Stärkung der bezirklichen Demokratie und Selbstverwaltung &lt;br /&gt;(Selbstverwaltungsstärkungsgesetz)"/>
			<string key="DokNr" value="16/2497"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-2497.pdf"/>
			<string key="Sb" value="1-15"/>
			<string key="Abstract" value="Umfassende Reform der bezirklichen Selbstverwaltung anlässlich des Auslaufens der Übergangsregelung zur Bezirksamtsbildung nach § 99 VvB&lt;br&gt;Einführung des politischen Bezirksamtes,&lt;br&gt;Ausweitung der Entscheidungskompetenzen der Bezirksverordnetenversammlung auf alle bezirklichen Angelegenheiten,&lt;br&gt;damit verbunden eine bindende Wirkung für das Bezirksamt bei allen Bürgerentscheiden, sofern sie sich auf die neuen Entscheidungskompetenzen der BVV beziehen,&lt;br&gt;gesetzliche Absicherung der BVV-Fraktionen,&lt;br&gt;strukturelle Stärkung des Beteiligungsgremiums der Bezirke und dessen Umbenennung von Rat der Bürgermeister in Rat der Bezirksbürgerämter,&lt;br&gt;Einschränkung des Eingriffsrechts des Senats im Bau- und Stadtplanungsbereich analog zum geltenden Eingriffsrecht in anderer Bereichen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
