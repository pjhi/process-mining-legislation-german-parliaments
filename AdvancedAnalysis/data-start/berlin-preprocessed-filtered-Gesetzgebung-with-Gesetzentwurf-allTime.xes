			<string key="Titel" value="Gesetz zur Änderung der Verfassung von Berlin&lt;br /&gt;(Wahl des Regierenden Bürgermeisters)"/>
			<string key="DokNr" value="16/2806"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Die Linke Fraktion Berlin (Die Linke)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
