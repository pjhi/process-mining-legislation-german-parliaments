			<string key="Titel" value="Gesetz zur Änderung des Privatschulgesetzes"/>
			<string key="DokNr" value="15/0362"/>
			<string key="Urheber" value="Christlich Demokratische Union Deutschlands (CDU)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-0362.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="In § 7 Abs. 1 Satz 1 wird die bisherige &quot;kann&quot;-Regelung, die 4&lt;br /&gt;dem zuständigen Senatsmitglied eine Ablehnungsmöglichkeit bot&lt;br /&gt;in eine gebundene Entscheidung geändert. In § 7 Abs. 1 wird&lt;br /&gt;Satz 3 hinzugefügt: Die Anerkennung wird auf Antrag&lt;br /&gt;unverzüglich erteilt, wenn der Schulträger bei Antragstellung&lt;br /&gt;bereits mindestens eine ohne wesentliche Beanstandungen&lt;br /&gt;geführte anerkannte Privatschule im Geltungsbereich dieses&lt;br /&gt;Gesetzes betreibt."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
