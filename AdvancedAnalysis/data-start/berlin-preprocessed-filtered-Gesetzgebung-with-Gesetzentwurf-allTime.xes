			<string key="Desk" value="Öffentliche Sicherheit und Ordnung"/>
			<string key="Titel" value="Entwurf eines Dritten Gesetzes zur Änderung des Allgemeinen Sicherheits- und Ordnungsgesetzes"/>
			<string key="DokNr" value="15/3026"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-3026.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der vom Senat beschlossene &quot;Einstellungskorridor&quot; lässt die Übernahme von 300 Beamtinnen und Beamten in ein&lt;br /&gt;Beamtenverhältnis auf Probe zu. Auf der Basis der genannten Übernahmezahlen lässt sich voraussehen, dass ca. 300&lt;br /&gt;Beamtinnen/Beamte arbeitslos werden würden. Deshalb sollen die zur Verfügung stehenden Mittel vorübergehend zur Einstellung von Angestellten genutzt werden. Das ermöglicht ein zeitlich befristetes Angestelltenverhältnis bis 2008&lt;br&gt;Einfügung ASOG § 5 Abs. 2 Satz 3; Aufhebung des bisherigen § 5 Abs. 2"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
