			<string key="Desk" value="Besoldungsrecht"/>
			<string key="Titel" value="Gesetz zur Umsetzung des Professorenbesoldungsreformgesetzes und zur Änderung hochschulrechtlicher Vorschriften"/>
			<string key="DokNr" value="15/3298"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-3298.pdf"/>
			<string key="Sb" value="1-48"/>
			<string key="Abstract" value="Die Bezahlungsstruktur der altersabhängig aufsteigenden Gehälter nach der Bundesbesoldungsordnung C wurde durch eine&lt;br /&gt;Bundesbesoldungsordnung W mit festen Grundgehältern in den Besoldungsgruppen W 1, W 2 und W 3 abgelöst, wobei die&lt;br /&gt;Besoldungsgruppe W 1 ausschließlich sog. Juniorenprofessoren vorbehalten ist.&lt;br /&gt; Mit geändert wurden:&lt;br /&gt; Landesbesoldungsgesetz; Berliner Hochschulgesetz \\nVorabüberweisung an AInnSichO F u. AWissForsch"/>
