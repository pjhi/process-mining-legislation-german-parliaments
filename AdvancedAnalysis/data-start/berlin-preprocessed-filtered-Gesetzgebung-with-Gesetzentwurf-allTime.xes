			<string key="DBID" value="D-6365"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Tierschutz"/>
			<string key="Titel" value="6. Gesetz zur Änderung des Gesetzes über Naturschutz und Landschaftspflege von Berlin (Berliner Naturschutzgesetz - NatSchGBln) &lt;br /&gt;oder unbeaufsichtigte Katzen und das letzte Aufgebot des Reichsnaturschutzgesetzes von 1936"/>
			<string key="DokNr" value="12/4132"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (B90/Gr)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-4132.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="§ 52 legt fest, daß Verordnungen und Anordnungen, die aufgrund des Reichsnaturschutzgesetzes vom 26. Juli 1935 erlassen wurden, bis zu einer anderweitigen Regelung in Kraft bleiben. In Berlin trifft dies zu für den § 16 des Reichsnaturschutzgesetzes: &quot;Maßnahmen gegen unbeaufsichtigte Katzen&quot;. Danach können Grundstückseigentümer unbeaufsichtigte Katzen in der Zeit vom 15. März bis 15. August fangen und an die Ortspolizeibehörde abliefern, &quot;die sie auf Kosten des Eigentümers oder Halters tötet oder sonst unschädlich macht&quot;. Da umherstreunende Katzen jedoch kaum vom Vogelfang leben und damit auch keine Bedrohung für gefährdete Arten darstellen, ist der § 16 in diesem Sinne überflüssig. Er gibt nur Grundstücks-Besitzern und -Pächtern die Möglichkeit, freilaufende Katzen einzufangen, zu quälen und zu töten.&lt;br /&gt; Streichung des § 52;&lt;br /&gt; die bisherigen §§ 53 bis 56 werden zu 52 bis 55."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1994"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="41817"/>
			<date key="DokDat" value="1994-04-12T00:00:00+00:00"/>
			<date key="DokDat_original" value="1994-12-04T00:00:00+00:00"/>
		</event>
