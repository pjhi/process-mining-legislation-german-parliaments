			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Fraktion"/>
			<string key="Titel" value="Fraktionsrechtsstellungsgesetz &lt;br /&gt;(Gesetz über die Rechtsstellung der Fraktionen des Abgeordnetenhauses von Berlin (Fraktionsgesetz - FraktG))"/>
			<string key="DokNr" value="12/1961"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1961.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der Regelungsbedarf ergibt sich aus der bislang offenen&lt;br /&gt;Rechtsnatur der Fraktionen und der hieraus folgenden&lt;br /&gt;Unklarheit über deren Rechtspersönlichkeit. Die Fraktionen&lt;br /&gt;nehmen nach allgemeiner Auffassung und nach ständiger&lt;br /&gt;Parlamentspraxis als verselbständigte Gliederungen des&lt;br /&gt;Parlaments am Rechtsleben teil, ohne daß Inhalt und Umfang&lt;br /&gt;ihrer Rechte und Pflichten im allgemeinen Rechtsverkehr im&lt;br /&gt;einzelnen geklärt sind."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
