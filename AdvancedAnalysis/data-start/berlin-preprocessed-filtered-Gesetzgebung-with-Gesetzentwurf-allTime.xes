			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Staatsvertrag"/>
			<string key="Titel" value="Gesetz zum Staatsvertrag über die Auflösung der Akademie der Künste der ehemaligen Deutschen Demokratischen Republik"/>
			<string key="DokNr" value="12/1766"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1766.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Akademie der Künste der ehemaligen Deutschen Demokratischen Republik ist durch den Einigungsvertrag am 3. Oktober 1990 in die Trägerschaft der neuen Länder und Berlins gekommen; alle sechs Länder haben erklärt, diese Trägerschaft nicht fortführen zu wollen. Sie haben am 13. Dezember 1991 einen Staatsvertrag über die Auflösung dieser Akademie unterzeichnet, der nach der Ratifizierung durch die sechs Länderparlamente in Kraft tritt. \\nVorabüberweisung an AKult"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
