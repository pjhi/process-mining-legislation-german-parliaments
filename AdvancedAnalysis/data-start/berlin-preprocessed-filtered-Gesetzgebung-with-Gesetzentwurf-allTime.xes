			<string key="Desk" value="Wald"/>
			<string key="Titel" value="Gesetz zur Erhaltung und Pflege des Waldes&lt;br /&gt;(Landeswaldgesetz - LWaldG)"/>
			<string key="DokNr" value="15/2440"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-2440.pdf"/>
			<string key="Sb" value="1-45"/>
			<string key="Abstract" value="Veränderte fachliche und rechtliche Rahmenbedingungen der&lt;br /&gt;Waldbewirtschaftung und der Forstpolitik schaffen;&lt;br /&gt;verbesserten Schutz des Waldes und der gesamten Umwelt&lt;br /&gt;sicherstellen.&lt;br /&gt; Mit geändert wurden:&lt;br /&gt; Gesetz über die Umweltverträglichkeitsprüfung;&lt;br /&gt; Grünanlagengesetz; Berliner Informationsfreiheitsgesetz;&lt;br /&gt; Verordnung zum Schutz der Landschaft des Tegeler Forstes&lt;br /&gt; (südlicher Teil) im Bezirk Reinickendorf von Berlin;&lt;br /&gt; Verordnung zum Schutz der Landschaft des Spandauer Forstes&lt;br /&gt;im Bezirk Spandau; Verordnung zum Schutz der Landschaft&lt;br /&gt; der Jungfernheide im Bezirk Reinickendorf von Berlin;&lt;br /&gt; Verordnung über das Naturschutzgebiet Krumme Laake/Pelzlaake&lt;br /&gt; im Bezirk Köpenick von Berlin; Verordung über das&lt;br /&gt; Naturschutzgebiet Wilhelmshagen-Wolterdorf Dünenzug im&lt;br /&gt; Bezirk Köpenick von Berlin; Verordnung zum Schutz der&lt;br /&gt; Landschaft der Müggelspree im Bezirk Köpenick von Berlin;&lt;br /&gt; Verordnung zum Schutz der Landschaft des Pländerwaldes im&lt;br /&gt; Bezirk Treptow von Berlin;"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
