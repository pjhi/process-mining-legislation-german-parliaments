		<string key="VSys" value="nan"/>
		<string key="VSysL" value="nan"/>
		<string key="VorgangsDeskriptoren" value="[&apos;Behindertenhilfe&apos;, &apos;Berlin, östliche Bezirke&apos;, &apos;Bundessozialhilfegesetz&apos;, &apos;Pflegegeld&apos;, &apos;Rechtseinheit&apos;, &apos;Sozialhilfe&apos;]"/>
