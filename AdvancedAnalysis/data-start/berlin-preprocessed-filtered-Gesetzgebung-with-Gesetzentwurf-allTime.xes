		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1991-09-04T02:00:00.000+02:00"/>
			<string key="DBID" value="D-7471"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Wahl (staatlich)"/>
			<string key="Titel" value="Drittes Gesetz zur Änderung des Landeswahlgesetzes und Gesetz zur Änderung des Wahlkampfkostengesetzes"/>
			<string key="DokNr" value="12/0621"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0621.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Anpassung der Vorschriften des Landeswahlgesetzes an die Rechts- und Verfassungslage. Dabei werden die in beiden Teilen Berlins geltenden inhaltsgleichen Gesetze durch ein einheitliches Gesetz für ganz Berlin ersetzt. Auch das Wahlkampfkostengesetz wird, soweit notwendig, geändert. Außerdem wird durch eine zeitlich begrenzte Vorschrift seine Anwendung für die laufende - fünf- statt vierjährige - Wahlperiode den Erfordernissen angepaßt."/>
			<string key="Redner" value="nan"/>
