			<string key="Desk" value="Justizvollzugsdienst"/>
			<string key="Titel" value="Gesetz zu dem Abkommen über die erweiterte Zuständigkeit der mit Aufgaben des Strafvollzugs beauftragten Bediensteten der Länder"/>
			<string key="DokNr" value="12/0996"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0996.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Vollzugsbedienstete der Länder haben bei dem Transport, der Ausführung und dem Arbeitseinsatz von Gefangenen sowie bei&lt;br /&gt;der Nacheile auch Amtshandlungen in anderen Bundesländern vorzunehmen. Der zur Regelung der erweiterten Zuständigkeit abgeschlossene Staatsvertrag aller Bundesländer muß durch entsprechende Ländergesetze ratifiziert werden."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
