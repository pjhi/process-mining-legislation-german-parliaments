			<string key="Desk" value="Erschließungsbeitrag gem. Bundesbaugesetz"/>
			<string key="Titel" value="Erschließungsbeitragsgesetz - EBG  &lt;br /&gt;(Erstes Gesetz zur Änderung des Erschließungsbeitragsgesetzes)"/>
			<string key="DokNr" value="15/4738"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Partei des Demokratischen Sozialismus (Die Linkspartei.PDS)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-4738.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Abs. 1 enthält eine Freistellung vom Erschließungsbeitrag, wenn die Straße bereits vor dem Wirksamwerden des Beitritts zumindest teilweise hergestellt wurde und die Straße bis heute für den Verkehr genutzt wird.&lt;br /&gt;Durch Abs. 2 werden die Straßenbaubehörden angehalten, die Erschließungsanlagen innerhalb von 15 Jahren vollständig herzustellen und din diesem Zeitraum die Erschließungsbeiträge zu erheben. nach Ablauf von 15 Jahren der Benutzung der Straße ist die Erhebung von Erschließungsbeiträgen ausgeschlossen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
