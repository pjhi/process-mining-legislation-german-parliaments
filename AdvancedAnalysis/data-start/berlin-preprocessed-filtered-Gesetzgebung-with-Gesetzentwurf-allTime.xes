			<string key="Titel" value="Gesetz zur Änderung des &quot;Schulgesetzes für Berlin (SchulG)&quot; (II)  &lt;br /&gt;Übernahme von Herkunftssprachen ausländischer Kinder in das Regelangebot der Berliner Schule  &lt;br /&gt;(Vierundzwanzigstes Gesetz zur Änderung des Schulgesetzes für Berlin)"/>
			<string key="DokNr" value="12/3900"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (B90/Gr)"/>
