			<string key="Titel" value="Änderung des Gesetzes über die Errichtung der Landesbank Berlin - Girozentrale - &lt;br /&gt;(Gesetz zur Änderung des Gesetzes über die Errichtung der Landesbank Berlin - Girozentrale -)"/>
			<string key="DokNr" value="13/3954"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3954.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Konzentration im Kreditgewerbe hat inzwischen auch die&lt;br /&gt;Bausparkassen erreicht. Für die Landeshauptsparkasse Berlin&lt;br /&gt;als verhältnismäßig kleine Bausparkasse ist von&lt;br /&gt;entscheidender Bedeutung, ihre Stellung am Markt zu behaupten&lt;br /&gt;bzw. weiter auszubauen. Von der Vereinigung der&lt;br /&gt;Landesbausparkassen in Berlin und Hannover sind Impulse zu&lt;br /&gt;erwarten."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
