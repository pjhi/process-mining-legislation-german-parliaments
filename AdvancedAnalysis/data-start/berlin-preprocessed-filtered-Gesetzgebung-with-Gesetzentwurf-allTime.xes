		<int key="@@case_index" value="68053"/>
		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="2014-01-07T01:00:00.000+01:00"/>
			<string key="DBID" value="D-244096"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Schulgesetz"/>
			<string key="Titel" value="Gesetz zur Änderung des Schulgesetzes und weiterer Gesetze"/>
			<string key="DokNr" value="17/1382"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-1382.pdf"/>
			<string key="Sb" value="1-42"/>
			<string key="Abstract" value="Bei Anmeldungen an Gymnasien und Sekundarschulen werden Geschwisterkinder bevorzugt aufgenommen. Das gilt auch für Kinder, die nicht miteinander verwandt sind, aber in einer Familien aufwachsen. Für Kinder die nach der 6. Klasse einen Durchschnitt von 3,0 oder höher haben wird ein Beratungsgespräch Pflicht, wenn sie sich auf einem Gymnasium anmelden. &lt;br /&gt;Eltern die ihre Kinder nicht mit 4 Jahren zu Sprachtests schicken oder von der Sprachförderung verbleiben, müssen ein Bußgeld zahlen. Wer auf dem Gymnasium ein Auslandsjahr macht, dem wird die Prüfung für den Mittleren Schulabschluss erlassen. Danach ein halbes Jahr Probezeit und dann einen vergleichbaren MSA.&lt;br&gt;Artikelgesetz:&lt;br&gt;Artikel I: Änderung des Schulgesetzes&lt;br&gt;Artikel II: Gesetz über die Umwandlung der Nelson-Mandela-Schule in eine zentral verwaltete Schule&lt;br&gt;Artikel III: Änderung des Allgemeinen Zuständigkeitsgesetzes"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
