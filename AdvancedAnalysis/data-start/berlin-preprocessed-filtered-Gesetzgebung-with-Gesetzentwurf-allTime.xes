			<string key="DokNr" value="15/2757"/>
			<string key="Urheber" value="Freie Demokratische Partei (FDP)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-2757.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Studienkonten stellen ein geeignetes Instrument der&lt;br /&gt;Hochschulfinanzierung dar, da sie eine sehr detaillierte&lt;br /&gt;Erfassung der nachgefragten Hochschulleistungen ermöglichen.&lt;br /&gt;Das Studienkonto wird für jeden immatrikulierten Studenten im&lt;br /&gt;Erststudium angelegt und mit der zum Erreichen des&lt;br /&gt;Studienziels notwendigen Anzahl an Kreditpunkten zzgl. Bonus&lt;br /&gt;ausgestattet."/>
