			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Qualifikationsnachweis"/>
			<string key="Titel" value="Gesetz zur Änderung des Berufsqualifikationsfeststellungsgesetzes Berlin sowie weiterer Gesetze"/>
			<string key="DokNr" value="17/2791"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-2791.pdf"/>
			<string key="Sb" value="1-196"/>
			<string key="Abstract" value="Durch das Gesetz wird die Möglichkeit zur Prüfung und - bei Gleichwertigkeit - Anerkennung der im Ausland erworbenen Berufsqualifikation gleich in mehrfacher Hinsicht erweitert, so sind seither Berufsqualifikationen aus allen Staaten zu prüfen, es existiert also keine Beschränkung mehr auf EU-/EWR-Staaten und die Schweiz; Die Staatsangehörigkeit spielt für das Recht auf Antragstellung keine Rolle mehr und die Prüfung und Anerkennung erstreckt sich nicht mehr nur auf reglementierte, sondern nunmehr auch auf nicht reglementierte Berufe; Erweiterung des Anerkennungsgesetzes mit den Zielsetzungen: Verringerung des Fachkräftemangels auf dem deutschen Arbeitsmarkt; Etablierung einer Willkommenskultur; Integration von Migrantinnen und Migranten sowie Entlastung der Sozialsysteme.&lt;br&gt;&lt;br /&gt;Artikelgesetz:&lt;br&gt;Artikel I: Änderung des Berufsqualifikationsfeststellungsgesetzes Berlin&lt;br&gt;Artikel II: Änderung des EG-Richtlinienumsetzungsgesetzes für Lehrkräfte&lt;br&gt;Artikel III: Änderung des Lehrkräftebildungsgesetzes&lt;br"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
