			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Teilhabe behinderter Menschen"/>
			<string key="Titel" value="Gesetz zur Neufassung des  Gesetzes über Selbstbestimmung und Teilhabe in betreuten gemeinschaftlichen Wohnformen"/>
			<string key="DokNr" value="18/3420"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-3420.pdf"/>
			<string key="Sb" value="1-284"/>
			<string key="Abstract" value="Die Neufassung beinhaltet, den Schutz  der unterstützungsbedürftigen Menschen  vor Missbrauch, Ausbeutung, Gewalt, Diskriminierung und unnötigen Freiheitsbeschränkungen in allen Wohnformen; Mitwirkungsrechte werden gestärkt; Transparenzpflichten  der  Leitungsanbieter in Bezug auf ihre Leistungsangebote; Verbesserung der Handlungsmöglichkeiten der zuständigen Aufsichtsbehörde zur Überprüfung der Leistungsanbieter.&lt;br&gt;Artikelgesetz:&lt;br&gt;Artikel 1: Gesetz über Selbstbestimmung und Teilhabe in betreuten gemeinschaftlichen Wohnformen (Wohnteilhabegesetz -WTG)&lt;br&gt;Artikel 2: Änderung des Wohnteilhabegesetzes&lt;br&gt;Artikel 3: Änderung des Nichtraucherschutzgesetzes&lt;br&gt;Artikel 4: Änderung der Verordnung über das förmliche Verwaltungsverfahren&lt;br&gt;Artikel 5: Weitere Änderung der Verordnung über das förmliche Verwaltungsverfahren"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
