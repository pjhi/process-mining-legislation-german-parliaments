			<string key="Desk" value="Rundfunk"/>
			<string key="Titel" value="Gesetz zu dem Ersten Staatsvertrag zur Änderung des Staatsvertrages über die Zusammenarbeit zwischen Berlin und Brandenburg im Bereich des Rundfunks"/>
			<string key="DokNr" value="13/3228"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3228.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Verabschiedung des vorliegenden Zustimmungsgesetzes ist&lt;br /&gt;erforderlich, um den Regierungschefs der Länder Berlin und&lt;br /&gt;Brandenburg vereinbarten Staatsvertrag in das Berliner&lt;br /&gt;Landesrecht zu transformieren. Damit ist zugleich die&lt;br /&gt;erforderliche Ermächtigung an den Senat verbunden, den&lt;br /&gt;Staatsvertrag durch Hinterlegung der Urkunde bei der&lt;br /&gt;Staatskanzlei von Brandenburg zu ratifizieren und ihn damit&lt;br /&gt;wirksam werden zu lassen. \\nVorabüberweisung an ABundEuroBlnBraMed"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
