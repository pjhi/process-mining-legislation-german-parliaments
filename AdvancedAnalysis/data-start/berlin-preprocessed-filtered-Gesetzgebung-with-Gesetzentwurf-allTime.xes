			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Straßen- und Wegerecht"/>
			<string key="Titel" value="Berliner Straßengesetz (BerlStrG)"/>
			<string key="DokNr" value="13/3641"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3641.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das am 28. Februar 1985 in Kraft getretene und derzeit noch&lt;br /&gt;geltende Berliner Straßengesetz ist nach der Vereinigung&lt;br /&gt;Deutschlands und der beiden Stadthälften Berlins erheblich&lt;br /&gt;erneuerungsgedürftig geworden. Neben der Anpassung an die&lt;br /&gt;veränderten Umstände sowie unter Berücksichtigung der Reform&lt;br /&gt;des neu gefassten Bundesfernstraßengesetzes (FStrG) sind die&lt;br /&gt;Änderungen und Ergänzungen des Berliner Straßengesetzes aus&lt;br /&gt;drei Gründen notwendig geworden:&lt;br /&gt; - Erfordernis der allgemeinen Anpassung an die&lt;br /&gt;   Straßengesetze der anderen Bundesländer;&lt;br /&gt; - Fehlen von Regelungen über die Fachplanung von Straßen im&lt;br /&gt;   Berliner Straßengesetz;&lt;br /&gt; - Anpassung der Regelungen über den Gebrauch der&lt;br /&gt;   öffentlichen Straßen an die Privatisierung von&lt;br /&gt;   öffentlichen Aufgaben (Versorungsunternehmen, Parkhäuser&lt;br /&gt;   usw.).&lt;br /&gt;"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
