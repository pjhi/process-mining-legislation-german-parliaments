			<string key="DBID" value="D-4468"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Justizverwaltung"/>
			<string key="Titel" value="Gesetz zur Änderung von Justizkostengesetzen"/>
			<string key="DokNr" value="12/1160"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1160.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Vorschriften über die Kosten in Hinterlegungssachen in&lt;br /&gt;§§ 24 bis 26 der Hinterlegungsordnung werden durch Artikel&lt;br /&gt;2 des Gesetzes zur Änderung der Bundesgebührenordnung für&lt;br /&gt;Rechtsanwälte vom 20. August 1990 mit Wirkung zum 1. Juli&lt;br /&gt;1992 aufgehoben und sind deshalb für Berlin durch eine&lt;br /&gt;Neuregelung im Berliner Gesetz über Kosten im Bereich der&lt;br /&gt;Justizverwaltung zu ersetzen. Darüber hinaus besteht&lt;br /&gt;Anlaß, landesrechtliche Justizverwaltungsgebühren&lt;br /&gt;anzupassen und kostenrechtliche Vorschriften zu&lt;br /&gt;bereinigen. Aus Gründen der Rechtseinheit und der&lt;br /&gt;Arbeitsvereinfachung sollen die Vorschriften für die&lt;br /&gt;Stundung und den Erlaß von Justizkosten sowie für&lt;br /&gt;sonstige Ansprüche auf alle bei der Senatsverwaltung für&lt;br /&gt;Justiz angesiedelten Gerichtsbehörden ausgedehnt werden."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="59694"/>
