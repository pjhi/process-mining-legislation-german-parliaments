			<string key="Desk" value="Rundfunk"/>
			<string key="Titel" value="Gesetz zum Neunzehnten Rundfunkänderungsstaatsvertrag"/>
			<string key="DokNr" value="17/2743"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-2743.pdf"/>
			<string key="Sb" value="1-80"/>
			<string key="Abstract" value="Der Aufwand des Beitragseinzuges beim zentralen Beitragsservice (ehemals GEZ) und in den Landesrundfunkanstalten wird planmäßig bis Ende 2016 um insgesamt 20% reduziert. Reduzierung des Personals beim zentralen Beitragsservice von 1224 Mitarbeitern und Mitarbeiterinnen (2012) auf deutlich unter Tausend im Jahre 2017. Abbau des sog. Beauftragtendienstes der Landesrundfunkanstalten bis zum Jahr 2016."/>
