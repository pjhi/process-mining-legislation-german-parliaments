			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Wahl (staatlich)"/>
			<string key="Titel" value="Viertes Gesetz zur Änderung des Landeswahlgesetzes"/>
			<string key="DokNr" value="12/4130"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-4130.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Durch die Herabsetzung der künftigen Mindestzahl der Mandate&lt;br /&gt;im Abgeordnetenhaus von Berlin von 200 auf 150, ist es&lt;br /&gt;erforderlich, Anzahl und Größe der Wahlkreise sowie die&lt;br /&gt;Regelung über die erforderlichen&lt;br /&gt;Unterstützungsunterschriften für Wahlvorschläge zu ändern.&lt;br /&gt; Einige Vorschriften des Landeswahlgesetzes werden sprach-&lt;br /&gt; lich und systematisch überarbeitet.&lt;br /&gt; In einer Übergangsvorschrift (§ 35) wird die&lt;br /&gt; Rechtsstellung der Parteien geregelt, die sich an der&lt;br /&gt; ersten Gesamtberliner Wahl im Rahmen einer Listenverein-&lt;br /&gt; barung beteiligt und Mandate errungen haben."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1994"/>
			<string key="NrInTyp" value="12/0"/>
