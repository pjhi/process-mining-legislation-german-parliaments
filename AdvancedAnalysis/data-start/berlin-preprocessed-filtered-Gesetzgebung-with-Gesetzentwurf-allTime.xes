			<string key="DokNr" value="12/3794"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-3794.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Gesetz setzt das mit den bisherigen vier Aufhebungsgesetzen begonnene Bestreben fort, durch die&lt;br /&gt;Aufhebung nicht mehr benötigter Rechtsvorschriften für eine größere Rechtsklarheit und Rechtssicherheit zu sorgen. Es setzt die Ergebnisse der vom Senat zur Begrenzung der Normenflut beschlossenen ständigen repressiven Normenprüfung um."/>
