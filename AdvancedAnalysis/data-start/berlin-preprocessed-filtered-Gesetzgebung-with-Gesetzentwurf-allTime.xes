			<string key="Desk" value="Landesbank Berlin - Girozentrale -"/>
			<string key="Titel" value="Gesetz zum Staatsvertrages zwischen dem Land Berlin und dem Land Niedersachsen zur Änderung des Staatsvertrages über die LBS Norddeutsche Landesbausparkasse Berlin - Hannover"/>
			<string key="DokNr" value="15/1569"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-1569.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Länder Berlin und Niedersachsen betreiben die LBS&lt;br /&gt;Norddeutsche Landesbausparkasse Berlin - Hannover als&lt;br /&gt;gemeinsame Anstalt des öffentlichen Rechts. In dem&lt;br /&gt;Staatsvertrag vom 22./28. Mai 2002 haben sie gemäß der&lt;br /&gt;Entscheidung der Europäischen Kommission vom 27. März 2002&lt;br /&gt;neu geordnet. Sie sind übereingekommen, die von den&lt;br /&gt;geänderten Haftungsgrundlagen unberührt gebliebenen&lt;br /&gt;Regelungen über die Gewährträgerhaftung abzuschaffen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
