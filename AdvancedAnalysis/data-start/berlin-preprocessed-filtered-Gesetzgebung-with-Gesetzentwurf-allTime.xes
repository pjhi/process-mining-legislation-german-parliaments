			<string key="Desk" value="Wahlrecht"/>
			<string key="Titel" value="Inklusives Wahlrecht in Berlin: Diskriminierung von Menschen mit Behinderung beenden &lt;br /&gt;(Elftes Gesetz zur Änderung des Landeswahlgesetzes)"/>
			<string key="DokNr" value="18/1515"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Die Linke Fraktion Berlin (Die Linke)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-1515.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Vom Wahlrecht ausgeschlossen wird ausschließlich, wer infolge eines Gerichtsentscheids das Wahlrecht nicht besitzt. &lt;br&gt;Menschen, denen zur Besorgung aller Angelegenheiten dauerhaft ein Betreuer bestellt ist oder die sich nach § 63 in Verbindung mit § 20 des Strafgesetzbuchs in einem psychiatrischen Krankenhaus befinden, werden nicht mehr vom Wahlrecht ausgeschlossen.&lt;br&gt;Neufassung § 2"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
