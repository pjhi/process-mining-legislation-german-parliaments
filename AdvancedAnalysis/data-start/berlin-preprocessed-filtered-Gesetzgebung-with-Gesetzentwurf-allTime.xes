			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Lotterie"/>
			<string key="Titel" value="Gesetz über die Neufassung des Gesetzes über die Deutsche Klassenlotterie Berlin und die Stiftung Deutsche Klassenlotterie Berlin (DKLB-Gesetz)"/>
			<string key="DokNr" value="12/0668"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0668.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Wurde als Drittes Gesetz zur Änderung des Gesetzes über&lt;br /&gt;die Deutsche Klassenlotterie Berlin und die Stiftung&lt;br /&gt;Deutsche Klassenlotterie Berlin (DKLB-Gesetz)&lt;br /&gt;veröffentlicht. &lt;br /&gt; Die Deutsche Klassenlotterie Berlin betreibt als Mitglied&lt;br /&gt;des Deutschen Lotto- und Toto-Blocks das Lotteriegeschäft&lt;br /&gt;in Berlin. Sie führt eine Zweckabgabe an die Stiftung&lt;br /&gt;Deutsche Klassenlotterie Berlin (DKLB-Stiftung) ab. Diese&lt;br /&gt;fördert gemeinnützige Zwecke durch die Vergabe von&lt;br /&gt;Zuwendungen. Hierüber entscheidet der Stiftungsrat der&lt;br /&gt;DKLB-Stiftung. Seine Entscheidungen sind verwaltungsmäßig&lt;br /&gt;umzusetzen. Die bisherige Durchführung dieser Aufgabe&lt;br /&gt;durch Vorstand und Personal der DKLB hat sich nicht als&lt;br /&gt;optimal herausgestellt, so daß die DKLB-Stiftung mit&lt;br /&gt;eigener Leitung, eigenem Personal und eigenen Sachmitteln&lt;br /&gt;ausgestattet wird. \\nVorabüberweisung an ARecht u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="51911"/>
			<date key="DokDat" value="1991-09-25T00:00:00+00:00"/>
			<date key="DokDat_original" value="1991-09-25T00:00:00+00:00"/>
		</event>
