			<string key="Desk" value="Datenschutz"/>
			<string key="Titel" value="Gesetz zur Änderung des Berliner Datenschutzgesetzes &lt;br /&gt;(Gesetz zur Änderung des Berliner Datenschutzgesetzes und des Gesetzes zu dem Staatsvertrag über den Rundfunk im vereinten Deutschland vom 31. August 1991 und zu Artikel 36 des Einigungsvertrages)"/>
			<string key="DokNr" value="12/4028"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-4028.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Verarbeitung personenbezogener Daten ist außer im Fall&lt;br /&gt;der Einwilligung des Betroffenen nur zulässig, wenn eine&lt;br /&gt;besondere Rechtsvorschrift dies erlaubt. Im Gegensatz zu&lt;br /&gt;fast allen anderen Bundesländern normiert das Berliner&lt;br /&gt;Datenschutzgesetz außer dem Einwilligungstatbestand keine&lt;br /&gt;Zulässigkeitsvoraussetzungen für die Datenverarbeitung, so&lt;br /&gt;daß in Berlin für jede Datenverarbeitung ein&lt;br /&gt;spezialgesetzlicher Erlaubnistatbestand benötigt wird."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1994"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
