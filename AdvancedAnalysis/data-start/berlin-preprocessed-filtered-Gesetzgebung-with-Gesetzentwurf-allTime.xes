			<string key="Titel" value="Gesetz zur Regelung des Sektionswesens und therapeutischer Gewebeentnahmen  &lt;br /&gt;(Sektionsgesetz)"/>
			<string key="DokNr" value="13/0348"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d0348.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Gesetz schließt aus, daß klinische Sektionen ohne &lt;br /&gt;Zustimmung des Patienten, ohne vorausgehende &lt;br /&gt;Leichenschau, in Einrichtungen ohne ordnungsbehördlicher &lt;br /&gt;Genehmigung durchgeführt werden. Anatomische Sektionen &lt;br /&gt;dürfen zum Zwecke der Lehre und Forschung vorgenommen &lt;br /&gt;werden."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
