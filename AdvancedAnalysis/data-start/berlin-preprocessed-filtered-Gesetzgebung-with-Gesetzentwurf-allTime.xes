			<string key="Titel" value="Viertes Gesetz zur Änderung des Kita- und Tagespflegekostenbeteiligungsgesetzes (KTKBG)"/>
			<string key="DokNr" value="12/2717"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-2717.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Mit dieser Novellierung des Kita- und Tagespflegekostenbeteiligungsgesetzes (KTKBG) werden überproportionale Belastungen von Mehrkinderfamilien und Familien mit mittlerem Einkommen überwunden, indem die Mehrkinderermäßigung auch für nicht-betreute Geschwister eingeführt und die Staffelung der Elternbeiträge über mehr Einkommensgruppen gestreckt wird. \\nVorabüberweisung an AJugFam u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1993"/>
			<string key="NrInTyp" value="12/0"/>
