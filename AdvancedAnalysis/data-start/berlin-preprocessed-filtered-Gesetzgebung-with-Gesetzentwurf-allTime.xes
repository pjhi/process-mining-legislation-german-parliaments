			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Schulaufsicht"/>
			<string key="Titel" value="Gesetz über die Neuorganisation der Schulaufsicht und die Errichtung eines Landesschulamtes in Berlin"/>
			<string key="DokNr" value="12/4910"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-4910.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Notwendige Reformen in der Schulverwaltung sind u. a.:&lt;br&gt;&lt;br /&gt; 1) Zusammenwachsen des Schulwesens innerhalb der Stadt;&lt;br&gt;&lt;br /&gt; 2) Flexibles Einsetzen der Lehrkräfte im gesamten Stadgebiet;&lt;br&gt;&lt;br /&gt; 3) Schaffung kompatibler Strukturen als Vorbereitung der  Vereinigung Berlin/Brandenburg;&lt;br&gt;&lt;br /&gt; 4) Eigenverantwortung der Schulen stärken und &lt;br&gt;&lt;br /&gt; 5) durch die neuen Strukturen Einsparungen ermöglichen. \\nVorabüberweisung an ASchul u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1994"/>
			<string key="NrInTyp" value="12/0"/>
