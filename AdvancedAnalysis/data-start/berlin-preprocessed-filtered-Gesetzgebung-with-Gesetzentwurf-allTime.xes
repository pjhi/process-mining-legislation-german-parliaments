			<string key="Titel" value="Gesetz zur Änderung des Gesetzes zur Ausführung des Gesetzes für Jugendwohlfahrt und zur Regelung der öffentlichen &lt;br /&gt;Jugend- und Familienhilfe"/>
			<string key="DokNr" value="11/1106"/>
			<string key="Urheber" value="nan"/>
