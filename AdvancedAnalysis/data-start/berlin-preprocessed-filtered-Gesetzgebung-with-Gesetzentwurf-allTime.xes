			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="2014-01-21T01:00:00.000+01:00"/>
			<string key="DBID" value="D-244474"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Beamtenrecht"/>
			<string key="Titel" value="Für eine neue politische Kultur (II): Karenzzeit für Senator/-innen und Staatssekretär/-innen &lt;br /&gt;(Gesetz zur Änderung des Gesetzes über die Rechtsverhältnisse der Mitglieder des Senats (Senatorengesetz - SenG) und des Landesbeamtengesetzes (LBG))"/>
			<string key="DokNr" value="17/1412"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (Grüne)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-1412.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Durch die Änderung des Senatorengesetzes werden SenatorInnen verpflichtet, innerhalb eines Zeitraums von zwei Jahren nach ihrem Ausscheiden aus dem Amt die Aufnahme einer beruflichen Tätigkeit beim Senat anzuzeigen. Der Senat hat dann die Pflicht, innerhalb von acht Wochen unter Beachtung des Grundrechts auf Berufsfreiheit zu prüfen, ob die Tätigkeit öffentliche Interessen beeinträchtigt. Die Tätigkeit kann dann für maximal zwei Jahre untersagt werden, der Zeitraum folgt dabei der gesetzlichen Befristung für die Zahlung von Übergangsgeldern.&lt;br&gt;&lt;br /&gt;Für StaatssekretärInnen ergibt sich eine solche Anzeigepflicht schon heute aus § 68 Landesbeamtengesetz. &lt;br&gt;Artikelgesetz&lt;br&gt;Artikel I: Senatorengesetz&lt;br&gt;Artikel II: Landesbeamtengesetz"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="167527"/>
			<date key="DokDat" value="2014-01-21T00:00:00+00:00"/>
