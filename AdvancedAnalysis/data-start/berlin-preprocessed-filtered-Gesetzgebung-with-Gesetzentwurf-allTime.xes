		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1998-08-06T02:00:00.000+02:00"/>
			<string key="DBID" value="D-21358"/>
			<int key="ReihNr" value="0001"/>
