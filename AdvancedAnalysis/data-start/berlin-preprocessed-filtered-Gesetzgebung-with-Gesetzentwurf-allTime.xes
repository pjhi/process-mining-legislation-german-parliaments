			<date key="time:timestamp" value="1992-08-26T02:00:00.000+02:00"/>
			<string key="DBID" value="D-4917"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Umweltverträglichkeitsprüfung"/>
			<string key="Titel" value="Erstes Gesetz zur Änderung des Berliner Gesetzes über die Umweltverträglichkeitsprüfung (UVPG-Bln)"/>
			<string key="DokNr" value="12/1831"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (B90/Gr)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1831.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Eine Experten-Anhörung im Umweltausschuß und die daran&lt;br /&gt;anschließende Beratung durch die Fach-Abgeordneten am 20.&lt;br /&gt;Februar 1992 hat ergeben, daß der Gesetzgeber mit diesem&lt;br /&gt;Regelwerk nur das absolute Minimum der Pflichten erfüllt,&lt;br /&gt;die ihm die Europäische Gemeinschaft und der&lt;br /&gt;Bundesgesetzgeber für Umweltverträglichkeitsprüfungen&lt;br /&gt;auferlegt haben. Das beschlossene Gesetz bleibt vielmehr&lt;br /&gt;um Längen hinter den Möglichkeiten zurück, die dem&lt;br /&gt;Gesetzgeber zur Gestaltung von&lt;br /&gt;Umweltverträglichkeitsprüfungen auf Landesebene&lt;br /&gt;gegeben sind. Gerade in Berlin, wo weitreichende&lt;br /&gt;Entscheidungen zur Umgestaltung der Stadt bevorstehen, ist&lt;br /&gt;es sehr wichtig, hier anspruchsvolle und &quot;wetterfeste&quot;&lt;br /&gt;Regelungen einzuführen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="26032"/>
			<date key="DokDat" value="1992-08-26T00:00:00+00:00"/>
			<date key="DokDat_original" value="1992-08-26T00:00:00+00:00"/>
		</event>
