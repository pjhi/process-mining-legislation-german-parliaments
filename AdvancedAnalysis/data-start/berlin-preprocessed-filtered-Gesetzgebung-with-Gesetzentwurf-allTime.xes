			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Anstalt des öffentlichen Rechts"/>
			<string key="Titel" value="Gesetz über die Errichtung der Anstalt öffentlichen Rechts Berliner Sport- und Bäder-Betriebe &lt;br /&gt;(Berliner Sport- und Bäder-Betriebegesetz - BSBG)"/>
			<string key="DokNr" value="13/3796"/>
			<string key="Urheber" value="Sozialdemokratische Partei Deutschlands (SPD)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3796.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Berliner Sport- und Bäder-Betriebe müssen die wohnortnahe Versorgung mit Einrichtungen zur sportlichen Betätigung,&lt;br /&gt;Erholung und Entspannung für die Angehörigen aller Bevölkerungsgruppen gewährleisten; Änderung Art. I Aufgrund der Eingliederung der zentralen Sportanlagen in die Anstalt war die diesbezügliche Regelung des 2. Verwaltungsreformgesetzes entsprechend anzupassen, und erhält folgende Fassung: Olympia-Stadion, Max-Schmelling-Halle, Velodrom;&lt;br /&gt; Änderung Art. II \\nVorabüberweisung an AJugFamSchulSport u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
