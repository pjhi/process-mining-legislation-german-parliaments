			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/11/DruckSachen/d11-1112.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der vorliegende Entwurf ist zunächst als Übergangsregelung&lt;br /&gt;gedacht. Es ist nicht vorgesehen, die im beigetretenen&lt;br /&gt;Teil Berlins anfallenden Aufgaben der Rechtsprechung&lt;br /&gt;endgültig auf die in Berlin (West) gelegenen Amtsgerichte&lt;br /&gt;zu übertragen. Sobald die personellen und sächlichen&lt;br /&gt;Mittel es zulassen, werden in den Gebäuden der&lt;br /&gt;Stadtbezirksgerichte zunächst Außenstellen der&lt;br /&gt;Amtsgerichte eingerichtet, die alsbald in fünf&lt;br /&gt;selbständige Amtsgerichte überzuleiten sind."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1990"/>
			<string key="NrInTyp" value="11/0"/>
			<string key="VkDat" value="nan"/>
