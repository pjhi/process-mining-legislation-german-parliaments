			<string key="Desk" value="Justizverwaltung"/>
			<string key="Titel" value="Zweites Gesetz zur Änderung des Gesetzes über Kosten im Bereich der Justizverwaltung &lt;br /&gt; (Jusitzverwaltungskostengesetz (JVKostG))"/>
			<string key="DokNr" value="13/2944"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d2944.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Durch die vorgesehenen Verwaltungsgebühren sollen die &lt;br /&gt;Kosten annähernd gedeckt werden, die durch &lt;br /&gt;Amtshandlungen im Interesse antragstellender &lt;br /&gt;Rechtsanwälte und Notare entstehen. Durch die &lt;br /&gt;Einführung einer pauschalierten Gebühr für die &lt;br /&gt;Erteilung von Ausfertigungen und Abschriften von &lt;br /&gt;gerichtlichen Entscheidungen soll der Verwaltungsaufwand &lt;br /&gt;der Gerichtsbehörden abgegolten werden."/>
