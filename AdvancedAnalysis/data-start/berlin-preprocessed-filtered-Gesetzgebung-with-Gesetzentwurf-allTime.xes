			<string key="Desk" value="Rundfunk"/>
			<string key="Titel" value="Gesetz zum Staatsvertrag über den Schutz der Menschenwürde und den Jugendschutz in Rundfunk und Telemedien &lt;br /&gt;(Jugendmedienschutz-Staatsvertrag - JMStV)"/>
			<string key="DokNr" value="15/0845"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-0845.pdf"/>
			<string key="Sb" value="1-27"/>
			<string key="Abstract" value="Die Regierungschefs der Länder und der Bund haben sich darauf verständigt, den Jugendschutz im elektronischen Medienbereich&lt;br /&gt;und den Jugendschutz bei den Offline-Medien sowie außerhalb des Medienbereichs kompetenzabgrenzend und abgestimmt neu zu regeln. Damit soll das bisher geltende materielle Jugendschutzrecht im Medienbereich überschaubarer und effektiver gestaltet werden.&lt;br /&gt; Mit geändert wurde:&lt;br /&gt; Mediendienste-Staatsvertrag, Staatsvertrag über die  Zusammenarbeit zwischen Berlin und Brandenburg im Bereich des Rundfunks"/>
			<string key="Redner" value="nan"/>
