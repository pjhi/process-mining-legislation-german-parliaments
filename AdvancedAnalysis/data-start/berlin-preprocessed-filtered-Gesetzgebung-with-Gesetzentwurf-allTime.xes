			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Durch den Nachtrag werden die erforderlichen Maßnahmen in&lt;br /&gt;Zusammenhang mit der deutschlandpolitischen Entwicklung,&lt;br /&gt;für die der Bund die Bundeshilfe erhöht hat,&lt;br /&gt;haushaltsmäßig umgesetzt. Diese umfassen die&lt;br /&gt;Wiederherstellung von Verkehrsverbindungen ebenso wie eine&lt;br /&gt;soziale Betreuung und Unterbringung der Übersiedler, als&lt;br /&gt;auch die Nutzung kultureller Einrichtungen. \\nVorabüberweisung an AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1990"/>
