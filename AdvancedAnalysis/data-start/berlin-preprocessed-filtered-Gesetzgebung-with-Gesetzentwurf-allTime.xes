		<string key="VorgangsDeskriptoren" value="[&apos;Akten&apos;, &apos;Qualifikationsnachweis&apos;, &apos;Datenschutz&apos;, &apos;Kammer (Körperschaft)&apos;, &apos;Personenbezogene Daten&apos;]"/>
