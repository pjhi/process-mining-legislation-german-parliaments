			<string key="DokNr" value="17/2714"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/17/DruckSachen/d17-2714.pdf"/>
			<string key="Sb" value="1-34"/>
			<string key="Abstract" value="Erlöschen sämtlicher Spielhallenerlaubnisse zum Stichtag 31.07.2016; &lt;br&gt;&lt;br /&gt;zum Weiterbetrieb bestehender Casinos ist die Beantragung neuer Konzessionen erforderlich;&lt;br&gt;&lt;br /&gt;Regelung zur Behandlung konkurrierender Spielhallen;&lt;br&gt;&lt;br /&gt;Änderung der Abstandsvorschriften: Abstand zwischen zwei Spielhallen mindestens 500 Meter; Entfernung zu Oberschulen mindestens 200 Meter;&lt;br&gt;&lt;br /&gt;Erhöhung des Bußgeldes für Betreiber illegaler Spielbetriebe von 50.000 auf 500.000 Euro;&lt;br&gt;&lt;br /&gt;Einführung einer landesweiten Sperrdatei zur Bekämpfung der Glücksspielsucht&lt;br /&gt;&lt;br&gt;Artikelgesetz:&lt;br&gt;Artikel I: Gesetz zur Umsetzung des Mindestabstands nach dem Spielhallengesetz Berlin für Bestandsunternehmen (Mindestabstandsumsetzungsgesetz Berlin - MindAbstUmsG Bln)&lt;br&gt;Artikel II: Änderung des Spielhallengesetzes Berlin&lt;br&gt;Artikel III: Änderung des Ausführungsgesetzes zum Glücksspielstaatsvertrag"/>
