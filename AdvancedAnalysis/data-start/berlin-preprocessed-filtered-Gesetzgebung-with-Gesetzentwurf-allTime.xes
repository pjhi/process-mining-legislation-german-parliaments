			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Ethikkommission"/>
			<string key="Titel" value="Erstes Gesetz zur Änderung des Gesetzes zur Errichtung einer Ethik-Kommission des Landes Berlin"/>
			<string key="DokNr" value="16/2907"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-2907.pdf"/>
			<string key="Sb" value="1-51"/>
			<string key="Abstract" value="Mit der Errichtung einer staatlichen Ethik-Kommission durch besonderes Landesgesetz wurde die Zuständigkeit einer Ethik-Kommission für die erforderliche zustimmende Bewertung nach den §§ 40 bis 42 AMG im Land Berlin festgelegt. Außerdem wird die rechtliche Vorgabe des Arzneimittelgesetzes umgesetzt. Nach 4-jähriger Erfahrung in der Arbeit der Ethik-Kommission ist es erforderlich, das Gesetz an die praktischen Erfordernisse anzupassen und aufgetretene Rechtsunklarheiten zu beseitigen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
