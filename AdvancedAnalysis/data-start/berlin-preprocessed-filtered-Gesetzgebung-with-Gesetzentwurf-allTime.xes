			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Wasserwirtschaft"/>
			<string key="Titel" value="Berliner Gesetz zur Ausführung des Wasserverbandsgesetzes &lt;br /&gt;(BlnAGWVG)"/>
			<string key="DokNr" value="13/2871"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d2871.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Wasserverbandsgesetz (WVG) vom 12.2.1991 (BGBl. I &lt;br /&gt;S. 405) hat die früheren Rechtsgrundlagen aus dem &lt;br /&gt;Jahre 1937 abgelöst. Für landesrechtliche Ergänzungen &lt;br /&gt;oder Abweichungen ist insoweit Raum, wie &lt;br /&gt;bundesrechtlich vorgesehen oder zugelassen ist. Das &lt;br /&gt;Wasserverbandswesen ist in Berlin von untergeordneter &lt;br /&gt;Bedeutung, da die wasserwirtschaftlichen Aufgaben durch &lt;br /&gt;das Land Berlin oder durch die Berliner &lt;br /&gt;Wasserbetriebe wahrgenommen werden.&lt;br /&gt; Mit Inkrafttreten dieses Gesetzes treten außer Kraft:&lt;br /&gt; Wasserverbandgesetz; Erste Wasserverbandverordnung;&lt;br /&gt; Nummer 5 und 6 des Abschnitts IX des Gesetzes über die&lt;br /&gt; Vereinheitlichung des Berliner Landesrechts"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
