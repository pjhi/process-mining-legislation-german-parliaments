			<string key="Desk" value="Wahl (staatlich)"/>
			<string key="Titel" value="Änderung des Gesetzes über die Wahlen zum Abgeordnetenhaus und zu den Bezirksverordnetenversammlungen (Landeswahlgesetz)"/>
			<string key="DokNr" value="15/4069"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Partei des Demokratischen Sozialismus (PDS)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-4069.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Voraussetzung für das aktive Wahlrecht bei Wahlen zur&lt;br /&gt;Bezirksverordnetenversammlung ist künftig die Vollendung des&lt;br /&gt;16. Lebensjahres am Tag der Wahl. Bei Wahlen zum&lt;br /&gt;Abgeordnetenhaus bleibt es bei der Altersgrenze 18.&lt;br /&gt;Voraussetzung für das passive Wahlrecht bleibt bei beiden&lt;br /&gt;Wahlen die Vollendung des 18. Lebensjahres."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
