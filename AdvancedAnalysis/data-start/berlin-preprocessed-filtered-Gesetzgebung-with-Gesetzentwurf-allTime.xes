			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Richtergesetz"/>
			<string key="Titel" value="Sechstes Gesetz zur Änderung des Berliner Richtergesetzes"/>
			<string key="DokNr" value="13/3628"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3628.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Das Berliner Richtergesetz sieht einen Richterrat für jedes&lt;br /&gt;Gericht, einen Gesamtrichterrat für jeden Gerichtszweig mit&lt;br /&gt;Ausnahme der Finanzgerichtsbarkeit sowie einen&lt;br /&gt;Hauptrichterrat für alle Gerichtszweige vor. Allerdings soll&lt;br /&gt;eine effektivere Arbeit der Richtervertretungen dadurch&lt;br /&gt;erreicht werden, dass im Gesamtrichterrat Mitglieder der&lt;br /&gt;nächst niedrigeren Stufenvertretung vertreten sind. \\nVorabüberweisung an ARecht"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
