			<string key="DokNr" value="12/0082"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-0082.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Rechtsverhältnisse der Mitglieder des Abgeordnetenhauses von Berlin (Landesabgeordnetengesetz).&lt;br&gt; &lt;br /&gt;Änderung  § 34 b Abs. 1: Wahlrecht des Beamten zwischen Kürzung der regelmäßigen Arbeitszeit oder Urlaub ohne Besoldung&lt;br&gt;Einfügung § 35 a:  Legaldefinition von und Leistungen an Parlamentarische Gruppen. Es wird ein sog. Pro-Kopf-Betrag und&lt;br /&gt;gegebenenfalls ein Oppositionszuschlag gewährt. Im Gegensatz zu den Fraktionen steht jedoch kein Grundbetrag &lt;br /&gt;zu"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1991"/>
