			<string key="Desk" value="Rundfunk"/>
			<string key="Titel" value="Gesetz zu dem Staatsvertrag über die Körperschaft des öffentlichen Rechts &quot;Deutschlandradio&quot; und zu dem Staatsvertrag über die Überleitung von Rechten und Pflichten des Deutschlandfunks und des RIAS Berlin auf die Körperschaft des öffentlichen Rechts &quot;Deutschlandradio&quot; - Hörfunk-Überleitungsstaatsvertrag - vom 17. Juni 1993"/>
			<string key="DokNr" value="12/3112"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-3112.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Mit dem vorliegenden Staatsvertrag zwischen Bund und Ländern soll die Überleitung von Rechten und Pflichten der&lt;br /&gt;Rundfunkanstalt des Bundesrechts Deutschlandfunk und des RIAS Berlin auf die Körperschaft des öffentlichen Rechts&lt;br /&gt;der Länder &quot;Deutschlandradio&quot; erfolgen. Er gewährt damit der Körperschaft den notwendigen sächlichen und&lt;br /&gt;personellen Bestand, damit diese im Rahmen ihres Programmauftrags zwei bundesweite Hörfunkprogramme&lt;br /&gt;ausstrahlen kann. \\nVorabüberweisung an AMedien"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1993"/>
			<string key="NrInTyp" value="12/0"/>
