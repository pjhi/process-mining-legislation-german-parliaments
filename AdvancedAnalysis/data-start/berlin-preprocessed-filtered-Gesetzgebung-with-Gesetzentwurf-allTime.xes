		<string key="VSysL" value="nan"/>
		<string key="VorgangsDeskriptoren" value="[&apos;Freie Universität Berlin&apos;, &apos;Humboldt-Universität&apos;, &apos;Personalplanung&apos;]"/>
		<string key="VTyp" value="Gesetz"/>
