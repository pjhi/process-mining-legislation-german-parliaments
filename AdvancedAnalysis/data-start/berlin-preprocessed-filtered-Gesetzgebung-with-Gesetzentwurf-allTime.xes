			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Landesbürgschaft"/>
			<string key="Titel" value="Fünftes Gesetz zur Änderung des Gesetzes über die Übernahme von Landesbürgschaften für Betriebsmittel- und  &lt;br /&gt;Investitionskredite an Berliner Betriebe &lt;br /&gt;(Fünftes Gesetz zur Änderung des Gesetzes über die Übernahme von Landesbürgschaften und Garantie (Landesbürgschaftsgesetz - LaBüG))"/>
			<string key="DokNr" value="12/3618"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-3618.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Eine bislang kaum genutzte Möglichkeit der Stärkung des Eigenkapitals ist die Beteiligung von Mitarbeitern an dem&lt;br /&gt;sie beschäftigenden Unternehmen. Um die Akzeptanz von Mitarbeiterbeteiligungen zu erhöhen, soll das mit solchen&lt;br /&gt;Beteiligungen verbundene wirtschaftliche Verlustrisiko im Falle des Konkurses des Unternehmens durch die Übernahme&lt;br /&gt;einer 80%igen Garantie des Landes Berlin auf 20 % beschränkt werden."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1993"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
