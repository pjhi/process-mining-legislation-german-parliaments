			<string key="Urheber" value="Freie Demokratische Partei (FDP)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-0440.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Ausnahmen vom Rauchverbot sind möglich im Justiz- und Maßregelvollzug, in Krankenhäusern und Vorsorge- und Rehabilitationseinrichtungen sowie in Schulen. Das Rauchen in Gaststätten ist erlaubt, wenn diese in sich abgeschlossene und als Rauchergaststätte deutlich sichtbar gekennzeichnet sind oder ein einzelner vollständiger abgeschlossener Raum als Raucherraum ausgewiesen ist."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
