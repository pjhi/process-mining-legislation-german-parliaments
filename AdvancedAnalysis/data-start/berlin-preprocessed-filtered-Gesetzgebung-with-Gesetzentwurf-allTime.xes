			<string key="Titel" value="Drittes Gesetz zur Änderung des Fraktionsgesetzes&lt;br /&gt; (Erstes Gesetz zur Änderung des Fraktionsgesetzes)"/>
			<string key="DokNr" value="15/3346"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Partei des Demokratischen Sozialismus (PDS)&apos;, &apos;Bündnis 90/Die GRÜNEN (Grüne)&apos;, &apos;Freie Demokratische Partei (FDP)&apos;]"/>
