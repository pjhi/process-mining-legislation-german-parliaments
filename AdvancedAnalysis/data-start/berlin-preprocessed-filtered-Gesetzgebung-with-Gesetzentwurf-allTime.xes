		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1992-03-17T01:00:00.000+01:00"/>
			<string key="DBID" value="D-4581"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Fachbereich (Hochschulorgan)"/>
			<string key="Titel" value="Gesetz zur Fusion der Fachbereiche Veterinärmedizin, Lebensmitteltechnologie und Agrarwissenschaft in Berlin &lt;br /&gt;(Fusionsgesetz - FusG)"/>
			<string key="DokNr" value="12/1310"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1310.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der Wissenschaftsrat hat in seiner Empfehlung zu den drei&lt;br /&gt;Fächern Veterinärmedizin, Lebensmitteltechnologie und&lt;br /&gt;Agrarwissenschaft die Schaffung eines gesonderten Gesetzes&lt;br /&gt;für die Zusammenführung der jeweiligen Fachsbereiche der&lt;br /&gt;Freien Universität bzw. der Humboldt-Universität&lt;br /&gt;empfohlen.&lt;br /&gt;Insbesondere ist es Aufgabe des Gesetzes, die Funktionen&lt;br /&gt;der verschiedenen Gremien der jeweiligen beiden&lt;br /&gt;Universitäten (Fachbereiche, Akademische Senate,&lt;br /&gt;Personalkommissionen und Kuratorien) zusammenzufassen, um&lt;br /&gt;dem Koordinierungszwang zu jeweils übereinstimmenden&lt;br /&gt;Gremienbeschlüssen der verschiedenen Hochschulen zu&lt;br /&gt;entgehen.&lt;br /&gt; Das Gesetz enthält Regelungen u.a. zu folgenden Bereichen:&lt;br /&gt; a) Gründungskomitee und dessen Zuständigkeiten;&lt;br /&gt; b) Personalzusammenführung, Personalübernahme."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="62500"/>
			<date key="DokDat" value="1992-03-17T00:00:00+00:00"/>
			<date key="DokDat_original" value="1992-03-17T00:00:00+00:00"/>
		</event>
