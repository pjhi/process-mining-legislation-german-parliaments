			<string key="DokNr" value="18/2378"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-2378.pdf"/>
			<string key="Sb" value="1-80"/>
			<string key="Abstract" value="Erweiterung und Vertiefung der Handlungsmöglichkeiten der Wohnungsaufsichtsämter: Erleichterung der Sachverhaltsermittlung durch die bezirklichen Wohnungsaufsichtsämter / Erweiterung der Mindestanforderungen an erträgliche Wohnverhältnisse / Beschleunigung der Verwaltungsvollstreckung durch gesetzlichen Ausschluss der aufschiebenden Wirkung von Rechtsbehelfen gegen wohnungsaufsichtsrechtliche Anordnungen / Einführung einer Treuhänderregelung in Anlehnung an das Zweckentfremdungsverbot-Gesetz&lt;br&gt;&lt;br /&gt;Änderung §1 Abs. 1, 2 ,3; §3 Abs. 1, 2, der bisherige Abs. 4 wird Abs. 3; §4 Abs. 1, der bisherige Abs. 4 wird Abs. 3, der bisherige Abs. 2 wird Abs. 3; §6 Abs. 1, 2, 3, 4, 5,; § 7; §8 Abs. 1, 2; §9 Abs. 1, 3; § 10 Abs. 1, 2, 3; §10a Abs. 1§11 Abs. 1, 2,3; §12; §13 Abs. 12, 3; §14;15;16&lt;br&gt;Aufhebung § 2 der bisherige §2a wird 2; §3 Abs. 3; §4 Abs. 3;&lt;br&gt;Anfügung §3 Abs. 4, 5 , 6; §4 Abs. 2; §9a, §9b; 10 Abs. 4, 5, 6; §11a"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
