		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1992-02-05T01:00:00.000+01:00"/>
			<string key="DBID" value="D-4457"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Verfassung"/>
			<string key="Titel" value="26. Gesetz zur Änderung der Verfassung von Berlin"/>
			<string key="DokNr" value="12/1136"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (B90/Gr)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1136.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="In der geltenden Fassung des Artikels 87 a Abs. 2 Satz 1&lt;br /&gt;endet die WP der BVV &quot;am 30. Juni 1992&quot;. Aus der&lt;br /&gt;vorgeschlagenen Änderung soll die Zulässigkeit des ersten&lt;br /&gt;Zusammentritts der neugewählten BVV vor dem 30. Juni 1992&lt;br /&gt;erfolgen, sowie die Regelung sichergestellt werden, daß es&lt;br /&gt;nicht zu einem zeitweiligen Nebeneinander der alten und&lt;br /&gt;der neuen BVV kommt. die BVV wird ausdrücklich nach dem&lt;br /&gt;Verfahren der mathematischen Proportion (Hare-Niemeyer)&lt;br /&gt;von den Wahlberechtigten des Bezirks gewählt. Dieses&lt;br /&gt;Verfahren muß daher auch für die Wahl des Bezirksamtes&lt;br /&gt;verankert werden.&lt;br /&gt; Wurde als 26. Gesetz zur Änderung der Verfassung von&lt;br /&gt;Berlin zusammen mit Drs 12/700 angenommen und im GVBl.&lt;br /&gt;veröffentlicht."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="59466"/>
