			<string key="Desk" value="Bauordnung"/>
			<string key="Titel" value="Fünftes Gesetz zur Änderung der Bauordnung für Berlin"/>
			<string key="DokNr" value="12/4571"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-4571.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Änderung des § 48 BauO Berlin insofern, daß&lt;br /&gt;bauordnungsrechtlich notwendige Stellplätze nur noch für&lt;br /&gt;Wohnungen sowie für schwer Gehbehinderte und&lt;br /&gt;Rollstuhlbenutzer gefordert werden. Damit soll für&lt;br /&gt;Investoren von großen Bauvorhaben der Ablösebetrag&lt;br /&gt;wegfallen können. \\nVorabüberweisung an ABauWohn, AVerkBetr u. AHaupt"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1994"/>
			<string key="NrInTyp" value="12/0"/>
