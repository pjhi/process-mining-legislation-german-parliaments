			<string key="Titel" value="Elftes Gesetz zur Änderung des Berliner Kammergesetzes"/>
			<string key="DokNr" value="16/2541"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-2541.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Festschreibung der rechtlichen Gleichstellung von eingetragenen Lebenspartnerschaften mit Ehepartner(inne)n bei der Hinterbliebenenversorgung für alle Fürsorgeeinrichtungen und Versorgungswerke nach dem Berliner Kammergesetz. Außerdem wird eine Regelung über die Grenzen der Pfändung der Leistungen der Versorgungseinrichtung aufgenommen.&lt;br&gt;Änderung des §§ 4 und 54"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
