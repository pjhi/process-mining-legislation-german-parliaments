			<string key="DokNr" value="18/0625"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-0625.pdf"/>
			<string key="Sb" value="1-55"/>
			<string key="Abstract" value="Anpassung an die geltende Seveso-II-Richtlinie und das europäische Störfallrecht an das EU-System zur Einstufung gefährlicher Stoffe. Weitere Änderungen der Richtlinie betreffen die Überwachung von Betrieben im Sinne von Artikel 3 Nummer 1 der Seveso-III-Richtlinie (Störfallbetriebe), die Information und Öffentlichkeitsbeteiligung sowie den Gerichtszugang für die betroffene Öffentlichkeit.&lt;br&gt;Artikelgesetz:&lt;br&gt;Artikel 1: Änderung des Gefahrenbeherrschungsgesetzes&lt;br&gt;Artikel 2: Änderung des Berliner Straßengesetzes&lt;br&gt;Artikel 3: Änderung des Landesseilbahngesetzes&lt;br&gt;Artikel 4: Änderung des Allgemeinen Zuständigkeitsgesetzes&lt;br&gt; Artikel 5: Änderung des Allgemeinen Sicherheits- und Ordnungsgesetzes (ASOG)&lt;br&gt;Artikel 6: Änderung der Verordnung über die Zuständigkeit für einzelne Bezirksaufgaben&lt;br&gt; Artikel 7: Änderung des Kreislaufwirtschafts- und Abfallgesetzes Berlin&lt;br&gt;Artikel 8: Aufhebung von Rechtsvorschriften"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
