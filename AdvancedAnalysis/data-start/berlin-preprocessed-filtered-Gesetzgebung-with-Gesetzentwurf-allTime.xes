			<string key="Desk" value="Nachtragshaushaltsgesetz 1990"/>
			<string key="Titel" value="Gesetz über die Feststellung eines Nachtrags zum Haushaltsplan von Berlin für das Haushaltsjahr 1990 &lt;br /&gt;(Nachtragshaushaltsgesetz 1990 - NHG 90)"/>
			<string key="DokNr" value="11/0653"/>
			<string key="Urheber" value="nan"/>
