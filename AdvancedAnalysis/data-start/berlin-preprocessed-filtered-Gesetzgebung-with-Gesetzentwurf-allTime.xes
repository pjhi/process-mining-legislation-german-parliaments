			<string key="Desk" value="Besoldungsrecht"/>
			<string key="Titel" value="Gesetz zur Anpassung der Besoldung und Versorgung für das Land Berlin 2021 und zur Änderung weiterer Vorschriften &lt;br /&gt;(BerlBVAnpG 2021)"/>
			<string key="DokNr" value="18/3285"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/18/DruckSachen/d18-3285.pdf"/>
			<string key="Sb" value="1-177"/>
			<string key="Abstract" value="Besoldungsanpassungen ab dem Jahr 2019 bis zum Jahr 2021 jährlich 1,1 Prozentpunkte über dem Durchschnitt der übrigen Bundesländer. Darüber hinaus wurden die Anpassungszeitpunkte schrittweise vorgezogen: im Jahr 2019 auf den 1. April, im Jahr 2020 auf den 1. Februar und im Jahr 2021 auf den 1. Januar. Lineare Erhöhung der Besoldung im Jahr 2021 zum 1. Januar 2021 um 2,5 vom Hundert. Für die Anwärterinnen und Anwärter wird ebenfalls eine Erhöhung der Anwärtergrundbeträge zum 1. Januar 2021 um 2,5 vom Hundert erfolgen. Ab dem 1. November 2020 werden für die beamteten Dienstkräfte eine Hauptstadtzulage in Höhe von monatlich 150 € gezahlt.&lt;br&gt;Artikelgesetz:&lt;br&gt;Artikel 1: Gesetz zur Anpassung der Besoldung und Versorgung für das Jahr 2021&lt;br&gt;Artikel 2: Änderung des Bundesbesoldungsgesetzes in der Überleitungsfassung für Berlin&lt;br&gt;Artikel 3: Änderung des Landesbesoldungsgesetzes&lt;br&gt;Artikel 4: Änderung des Sonderzahlungsgesetzes&lt;br&gt; Artikel 5: Änderung weiterer Vorschriften&lt;br&gt;Artikel 6: Änderung des La"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
