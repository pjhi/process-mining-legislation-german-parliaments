			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Rundfunkanstalt"/>
			<string key="Titel" value="Siebentes Gesetz zur Änderung des Gesetzes über die Errichtung einer Rundfunkanstalt &quot;Sender Freies Berlin&quot;"/>
			<string key="DokNr" value="12/5898"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-5898.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Satzung des Senders Freies Berlin erlaubt es diesem&lt;br /&gt;nicht, sich an einem Rundfunkveranstalter zu beteiligen. Dies&lt;br /&gt;bedeutet einen Wettbewerbsnachteil. Desweiteren hat sich die&lt;br /&gt;Hochschullandschaft dergestalt verändert, daß es nicht mehr&lt;br /&gt;gerechtfertigt erscheint, die Benennung der beiden Vertreter&lt;br /&gt;der Hochschulen im Rundfunkrat nur der Freien Universität&lt;br /&gt;Berlin und der Technischen Universität Berlin zu überlassen.&lt;br /&gt;Die Benennung der beiden Vertreter der Hochschulen soll der&lt;br /&gt;Freien Universität Berlin, der Technischen Universität Berlin&lt;br /&gt;und der Humboldt-Universität zu Berlin übertragen werden."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1995"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
