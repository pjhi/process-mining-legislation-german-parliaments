			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Rundfunk"/>
			<string key="Titel" value="Gesetz zu dem Staatsvertrag über die Zusammenarbeit zwischen Berlin und Brandenburg im Bereich des Rundfunks"/>
			<string key="DokNr" value="12/1247"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1247.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Ziel des Rundfunkstaatsvertrags mit Brandenburg ist zum&lt;br /&gt;einen, die für den privaten Rundfunk in Berlin und&lt;br /&gt;Brandenburg erforderliche Rechtsgrundlage zu schaffen. Zum&lt;br /&gt;anderen regelt der Rundfunkstaatsvertrag die&lt;br /&gt;Frequenzverteilung im Hörfunk- und Fernsehbereich in der&lt;br /&gt;Region, die Zusammenarbeit der beiden&lt;br /&gt;Landesrundfunkanstalten im Bereich des&lt;br /&gt;öffentlich-rechtlichen Rundfunks und die Errichtung einer&lt;br /&gt;gemeinsamen Medienanstalt für die Zulassung privater und&lt;br /&gt;öffentlich-rechtlicher und die Kontrolle privater&lt;br /&gt;Rundfunkveranstalter."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
