			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Öffentlicher Gesundheitsdienst"/>
			<string key="Titel" value="Erstes Gesetz zur Änderung des Gesundheitsdienst-Gesetzes"/>
			<string key="DokNr" value="12/1630"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (B90/Gr)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-1630.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Es ist weitgehend unbestritten, daß die sozialen&lt;br /&gt;Lebensbedingungen und die Umweltbedingungen einen&lt;br /&gt;wesentlichen Einfluß auf die gesundheitliche Entwicklungen&lt;br /&gt;der Bevölkerung haben. Diese medizin-soziologischen&lt;br /&gt;Erkenntnisse und die umweltmedizinischen Erkenntnisse&lt;br /&gt;müssen in der Arbeit des Gesundheitsdienstes zusätzlich zu&lt;br /&gt;den medizinischen und medizinisch-technischen&lt;br /&gt;Entwicklungen berücksichtigt werden. Diesem Ziel soll der&lt;br /&gt;vorliegende Änderungsantrag zum Gesundheitsdienst-Gesetz&lt;br /&gt;dienen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
