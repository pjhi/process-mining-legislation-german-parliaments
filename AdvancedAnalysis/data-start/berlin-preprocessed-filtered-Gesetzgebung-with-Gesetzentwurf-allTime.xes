			<string key="Sb" value="2180"/>
			<string key="Abstract" value="Die nachträgliche Zustimmung zur Vorabüberweisung&lt;br /&gt;der Drs 11/370 u. 11/982 an den Rechtsausschuß wurde&lt;br /&gt;festgestellt.&lt;br /&gt; Namentliche Abstimmung: S. 2226; s.a. S. 2187C;&lt;br /&gt; Annahme;&lt;br /&gt; Der Präsident hat das Gesetz nicht ausgefertigt, da das&lt;br /&gt;Bundesverfassungsgericht durch Urteil vom 31.10.1990 -&lt;br /&gt;2 BvF 3/89 - das Hamburgische Gesetz zur Einführung des&lt;br /&gt;Wahlrechts für Ausländer zu den Bezirksversammlungen für&lt;br /&gt;verfassungswidrig und nichtig erklärt hat."/>
			<string key="Redner" value="[&apos;Landowsky, Klaus (CDU)&apos;, &apos;Barthel, Eckhardt (SPD)&apos;, &apos;Eckert, Albert (GRÜNE/AL)&apos;, &apos;Pagel, Carsten (REP)&apos;, &apos;Telge, Dieter (GRÜNE/AL)&apos;, &apos;Zimmermann, Ulrike (GRÜNE/AL)&apos;, &apos;Andres, Bernhard (fraktionslos)&apos;]"/>
