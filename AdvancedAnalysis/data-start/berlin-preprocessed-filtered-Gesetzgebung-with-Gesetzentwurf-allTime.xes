		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1997-10-30T01:00:00.000+01:00"/>
			<string key="DBID" value="D-20919"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Sozialberuf"/>
			<string key="Titel" value="Gesetz über die staatliche Anerkennung in sozialpädagogischen und sozialpflegerischen Berufen im Land Berlin &lt;br /&gt;(Sozialberufe-Anerkennungsgesetz - SozBAG)"/>
			<string key="DokNr" value="13/2146"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d2146.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Durch gesetzliche Regelung wird für den Ausbildungsgang der Sozialarbeiter und Sozialpädagogen das bisherige Berufspraktikum in den Bildungsgang bis zur Ablegung der Diplomprüfung integriert (einphasige Ausbildung). Durch den künftigen Wegfall des einjährigen Berufspraktikums entfällt auch die Zahlung einer tarifvertraglich geregelten Vergütung für diesen Teil der berufspraktischen Ausbildung, so daß Einsparungen an Personal- und Zuwendungsmitteln erzielt werden können. Zugleich wird die Berufsbefähigung in Form der staatlichen Anerkennung für Sozialarbeiter und Sozialpädagogen, Altenpfleger, Familienpfleger, Heilerziehungspfleger und Heilpädagogen geregelt."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="25909"/>
			<date key="DokDat" value="1997-10-30T00:00:00+00:00"/>
			<date key="DokDat_original" value="1997-10-30T00:00:00+00:00"/>
		</event>
