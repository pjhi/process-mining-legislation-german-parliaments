			<string key="DBID" value="D-187137"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Heilhilfsberuf"/>
			<string key="Titel" value="Gesetz zur Umsetzung der Richtlinie 2005/36/EG im Recht der Gesundheitsberufe"/>
			<string key="DokNr" value="16/0919"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/16/DruckSachen/d16-0919.pdf"/>
			<string key="Sb" value="1-95"/>
			<string key="Abstract" value="Die Gesundheitsberufe sind im Wesentlichen bundesrechtlich geregelt. Der Bundesrat hat dem verabschiedeten Gesetz zur Umsetzung der Richtlinie 2005/36/EG des Europäischen Parlaments über die Anerkennung der Berufsqualifikationen der Heilberufe, zugestimmt.&lt;br&gt;Mit geändert wurden: &lt;br&gt;Berliner Kammergesetz; Gesetz über Medizinalfachberufe und den Beruf des Lebensmittelkontrolleurs; Weiterbildungsgesetz; Gesetz über die Berufsbezeichnung &quot;Staatlich geprüfte Lebensmittelchemikerin&quot; und über die Führung der Berufsbezeichnung &quot;Medizinphysiker/Medizinphysikerin&quot; und das Gesetz über die Ausführung des Berufs der Hebamme und des Entbindungspflegers. \\nVorabüberweisung an AGesUmVer"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
