			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Bezirksverwaltungsgesetz"/>
			<string key="Titel" value="Sechstes Gesetz zur Änderung des Bezirksverwaltungsgesetzes"/>
			<string key="DokNr" value="12/1677"/>
			<string key="Urheber" value="Freie Demokratische Partei (FDP)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-1677.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Änderung des § 34 Abs. 1 ermöglicht es, auch ein&lt;br /&gt;kleines Bezirksamt zu bilden, um dadurch den örtlichen&lt;br /&gt;Gegebenheiten Rechnung zu tragen und Steuermittel zu&lt;br /&gt;sparen. Die Möglichkeit der Bildung von sogenannten&lt;br /&gt;politischen Bezirksämtern, erlaubt eine stärkere&lt;br /&gt;Akzentuierung der bezirklichen Verwaltungsschwerpunkte.&lt;br /&gt;Ein so gebildetes Bezirksamt wirkt der bestehenden&lt;br /&gt;Verschleierung der politischen Verantwortlichkeit entgegen.&lt;br /&gt; Änderung des § 35"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
