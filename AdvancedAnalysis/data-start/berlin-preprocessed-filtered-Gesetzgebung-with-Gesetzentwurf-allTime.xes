			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Freiwillige Polizei-Reserve (FPR)"/>
			<string key="Titel" value="Gesetz zur Aufhebung des Gesetzes über die Freiwillige Polizei-Reserve (FPRG)"/>
			<string key="DokNr" value="12/2454"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (B90/Gr)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-2454.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Mit der Herstellung der deutschen Einheit und der&lt;br /&gt;Vereinigung beider Teile Berlins hat die FPR ihren Sinn&lt;br /&gt;spätestens verloren. Sie bindet mehr Schutzpolizisten, die&lt;br /&gt;voll ausgebildet und bezahlt werden, als sie im&lt;br /&gt;Alltagsdienst freisetzt.&lt;br /&gt; Statt die FPR zügig aufzulösen, setzt die große Koalition&lt;br /&gt; nicht nur ihren Fortbestand durch, sondern erweiterte mit&lt;br /&gt; dem Gesetz über die FPR vom 23. Juni 1992 in bis dahin&lt;br /&gt; unvorstellbarer Weise die Befugnisse der FPR. Aus einer&lt;br /&gt; reinen Gebäude-Bewachungstruppe wurde eine allzuständige&lt;br /&gt; Hilfspolizei gemacht, einsetzbar im täglichen&lt;br /&gt; Streifendienst, zur Verkehrsüberwachung und bei&lt;br /&gt; Großveranstaltungen.&lt;br /&gt; Das staatliche Gewaltmonopol verpflichtet den Staat, die&lt;br /&gt; Ausübung der Staatsgewalt durch gründlich ausgebildete, an&lt;br /&gt; Verfassung und Gesetzen geschulte Polizeibeamte vornehmen&lt;br /&gt; zu lassen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1993"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
			<int key="@@index" value="35080"/>
