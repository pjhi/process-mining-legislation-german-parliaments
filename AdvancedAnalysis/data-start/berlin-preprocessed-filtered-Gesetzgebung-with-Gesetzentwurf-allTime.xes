			<string key="Desk" value="Verwaltungsgericht"/>
			<string key="Titel" value="Viertes Gesetz zur Änderung des Gesetzes zur Ausführung der Verwaltungsgerichtsordnung"/>
			<string key="DokNr" value="12/3628"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-3628.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Durch entsprechende Änderung des § 2 Abs. 1 Satz 2 des Gesetzes zur Ausführung der Verwaltungsgerichtsordnung&lt;br /&gt;soll bestimmt werden, daß Entscheidungen des Oberverwaltungsgerichts durch Gerichtsentscheide ohne die Mitwirkung ehrenamtlicher Richter ergehen. Von der Möglichkeit, für Verfahren nach § 48 Abs. 1 VwGO eine Besetzung der Senate mit fünf Berufsrichtern vorzusehen, soll kein Gebrauch gemacht werden. Es soll bei der Besetzung mit drei Berufsrichtern und zwei ehrenamtlichen Richtern bleiben."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1993"/>
