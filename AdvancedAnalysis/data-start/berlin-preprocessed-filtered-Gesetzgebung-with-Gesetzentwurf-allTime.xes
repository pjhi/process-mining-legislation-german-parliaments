			<string key="Desk" value="Bezirksverwaltungsgesetz"/>
			<string key="Titel" value="Gesetz zur Änderung des Bezirksverwaltungsgesetzes und anderer Gesetze"/>
			<string key="DokNr" value="18/3283"/>
			<string key="Urheber" value="nan"/>
