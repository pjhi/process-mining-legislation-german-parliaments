			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Landesbürgschaft"/>
			<string key="Titel" value="Sechstes Gesetz zur Änderung des Gesetzes über die Übernahme von Landesbürgschaften und Garantien &lt;br /&gt;(Landesbürgschaftsgesetz - LaBüG) &lt;br /&gt;(Sechstes Gesetz zur Änderung des Landesbürgschaftsgesetzes)"/>
			<string key="DokNr" value="12/5887"/>
			<string key="Urheber" value="[&apos;Christlich Demokratische Union Deutschlands (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-5887.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Im Rahmen der Wirtschaftsförderungsprogramme können wirtschafts- und beschäftigungspolitisch förderungswürdigen&lt;br /&gt;Industriebetrieben nicht immer Hilfen gewährt werden. Beteiligungen von Kreditinstituten, Kapitalsammelstellen und&lt;br /&gt;Kapitalbeteilungsgesellschaften, die mittels einer Landesgarantie abgesichert werden sind geeignet die bestehenden Finanzierungslücken zu schließen. Der aus Mitteln der ehemaligen Treuhandanstalt eingerichtete Konsolidierungsfonds hat seine Fördertätigkeit aufgenommen. Aus ihm können gewerbliche Unternehmen Darlehen und stille Beteiligungen erhalten."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1995"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Antrag (Gesetzentwurf)"/>
