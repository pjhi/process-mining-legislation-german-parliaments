		<string key="VSys" value="5240"/>
		<string key="VSysL" value="Arzneimittel"/>
		<string key="VorgangsDeskriptoren" value="[&apos;Arzneimittelprüfung&apos;, &apos;Rechtsbereinigung&apos;]"/>
		<string key="VTyp" value="Gesetz"/>
