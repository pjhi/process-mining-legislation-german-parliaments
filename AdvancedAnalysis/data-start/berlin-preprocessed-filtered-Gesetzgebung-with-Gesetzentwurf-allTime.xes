			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Museum"/>
			<string key="Titel" value="Gesetz über Museumsstiftungen des Landes Berlin &lt;br /&gt;(Museumsstiftungsgesetz - MusStG)"/>
			<string key="DokNr" value="13/3213"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/13/DruckSachen/d3213.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Unabhängigkeit der Museumsstiftungen von der staatlichen&lt;br /&gt;Verwaltung soll gestärkt werden. Die Besetzung des&lt;br /&gt;Stiftungsrates wird neu geregelt. Der Vorstand der Stiftung&lt;br /&gt;gehört nicht mehr dem Stiftungsrat an und ist nicht mehr&lt;br /&gt;Vorsitzender des Beirats der Stiftung.  Zur Dezentralisierung&lt;br /&gt;von Zuständigkeiten entfällt die Fachaufsicht über die&lt;br /&gt;Museumstiftungen. Die Organisationsstruktur der Stiftung &lt;br /&gt;&quot;Stadtmuseum Berlin&quot; wird geändert, indem die selbständige&lt;br /&gt;Stiftung des öffentlichen Rechts &quot;Jüdisches Museum Berlin&quot;&lt;br /&gt;errichtet wird.&lt;br /&gt; Außer Kraft treten:&lt;br /&gt; Museumsstiftungsgesetz; Verordnung über die&lt;br /&gt; Errichtungs-Satzung der &quot;Stiftung Stadtmuseum Berlin&quot;;&lt;br /&gt; Verordnung über die Verwaltungssatzung der &quot;Stiftung&lt;br /&gt; Stadtmuseum Berlin&quot; \\nVorabüberweisung an AWissFoKult"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
