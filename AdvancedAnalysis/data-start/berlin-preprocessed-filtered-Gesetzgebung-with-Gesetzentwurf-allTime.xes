			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Betreuungsgesetz"/>
			<string key="Titel" value="Gesetz zur Ausführung des Betreuungsgesetzes (AGBtG) und zur Anpassung des Landesrechts"/>
			<string key="DokNr" value="12/2211"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-2211.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Der vorliegende Entwurf eines Berliner Ausführungsgesetzes&lt;br /&gt;zum Betreuungsgesetz (AGBtG) und zur Anpassung des&lt;br /&gt;Landesrechts enthält in Artikel I die zur Durchführung des&lt;br /&gt;Betreuungsgesetzes erforderlichen landesrechtlichen&lt;br /&gt;Regelungen; er sieht u. a. auch die finanzielle Förderung&lt;br /&gt;anerkannter Betreuungsvereine durch das Land vor.&lt;br /&gt;Artikel II enthält die Anpassung der neuen einheitlichen&lt;br /&gt;Verfahrensvorschriften des Gesetzes über die&lt;br /&gt;Angelegenheiten der freiwilligen Gerichtsbarkeit im Gesetz&lt;br /&gt;für psychisch Kranke (PsychKG)."/>
