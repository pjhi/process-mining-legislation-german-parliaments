			<string key="Desk" value="Abgabe"/>
			<string key="Titel" value="Fünftes Gesetz der Änderung des Gesetzes über Naturschutz und Landschaftspflege von Berlin &lt;br /&gt; (Siebentes Gesetz zur Änderung des Gesetzes über Naturschutz und Landschaftspflege von Berlin)"/>
			<string key="DokNr" value="12/4441"/>
			<string key="Urheber" value="[&apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Christlich Demokratische Union Deutschlands (CDU)&apos;]"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/DruckSachen/d12-4441.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Ausschöpfung der bundesrechtlichen Ermächtigung des Bundesnaturschutzgesetzes. Diese sieht vor, daß für bauliche Vorhaben, die nicht den Regelungen des Investitionserleichterungs- und Wohnbaulandgesetzes unterworfen sind, landesrechtliche Regelungen zum Ausgleich von Beeinträchtigungen des Naturhaushaltes und des Landschaftsbildes auf dem Wege einer Geldleistung durch den jeweiligen Vorhabenträger getroffen werden können.&lt;br /&gt; Einfügung § 14 a und 14 b"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1994"/>
