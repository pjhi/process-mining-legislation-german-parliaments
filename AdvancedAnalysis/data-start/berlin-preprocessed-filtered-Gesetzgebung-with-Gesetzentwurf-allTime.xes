			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTyp" value="Antr (GesEntw)"/>
			<string key="DokTypL" value="Antrag (Gesetzentwurf)"/>
			<string key="Desk" value="Fraktion"/>
			<string key="Titel" value="Gesetz über die Rechtsstellung der Fraktionen im Abgeordnetenhaus von Berlin (Berliner Fraktionsgesetz) &lt;br /&gt; (Gesetz über die Rechtsstellung der Fraktionen des  Abgeordnetenhauses von Berlin (Fraktionsgesetz - FraktG))"/>
			<string key="DokNr" value="12/1543"/>
			<string key="Urheber" value="Bündnis 90/Die GRÜNEN (B90/Gr)"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/12/Drucksachen/d12-1543.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Verfassung von Berlin schreibt in Artikel 27 Absatz 2&lt;br /&gt;vor, die Rechtsstellung und Organisation sowie die Rechte&lt;br /&gt;und Pflichten der Fraktionen durch ein Gesetz zu&lt;br /&gt;bestimmen. Dieser Entwurf über die Rechtsstellung der&lt;br /&gt;Fraktionen im Abgeordnetenhaus von Berlin, ihre Aufgaben&lt;br /&gt;und die Transparenz ihrer Finanzierung einschließlich der&lt;br /&gt;Rechnungslegung und Rechnungsführung soll diese&lt;br /&gt;überfällige gesetzliche Regelung schaffen, ohne dabei neue&lt;br /&gt;finanzielle Ansprüche entstehen zu lassen."/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="1992"/>
			<string key="NrInTyp" value="12/0"/>
			<string key="VkDat" value="nan"/>
