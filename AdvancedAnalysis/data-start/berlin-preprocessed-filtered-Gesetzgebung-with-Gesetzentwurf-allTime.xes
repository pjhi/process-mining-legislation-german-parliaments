			<string key="Desk" value="Berliner Landesinstitut für Schule und Medien (LISUM)"/>
			<string key="Titel" value="Gesetz zum Staatsvertrag über die Errichtung eines gemeinsamen Landesinstituts für Schule und Medien Berlin-Brandenburg (LISUM)"/>
			<string key="DokNr" value="15/5157"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-5157.pdf"/>
			<string key="Sb" value="1-51"/>
			<string key="Abstract" value="Nach der Gründung eines gemeinsamen Instituts für Schulqualität der Länder Berlin und Brandenburg e.V. (ISQ), dessen Ziel es ist, die systematische Qualitätsentwicklung und Qualitätssicherung in den Bildungseinrichtungen beider Länder zu forcieren, wird mit dem Staatsvertrag eine gemeinsame pädagogische Institution geschaffen, die die qualitative Weiterentwicklung von Schule und Erwachsenenbildung bzw. Weiterbildung der Bildungseinrichtungen beider Länder zur Aufgabe hat.&lt;br /&gt;Mit geändert wurden:&lt;br /&gt;Allgemeines Zuständigkeitsgesetz, Landesbesoldungsgesetz, Personalvertretungsgesetz, Schulgesetz"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
