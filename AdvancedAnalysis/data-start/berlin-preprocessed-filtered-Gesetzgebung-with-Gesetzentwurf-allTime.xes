			<string key="DokTyp" value="VorlBeschl (GesEntw)"/>
			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Stiftung"/>
			<string key="Titel" value="Gesetz zur Änderung von Vorschriften im Bereich der Museum-, Bibliotheks- und Gedenkstättenstiftungen (StiftÄndG)"/>
			<string key="DokNr" value="15/3198"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-3198.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Die Konsolidierung des Haushaltes des Landes Berlin erfordert Beiträge aus allen Bereichen. Hierzu gehören auch die&lt;br /&gt;rechtsfähigen Stiftungen des öffentlichen Rechts im Bereich der Museen, Bibliotheken und Gedenkstätten. Vor dem&lt;br /&gt;Hintergrund des Abschlusses des Berliner Anwendungstarifvertrages und der damit verbundenen Einsparungen im Bereich der Personalkosten ist den Stiftungen mit dem Haushaltsjahr 2005 eine Verminderung ihrer Zuschüsse auferlegt worden, deren Erwirtschaftung im Personalbereich ermöglicht werden muss. Dem stehen gegenwärtig Bestimmungen&lt;br /&gt;in den Errichtungsgesetzen entgegen. &lt;br /&gt;Mit geändert wurden:&lt;br /&gt; Zentralbibliotheksstiftungsgesetz; Museumsstiftungsgesetz;  Gesetz über die Errichtung der Stiftung &quot;Topographie des&lt;br /&gt; Terrors-Internationales Dokumentations- und  Begegnungszentrum Berlin&quot;"/>
			<string key="Redner" value="nan"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="nan"/>
			<string key="NrInTyp" value="nan"/>
			<string key="VkDat" value="nan"/>
			<string key="concept:name" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<int key="@@index" value="88405"/>
