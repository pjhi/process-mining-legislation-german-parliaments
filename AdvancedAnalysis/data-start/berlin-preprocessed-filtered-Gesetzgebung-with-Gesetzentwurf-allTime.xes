			<string key="DokTypL" value="Vorlage zur Beschlussfassung (Gesetzentwurf)"/>
			<string key="Desk" value="Kirchensteuer"/>
			<string key="Titel" value="Viertes Gesetz zur Änderung des Kirchensteuergesetzes"/>
			<string key="DokNr" value="15/0002"/>
			<string key="Urheber" value="nan"/>
			<string key="LokURL" value="https://pardok.parlament-berlin.de/starweb/adis/citat/VT/15/DruckSachen/d15-0002.pdf"/>
			<string key="Sb" value="nan"/>
			<string key="Abstract" value="Mit dem Gesetz zur Regelung der Bemessungsgrundlage für&lt;br /&gt;Zuschlagsteuern von 21.12.2000 (BGBl.I S. 1978) ist die&lt;br /&gt;Vorschrift des § 51 a Abs. 2 des Einkommensteuergesetzes&lt;br /&gt;(EStG) dahingehend geändert worden, dass die Minderung der&lt;br /&gt;Einkommensteuer an 2001 bei der Berechnung der Kirchensteuer&lt;br /&gt;nicht zum Tragen kommt. Damit dies in Berlin wirksam werden&lt;br /&gt;kann, ist das Kirchensteuergesetz zu ändern."/>
