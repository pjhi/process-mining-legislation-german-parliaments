			<string key="Titel" value="Gesetz über die Unterbringung und Versorgung von Asylbewerbern (Asylbewerberunterbringungs- und -versorgungsgesetz &amp;minus; AsylbUV)"/>
			<string key="DokNr" value="17/2929"/>
			<string key="Urheber" value="Alternative für Deutschland (AfD)"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP17/Drucksachen/2000/17_2929_D.pdf"/>
