			<string key="DokTypL" value="Gesetzentwurf"/>
			<string key="Desk" value="Baurecht"/>
			<string key="Titel" value="Gesetz zur Digitalisierung baurechtlicher Verfahren"/>
			<string key="DokNr" value="17/5422"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP17/Drucksachen/5000/17_5422_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 19.09.2023 Drucksache 17/5422  (17 S.)"/>
			<string key="Su" value="17"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Ermöglichung der Digitalisierung und Beschleunigung baurechtlicher Verfahren, insbesondere Schaffung des elektronischen Textformerfordernisses als alternative Form neben dem Schriftformerfordernis; Einführung der einfachen Bekanntgabe als Alternative zum Zustellungserfordernis; Beschränkung der Angrenzerbenachrichtigung auf die Fälle der Abweichungen, Ausnahmen oder Befreiungen von nachbarschützenden Vorschriften des öffentlichen Baurechts; direkte Einreichung der Anträge und Bauvorlagen bei den Baurechtsbehörden zur unverzüglichen Benachrichtigung der betroffenen Gemeinden"/>
			<string key="VkDat" value="NaT"/>
