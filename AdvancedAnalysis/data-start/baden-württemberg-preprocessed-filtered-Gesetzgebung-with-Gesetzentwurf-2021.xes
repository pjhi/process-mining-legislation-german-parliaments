			<date key="time:timestamp" value="2024-07-09T02:00:00.000+02:00"/>
			<string key="@id" value="D-234655"/>
			<int key="ReihNr" value="0001"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTypL" value="Gesetzentwurf"/>
			<string key="Desk" value="Agrarrecht"/>
			<string key="Titel" value="Gesetz zur Änderung land- und forstwirtschaftlicher Vorschriften"/>
			<string key="DokNr" value="17/7096"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP17/Drucksachen/7000/17_7096_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 09.07.2024 Drucksache 17/7096  (29 S.)"/>
			<string key="Su" value="29"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Absenkung der Altersgrenze von Kindern für die Erteilung des Jugendfischereischeins von zehn auf sieben Jahre im Fischereigesetz für Baden-Württemberg; Vornahme einer Zuordnung der Managementstufen bezüglich Graugans und Wildkaninchen sowie Anpassung der Ziele des Gesetzes und die Ziele der Jagd an die Herausforderungen des Klimawandels im Jagd- und Wildtiermanagementgesetz; Verankerung der Grundlagen für eine digitale Förderantragstellung sowie die Bereitstellung eines Online-Portals zur gezielten Beratung und Information von Waldbesitzenden im Landeswaldgesetz; Schaffung der rechtlichen Grundlage für die im Koalitionsvertrag vereinbarte Einrichtung des Kulturlandschaftsrates sowie Ermöglichung einer digitalen Förderantragstellung im Landwirtschafts- und Landeskulturgesetz; Aufhebung der Beschränkung der Durchlässigkeit für die zum Stichtag der Forstreform bereits unbefristeten Beschäftigten im Gesetz zur Regelung des Personalübergangs auf die Anstalt des öffentlichen Rechts Forst Baden-Württemberg; Erhöhung der Flexibilität bei der Besetzung der Leitungen der für die Tiergesundheit zuständigen Organisationseinheiten von Tiergesundheitsbehörde im Tiergesundheitsausführungsgesetz; Anpassungen des Landesbeamtengesetzes und des Landesbesoldungsgesetzes Baden-Württemberg im Hinblick auf das Amt des Direktors der Staatsschule für Gartenbau"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
			<int key="@@index" value="120091"/>
			<date key="DokDat" value="2024-07-09T00:00:00+00:00"/>
