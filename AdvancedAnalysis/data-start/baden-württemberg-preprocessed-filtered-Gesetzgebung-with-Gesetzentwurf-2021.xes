			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTypL" value="Gesetzentwurf"/>
			<string key="Desk" value="Gesetzblatt"/>
			<string key="Titel" value="Gesetz zur Änderung des Verkündungsgesetzes"/>
			<string key="DokNr" value="17/5185"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP17/Drucksachen/5000/17_5185_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 25.07.2023 Drucksache 17/5185  (10 S.)"/>
			<string key="Su" value="10"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Einführung eines elektronischen Gesetzblatts in Baden-Württemberg, insbesondere vollständige und dauerhaft unveränderte Bereitstellung sowie freie Zugänglichkeit im Internet unter der Adresse „www.baden-wuerttemberg.de/gesetzblatt” mit der Ermöglichung des unentgeltlichen Lesens, Speicherns und Ausdruckens; Versehung jeder Ausgabe des Gesetzblatts mit dem Datum der Bereitstellung zum Abruf und mit einem qualifizierten elektronischen Siegel von der herausgebenden Stelle; Erstellung eines beglaubigten Ausdrucks jeder Ausgabe des Gesetzblatts mit Ablieferung an das Landesarchiv Baden-Württemberg und dortiger Archivierung; Möglichkeit des kostenpflichtigen Bezugs von Ausdrucken des Gesetzblatts bei der herausgebenden oder einer von ihr benannten Stelle; Anpassung der Vorschriften zur Ersatzverkündung und zur Niederlegung, insbesondere Schaffung einer Rechtsgrundlage zur Verweisung auf öffentlich abrufbare, digitale Pläne, Karten oder andere zeichnerische Darstellungen als Bestandteile der verkündeten Verordnung sowie Einführung der Möglichkeit der Ersatzverkündung im Falle einer nicht nur kurzzeitigen technischen Störung"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
			<int key="@@index" value="86763"/>
			<date key="DokDat" value="2023-07-25T00:00:00+00:00"/>
			<date key="DokDat_original" value="2023-07-25T00:00:00+00:00"/>
		</event>
