			<string key="DokNr" value="16/3484"/>
			<string key="Urheber" value="Alternative für Deutschland (AfD)"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/3000/16_3484_D.pdf"/>
