			<string key="Desk" value="Hochschulreform"/>
			<string key="Titel" value="Gesetz zur Änderung hochschulrechtlicher Vorschriften"/>
			<string key="DokNr" value="12/4404"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP12/Drucksachen/4000/12_4404_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 23.09.1999 Drucksache 12/4404  (409 S.)"/>
			<string key="Su" value="409"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Stärkung der (Finanz-)Autonomie der Hochschulen, Einführung von Globalhaushalten, Kosten-Nutzen-Rechnung und Controlling sowie der leistungsorientierten Mittelzuweisung an den Hochschulen; Delegation und Deregulierung von Aufgaben; Änderung der Organstrukturen, Einführung von Hochschulräten an Universitäten, Fachhochschulen, Pädagogischen Hochschulen, Kunst- und Musikhochschulen; Evaluation der Leistungen; Förderung des akademischen Mittelbaus sowie der Gleichberechtigung von Frauen; Ermöglichung international anerkannter Abschlüsse und Prüfungsleistungen sowie eines Teilzeitstudiums; Exmatrikulation nach dem 20. Semester; Änderung des Universitätsgesetzes, des Fachhochschulgesetzes, des Kunsthochschulgesetzes, des Berufsakademiegesetzes, des Hochschulgebührengesetzes, des Hochschulzulassungsgesetzes, des Universitätsklinikagesetzes, des Gesetzes über die Pädagogischen Hochschulen, des Juristenausbildungsgesetzes, des Personalvertretungsgesetzes, des Frauenförderungsgesetzes sowie des Ernennungsgesetzes"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
