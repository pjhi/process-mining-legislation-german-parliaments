			<string key="Titel" value="Gesetz zur Neuregelung der Anerkennung von Gütestellen im Sinne von § 794 Absatz 1 Nummer 1 der Zivilprozessordnung"/>
			<string key="DokNr" value="16/4342"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/4000/16_4342_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 03.07.2018 Drucksache 16/4342  (36 S.)"/>
			<string key="Su" value="36"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Effektivere Gestaltung der baden-württembergischen Regelungen zur Anerkennung der Gütestellen zur Sicherstellung einer hohen Qualität der außergerichtlichen Streitbeilegung angesichts der Möglichkeit der Gütestellen zur Abfassung vollstreckbarer zivilrechtlicher Vergleiche; genauere Regelung der Anerkennungsvoraussetzungen und des Anerkennungsverfahrens; Vorgaben an die Verfahrensordnung der Gütestellen; Haftpflichtversicherungspflicht für die Gütestellen; Konzentration der  Zuständigkeit für die Anerkennung und die Aufsicht bei drei Landgerichten"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
