			<string key="Titel" value="Gesetz zur Verbesserung der Cybersicherheit und Änderung anderer Vorschriften"/>
			<string key="DokNr" value="16/9490"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/9000/16_9490_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 08.12.2020 Drucksache 16/9490  (112 S.)"/>
			<string key="Su" value="112"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Errichtung der Landesoberbehörde Cybersicherheitsagentur Baden-Württemberg zur Verbesserung der Cybersicherheit sowie Regelung deren Aufgaben und Befugnisse, insbesondere Unterstützung der öffentlichen Stellen als Ergänzung zu den bereits bestehenden Strukturen im Bereich der Informationssicherheit, Durchführung von Untersuchungen bei öffentlichen Stellen des Landes zur umfassenden Förderung der Cybersicherheit, Wiederherstellung der Sicherheit oder Funktionsfähigkeit informationstechnischer Systeme sowie Durchsetzung von Standards und Maßnahmen, Betrieb einer zentralen Koordinierungs- und Meldestelle, Beratung nichtöffentlicher Stellen in Einzelfällen und Unterstützung bei Sicherheitsvorfällen, Sensibilisierung der Bürger zu Themen der Cybersicherheit, Ermöglichung der Zulassung von Sitzungen in digitaler Form in bestimmten Fällen durch die Komm.ONE"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
