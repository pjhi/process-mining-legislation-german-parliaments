			<string key="Titel" value="Gesetz zur Änderung des Polizeigesetzes"/>
			<string key="DokNr" value="14/3165"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP14/Drucksachen/3000/14_3165_D.pdf"/>
