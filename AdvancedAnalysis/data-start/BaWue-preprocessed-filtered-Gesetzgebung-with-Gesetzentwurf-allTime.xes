		<string key="VorgangsDeskriptoren" value="[&apos;Ausbildungs- und Prüfungsordnung für amtliche Fachassistenten&apos;, &apos;Ausbildungs- und Prüfungsordnung für den gehobenen feuerwehrtechnischen Dienst&apos;, &apos;Ausbildungs- und Prüfungsordnung für den gehobenen Verwaltungsdienst&apos;, &apos;Ausbildungs- und Prüfungsordnung für den höheren bautechnischen Verwaltungsdienst&apos;, &apos;Ausbildungs- und Prüfungsordnung für den höheren feuerwehrtechnischen Dienst&apos;, &apos;Ausbildungs- und Prüfungsordnung für den mittleren feuerwehrtechnischen Dienst&apos;, &apos;Ausbildungs- und Prüfungsordnung für den mittleren Gerichtsvollzieherdienst&apos;, &apos;Ausbildungs- und Prüfungsordnung für den mittleren Verwaltungsdienst&apos;, &apos;Ausbildungs- und Prüfungsordnung für Lebensmittelkontrolleurinnen und Lebensmittelkontrolleure&apos;, &apos;Ausbildungs- und Prüfungsordnung Straßenmeisterdienst&apos;, &apos;Ausbildungs- und Prüfungsverordnung Arbeitserziehung&apos;, &apos;Ausbildungs- und Prüfungsverordnung Heilerziehungsassistenz&apos;, &apos;Ausländerintegration&apos;, &apos;Ausländischer Student&apos;, &apos;Elternrecht&apos;, &apos;Erzieherverordnung&apos;, &apos;Gleichbehandlungsgrundsatz&apos;, &apos;Heilerziehungspflegeverordnung&apos;, &apos;Hochschule&apos;, &apos;Hochschulrecht&apos;, &apos;Islam&apos;, &apos;Jugend- und Heimerzieherverordnung&apos;, &apos;Partizipations- und Integrationsgesetz für Baden-Württemberg&apos;, &apos;Psychisch-Kranken-Hilfe-Gesetz&apos;, &apos;Schulgesetz für Baden-Württemberg&apos;, &apos;Strafvollzug&apos;, &apos;Studierendenwerksgesetz&apos;, &apos;Verordnung des Kultusministeriums zur Übertragung von Zuständigkeiten nach dem Landesbeamtengesetz, nach dem Landesreisekostengesetz, der Landestrennungsgeldverordnung und dem Landesdisziplinargesetz im Kultusressort&apos;, &apos;Verordnung des Kultusministeriums über die Ausbildung und Prüfung von Fachlehrkräften für musisch-technische Fächer an Pädagogischen Fachseminaren&apos;]"/>
		<string key="VTyp" value="Gesetz"/>
		<string key="VTypL" value="Gesetzgebung"/>
		<string key="DHerk" value="BW"/>
		<string key="DHerkL" value="Baden-Württemberg"/>
		<int key="@@case_index" value="20980"/>
		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="2015-10-13T02:00:00.000+02:00"/>
			<string key="@id" value="D-106629"/>
			<int key="ReihNr" value="0001"/>
