			<int key="Wp" value="17"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTypL" value="Gesetzentwurf"/>
			<string key="Desk" value="Sozialgerichtsbarkeit"/>
			<string key="Titel" value="Gesetz zur Änderung des Ausführungsgesetzes zum Sozialgerichtsgesetz und zur Änderung weiterer Vorschriften"/>
			<string key="DokNr" value="17/6213"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP17/Drucksachen/6000/17_6213_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 06.02.2024 Drucksache 17/6213  (34 S.)"/>
			<string key="Su" value="34"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Änderung von Zuständigkeiten innerhalb der baden-württembergischen Sozialgerichtsbarkeit mit Blick auf eine effektive Verfahrenserledigung, insbesondere Zuständigkeitskonzentration für Vertragsarztangelegenheiten beim Sozialgericht Stuttgart, Aufhebung der bestehenden Zuständigkeitskonzentration für Angelegenheiten der Knappschaftsversicherung einschließlich der Unfallversicherung für den Bergbau beim Sozialgericht Freiburg; Einführung des Behördenprinzips in Streitigkeiten disziplinargerichtlicher Art in Notarsachen aus Vereinfachungsgründen als Gleichlauf zur Rechtslage in verwaltungsrechtlichen Notarsachen; Anhebung einzelner Gebührensätze im Landesjustizkostengesetz in Anpassung an die allgemeine Preisentwicklung; Einführung einzelner neuer Gebührentatbestände im Bereich notarrechtlicher Verwaltungsangelegenheiten; Bereinigung und Angleichung verschiedener Landesgesetze und -verordnungen im Zuständigkeitsbereich des Justizministeriums an Rechtsänderungen im Landes- und Bundesrecht"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
