			<string key="Desk" value="Landtagswahlgesetz"/>
			<string key="Titel" value="Gesetz zur Änderung des Landtagswahlgesetzes"/>
			<string key="DokNr" value="13/3680"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP13/Drucksachen/3000/13_3680_D.pdf"/>
