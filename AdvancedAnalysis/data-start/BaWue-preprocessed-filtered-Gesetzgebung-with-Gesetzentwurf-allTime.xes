			<string key="Titel" value="Gesetz zur Reform der Studentenwerke und zur Änderung der Landeshochschulgesetze"/>
			<string key="DokNr" value="12/3970"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP12/Drucksachen/3000/12_3970_D.pdf"/>
