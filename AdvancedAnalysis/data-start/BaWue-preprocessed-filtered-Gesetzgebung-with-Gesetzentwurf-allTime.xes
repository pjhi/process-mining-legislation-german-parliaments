			<string key="Titel" value="Gesetz zur Änderung des Gemeindewirtschaftsrechts"/>
			<string key="DokNr" value="13/4767"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP13/Drucksachen/4000/13_4767_D.pdf"/>
