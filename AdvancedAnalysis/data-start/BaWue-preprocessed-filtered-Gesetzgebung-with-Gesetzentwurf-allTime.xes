			<string key="Desk" value="Polizeistrukturgesetz 2020"/>
			<string key="Titel" value="Gesetz zur Umsetzung der Polizeistruktur 2020 (Polizeistrukturgesetz 2020 &amp;minus; PolSG2020)"/>
			<string key="DokNr" value="16/5603"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/5000/16_5603_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 29.01.2019 Drucksache 16/5603  (23 S.)"/>
			<string key="Su" value="23"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Optimierung der Orts- und Bürgernähe der Polizei durch Umsetzung der Ergebnisse eines Evaluationsberichts vom April 2017 zur Polizeistrukturreform von 2013, insbesondere Änderung der äußeren Aufbauorganisation der Polizei Baden-Württemberg durch das so genannte &quot;13er-Modell&quot; im Bereich der regionalen Polizeipräsidien mit Wirkung zum 1. Januar 2020, Auflösung des Polizeipräsidiums Tuttlingen, Veränderung des regionalen Zuschnitts der Polizeipräsidien Karlsruhe, Konstanz und Reutlingen, Neubildung der Polizeipräsidien Pforzheim und Ravensburg"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
