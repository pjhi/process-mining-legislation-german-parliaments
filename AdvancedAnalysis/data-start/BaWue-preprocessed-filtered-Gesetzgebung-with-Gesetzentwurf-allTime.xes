			<string key="Su" value="37"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Einführung einer flexiblen Listenwahl; Bewahrung der nach Regionen orientierten Mandatsverteilung; Differenzierung zwischen Direkt- und Parteistimme; Ermöglichung von Kumulieren und Panaschieren; Einführung einer indirekten Quotenregelung; Verpflichtung der Parteien zu einer 50-Prozent-Quote von Frauen bei den Regional-Wahlvorschlägen; voller Ausgleich der Überhangmandate durch Einführung des Niemeyer-Auszählsystems; Abschaffung der 5-Prozent-Klausel; Einführung einer Inkompatibilitätsregelung, Unvereinbarkeit von Amt (vom Bürgermeister bis zum Ministerpräsidenten) und Mandat(en)"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
