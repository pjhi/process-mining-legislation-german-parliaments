			<string key="Titel" value="Gesetz zur Änderung des Schulgesetzes für Baden-Württemberg"/>
			<string key="DokNr" value="12/1854"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP12/Drucksachen/1000/12_1854_D.pdf"/>
