		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="2019-03-26T01:00:00.000+01:00"/>
			<string key="@id" value="D-127831"/>
			<int key="ReihNr" value="0001"/>
			<int key="Wp" value="16"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTypL" value="Gesetzentwurf"/>
			<string key="Desk" value="Datenschutz"/>
			<string key="Titel" value="Gesetz zur Anpassung des besonderen Datenschutzrechts an die Verordnung (EU) 2016/679 und zur Umsetzung der Richtlinie (EU) 2016/680 für Justiz- und Bußgeldbehörden sowie zur Änderung vollzugsrechtlicher Gesetze"/>
			<string key="DokNr" value="16/5984"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/5000/16_5984_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 26.03.2019 Drucksache 16/5984  (163 S.)"/>
			<string key="Su" value="163"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Änderung des bereichsspezifischen Datenschutzrechts zur Umsetzung der Richtlinie (EU) 2016/680; Erlass eines subsidiär geltenden Datenschutzgesetzes für die justizverwaltende Datenverarbeitung der ordentlichen Gerichte in Strafsachen und der Staatsanwaltschaften zur Umsetzung der Vorgaben der Richtlinie (EU) 2016/680 mit Geltung für die Verarbeitung personenbezogener Daten zur Ahndung und Vollstreckung von Ordnungswidrigkeiten durch alle öffentlichen Stellen des Landes; Schaffung einer grundrechts- und datenschutzkonformen Rechtsgrundlage für den Einsatz der sogenannten Mithörfunktion bei mobilen Alarmgeräten; Ergänzungen des vollzuglichen Datenschutzrechts vor allem hinsichtlich des Auslesens von Datenspeichern, der elektronischen Aufenthaltsüberwachung sowie zur Verbesserung des Datenaustauschs mit den Sicherheitsbehörden zur Abwehr insbesondere extremistischer Bestrebungen und Radikalisierungsrisiken; Neufassungen der vollzuglichen Vorschriften über Fixierungen und Zwangsmaßnahmen in der Gesundheitsfürsorge zur Umsetzung der Vorgaben des Bundesverfassungsgerichts"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
			<int key="@@index" value="5965"/>
			<date key="DokDat" value="2019-03-26T00:00:00+00:00"/>
			<date key="DokDat_original" value="2019-03-26T00:00:00+00:00"/>
		</event>
