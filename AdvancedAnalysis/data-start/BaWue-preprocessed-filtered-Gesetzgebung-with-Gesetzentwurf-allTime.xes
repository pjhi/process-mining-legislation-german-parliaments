			<string key="Su" value="20"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Erhöhung der Zahl der Beisitzer in den Wahlvorständen; Ermöglichung der Anlage von Wahlhelferdateien; Ersetzung der öffentlichen Auslegung durch ein Recht auf Einsichtnahme in das Wählerverzeichnis; Vorverlegung der Termine für die Einreichung, Zulassung und Bekanntmachung der Wahlvorschläge; Abschaffung der amtlichen Wahlumschläge bei der Urnenwahl; Erweiterung der Verordnungsermächtigung zur Lage der Wahlräume und zum Verbot der Wahlwerbung im Wahllokal; Erstattung der Kosten der Stimmzettelschablonen an die Blindenvereine; Mitwirkung des Statistischen Landesamts"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
