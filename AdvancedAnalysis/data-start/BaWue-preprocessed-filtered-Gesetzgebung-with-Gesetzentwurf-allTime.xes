			<string key="Urheber" value="BÜNDNIS 90/DIE GRÜNEN (GRÜNE)"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP10/Drucksachen/2000/10_2376_D.pdf"/>
