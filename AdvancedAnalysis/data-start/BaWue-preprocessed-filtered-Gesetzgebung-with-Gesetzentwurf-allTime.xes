		<string key="VorgangsDeskriptoren" value="[&apos;Bayern&apos;, &apos;Collenberg&apos;, &apos;Landesstraße 2310&apos;, &apos;Main&apos;, &apos;Staatsstraße 2315&apos;, &apos;Staatsvertrag&apos;, &apos;Straßenbau&apos;, &apos;Straßenbauverwaltung&apos;, &apos;Verkehrswegebau&apos;, &apos;Wertheim&apos;]"/>
		<string key="VTyp" value="Gesetz"/>
		<string key="VTypL" value="Gesetzgebung"/>
		<string key="DHerk" value="BW"/>
		<string key="DHerkL" value="Baden-Württemberg"/>
		<int key="@@case_index" value="6934"/>
		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="2021-01-09T01:00:00.000+01:00"/>
			<string key="@id" value="D-142385"/>
			<int key="ReihNr" value="0001"/>
			<int key="Wp" value="16"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTypL" value="Gesetzentwurf"/>
			<string key="Desk" value="Brücke"/>
			<string key="Titel" value="Gesetz zu dem Staatsvertrag zwischen dem Land Baden-Württemberg und dem Freistaat Bayern über die Planfeststellungen für die Maßnahmen &quot;Verlegung der L 2310 neu / St 2315 bei Collenberg (Ortsteil Kirschfurt) mit Neubau einer Mainbrücke&quot; sowie &quot;Ersatzneubau der Brücke über den Main bei Wertheim – Kreuzwertheim&quot;"/>
			<string key="DokNr" value="16/9921"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/9000/16_9921_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 09.01.2021 Drucksache 16/9921  (13 S.)"/>
			<string key="Su" value="13"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Übertragung der hoheitlichen Befugnis zum Tätigwerden für die konkreten Verfahren auf dem Gebiet des Landes Baden-Württemberg auf den Freistaat Bayern auf staatsvertraglicher Grundlage, insbesondere Durchführung der Planung und der hierfür erforderlichen Planfeststellungsverfahren der beiden länderübergreifenden Maßnahmen „Verlegung der L 2310 neu / St 2315 bei Collenberg (Ortsteil Kirschfurt) mit Neubau einer Mainbrücke“ sowie „Ersatzneubau der Brücke über den Main bei Wertheim – Kreuzwertheim“ unter Federführung der Bayerischen Staatsbauverwaltung, Vereinbarung zur Durchführung des Planfeststellungsverfahrens ausschließlich nach den für die bayerische Straßenbauverwaltung gültigen Vorschriften und Richtlinien, Legitimierung der Bayerischen Staatsbauverwaltung zur ausschließlichen Anwendung bayerischen Recht für die Durchführung beider Maßnahmen – auch auf baden-württembergischem Hoheitsgebiet"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
			<int key="@@index" value="13869"/>
			<date key="DokDat" value="2021-01-09T00:00:00+00:00"/>
			<date key="DokDat_original" value="2021-09-01T00:00:00+00:00"/>
		</event>
