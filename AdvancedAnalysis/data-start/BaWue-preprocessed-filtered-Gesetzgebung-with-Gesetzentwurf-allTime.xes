			<string key="DokNr" value="14/6567"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP14/Drucksachen/6000/14_6567_D.pdf"/>
