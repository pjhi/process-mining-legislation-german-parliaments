			<string key="Desk" value="Schule"/>
			<string key="Titel" value="Gesetz zur Änderung des Schulgesetzes für Baden-Württemberg"/>
			<string key="DokNr" value="14/3179"/>
			<string key="Urheber" value="Sozialdemokratische Partei Deutschlands (SPD)"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP14/Drucksachen/3000/14_3179_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Fraktion der SPD 29.08.2008 Drucksache 14/3179  (9 S.)"/>
			<string key="Su" value="9"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Festschreibung der individuellen Förderung als durchgängiges Unterrichtsprinzip in allen Schulen; Verlängerung der Grundschulzeit auf bis zu sechs Jahre; Aufhebung der Grundschulempfehlung sowie der Hauptschulbezirke; Zusammenschluss der Haupt- und Realschulen zu Gemeinschaftsschulen, Angebot des Realschulabschlusses als Regelabschluss, Ermöglichung der Angliederung eines gymnasialen Zweigs; Einräumung des Anspruchs der Schulträger auf Genehmigung kommunaler Schulkonzepte, Genehmigung der Anträge auf Einrichtung von Ganztagsschulen für alle Schularten sowie der Zusammenschlüsse von Schulträgern zu einem Schulverband"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
