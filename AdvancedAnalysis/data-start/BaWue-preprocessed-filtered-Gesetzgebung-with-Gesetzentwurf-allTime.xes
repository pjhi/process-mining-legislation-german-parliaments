			<string key="Desk" value="Abgeordnetengesetz (Baden-Württemberg)"/>
			<string key="Titel" value="Gesetz zur Änderung des Abgeordnetengesetzes und des Gesetzes über die Rechtsstellung und Finanzierung der Fraktionen im Landtag von Baden-Württemberg"/>
			<string key="DokNr" value="16/4452"/>
			<string key="Urheber" value="Alternative für Deutschland (AfD)"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/4000/16_4452_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Fraktion der AfD 11.07.2018 Drucksache 16/4452  (11 S.)"/>
			<string key="Su" value="11"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Änderung der Bestimmungen zur Kostenerstattung bei Arbeits-, Dienst- und Werkverträgen zur Unterstützung der parlamentarischen Arbeit in § 6 des Abgeordnetengesetzes und entsprechend den Bestimmungen zu den Leistungen an Fraktionen nach § 2 Absatz 2 des Fraktionsgesetzes, insbesondere Beschränkung der Kostenerstattung und Stellung für aufgrund ihrer strafrechtlichen Vorbelastung eine Gefährdung des Parlamentsbetriebs besorgen lassenden Personen, Einschränkung der Kostenerstattung bei verwandtschaftlichem, privatem oder sonstigem wirtschaftlichen Näheverhältnis"/>
			<string key="VkDat" value="NaT"/>
