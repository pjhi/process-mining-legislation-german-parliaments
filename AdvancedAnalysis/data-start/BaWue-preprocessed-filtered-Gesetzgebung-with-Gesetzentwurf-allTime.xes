			<string key="Titel" value="Gesetz zur Änderung kommunalverfassungsrechtlicher Vorschriften"/>
			<string key="DokNr" value="15/7265"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP15/Drucksachen/7000/15_7265_D.pdf"/>
