		<event>
			<string key="lifecycle:transition" value="complete"/>
			<date key="time:timestamp" value="1996-11-27T01:00:00.000+01:00"/>
			<string key="@id" value="D-48704"/>
			<int key="ReihNr" value="0001"/>
			<int key="Wp" value="12"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTypL" value="Gesetzentwurf"/>
			<string key="Desk" value="Haushaltsstrukturgesetz 1997"/>
			<string key="Titel" value="Haushaltsstrukturgesetz 1997"/>
			<string key="DokNr" value="12/704"/>
			<string key="Urheber" value="[&apos;Christlich-Demokratische Union (CDU)&apos;, &apos;Freie Demokratische Partei / Demokratische Volkspartei (FDP/DVP)&apos;]"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP12/Drucksachen/0000/12_0704_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Fraktion der CDU, Fraktion der FDP/DVP 27.11.1996 Drucksache 12/704  (25 S.)"/>
			<string key="Su" value="25"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Fortführung der strukturellen Einsparmaßnahmen; Reduzierung von Aufgaben und Zuschüssen gegenüber den Kommunen; Streichung des Deckungsbeitrags an die Gemeindeprüfungsanstalt; Kürzung der Zuschüsse an die Regionalverbände; Kürzung der Schülerbeförderungskostenerstattung um 100 Mio DM; Reduzierung der Kostenerstattung für die Aufnahme von Spätaussiedlern; Erhöhung der Eigenbeteiligung bei der Beihilfe; Erhebung von Gebühren für die Immatrikulation und Rückmeldung an Hochschulen und für die Zulassung an Berufsakademien; Kürzung der Zuschüsse an Privatschulen bzw. deren Schulhausbau; Gebührenerhebung für Grundschulförderklassen; Mittelstreichung bei den Heimsonderschulen; Abschöpfung von 40 Mio DM aus dem Aufkommen der Feuerschutzsteuer 1997; Umfang der Festschreibung der nach dem Spielbankengesetz 1997 zweckgebunden zu verwendenden Einnahmen sowie der Ausstattung des Wettmittelfonds; Änderung folgender Gesetze und Verordnungen: Feuerwehrgesetz, Eingliederungsgesetz, Gemeindeprüfungsanstaltsgesetz, Privatschulgesetz, Schulgesetz für Baden-Württemberg, Kinder- und Jugendhilfegesetz für Baden-Württemberg, Universitätsgesetz, Gesetz über die Pädagogischen Hochschulen, Kunsthochschulgesetz, Fachhochschulgesetz, Berufsakademiegesetz, Landesplanungsgesetz, Spielbankengesetz, Wettmittelfonds, Finanzausgleichsgesetz und der Beihilfeverordnung; Kompensation der Belastungen durch das Gemeindehaushaltsstrukturgesetz"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
			<int key="@@index" value="86272"/>
			<date key="DokDat" value="1996-11-27T00:00:00+00:00"/>
			<date key="DokDat_original" value="1996-11-27T00:00:00+00:00"/>
		</event>
