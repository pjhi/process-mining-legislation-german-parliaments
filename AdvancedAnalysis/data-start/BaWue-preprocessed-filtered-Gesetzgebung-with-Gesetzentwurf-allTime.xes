			<string key="Titel" value="Gesetz zur Änderung des Schulgesetzes für Baden-Württemberg und des Landespflegegesetzes"/>
			<string key="DokNr" value="17/5610"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP17/Drucksachen/5000/17_5610_D.pdf"/>
