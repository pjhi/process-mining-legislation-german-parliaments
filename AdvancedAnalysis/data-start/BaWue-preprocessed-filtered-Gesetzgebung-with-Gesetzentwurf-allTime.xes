		<string key="VorgangsDeskriptoren" value="[&apos;Akustische Überwachung&apos;, &apos;Datenaustausch&apos;, &apos;Datenverarbeitung&apos;, &apos;Elektronische Fußfessel&apos;, &apos;Gesetz zur Ausführung der Verwaltungsgerichtsordnung&apos;, &apos;Gesetz zur Ausführung des Betreuungsgesetzes&apos;, &apos;Grundrecht&apos;, &apos;Jugendarrestgesetz&apos;, &apos;Juristenausbildungsgesetz&apos;, &apos;Justizverwaltung&apos;, &apos;Justizvollzugsgesetzbuch&apos;, &apos;Landesdatenschutzgesetz für Justiz- und Bußgeldbehörden&apos;, &apos;Landesgesetz über die freiwillige Gerichtsbarkeit&apos;, &apos;Landesrichter- und -staatsanwaltsgesetz&apos;, &apos;Ordentliche Gerichtsbarkeit&apos;, &apos;Ordnungswidrigkeit&apos;, &apos;Personenbezogene Daten&apos;, &apos;Persönliche Freiheit&apos;, &apos;Recht auf körperliche Unversehrtheit&apos;, &apos;Staatsanwaltschaft&apos;, &apos;Strafgerichtsbarkeit&apos;, &apos;Strafvollzug&apos;, &apos;Telekommunikationsüberwachung&apos;, &apos;Unverletzlichkeit der Wohnung&apos;, &apos;Zwangsbehandlung&apos;]"/>
		<string key="VTyp" value="Gesetz"/>
