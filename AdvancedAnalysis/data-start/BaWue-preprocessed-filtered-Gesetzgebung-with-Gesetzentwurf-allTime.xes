			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTypL" value="Gesetzentwurf"/>
			<string key="Desk" value="Hochschulrecht"/>
			<string key="Titel" value="Zweites Gesetz zur Änderung hochschulrechtlicher Vorschriften (Zweites Hochschulrechtsänderungsgesetz &amp;minus; 2. HRÄG)"/>
			<string key="DokNr" value="13/3640"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP13/Drucksachen/3000/13_3640_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 06.10.2004 Drucksache 13/3640  (380 S.)"/>
			<string key="Su" value="380"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Zusammenfassung der bisherigen vier getrennten Hochschulgesetze, Universitätsgesetz, Gesetz über die Pädagogischen Hochschulen, Kunsthochschulgesetz sowie Fachhochschulgesetz, zu einem einheitlichen Landeshochschulgesetz; Integration des bisher eigenständigen Berufsakademiegesetzes; Übertragung des Berufungsrechts, Einführung der Juniorprofessur, Neuordnung der Personalstruktur für den wissenschaftlichen Nachwuchs; Regelung der Zusammensetzung, Wahl und Kompetenzen von Aufsichtsrat und Vorstand; Einführung einer gestuften Studienstruktur mit Bachelor- und Masterstudiengängen; Neufassung des Landeshochschulgebührengesetzes; Änderung folgender Rechtsvorschriften: Hochschulzulassungsgesetz, Universitätsklinika-Gesetz, Studentenwerksgesetz, Jursitenausbildungsgesetz, Landespersonalvertretungsgesetz, Ernennungsgesetz, Landesbeamtengesetz, Landesbesoldungsgesetz, Ausführungsgesetz zum Bundesausbidlungsförderungsgesetz, Kindergartenfachkräftegesetz, Betreuungsgesetz, Film- und Popakademiegesetz, Film- und Popakademie-Zuständigkeits- und Gebührenverordnung, Lehrverpflichtungsverordnung für Universitäten, Pädagogische Hochschulen und Fachhochschulen, Lehrverpflichtungsverordnung für Kunsthochschulen, Juristenausbildungs- und Prüfungsordnung, Hochschulnebentätigkeitsverordnung, Laufbahnverordnung, Urlaubsverordnung, Beurteilungsverordnung; Außerkrafttreten von Rechtsvorschriften; Übergangsbestimmungen"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
