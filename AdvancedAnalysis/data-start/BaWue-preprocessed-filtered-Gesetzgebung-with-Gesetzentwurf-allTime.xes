			<string key="Desk" value="Bürgerbeteiligung"/>
			<string key="Titel" value="Gesetz zur Änderung der Gemeindeordnung und der Landkreisordnung"/>
			<string key="DokNr" value="11/2643"/>
			<string key="Urheber" value="Freie Demokratische Partei / Demokratische Volkspartei (FDP/DVP)"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP11/Drucksachen/2000/11_2643_D.pdf"/>
