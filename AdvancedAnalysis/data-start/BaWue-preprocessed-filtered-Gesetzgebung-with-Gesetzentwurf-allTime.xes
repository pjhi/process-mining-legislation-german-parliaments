			<string key="Titel" value="Gesetz zur Änderung der Landesbauordnung für Baden-Württemberg"/>
			<string key="DokNr" value="15/5294"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP15/Drucksachen/5000/15_5294_D.pdf"/>
