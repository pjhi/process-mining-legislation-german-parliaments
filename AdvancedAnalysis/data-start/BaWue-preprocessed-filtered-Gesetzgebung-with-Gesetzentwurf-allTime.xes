			<string key="Titel" value="Gesetz zur Reform der Hochschulmedizin (Hochschulmedizinreform-Gesetz &amp;minus; HMG)"/>
			<string key="DokNr" value="12/1740"/>
			<string key="Urheber" value="Landesregierung"/>
