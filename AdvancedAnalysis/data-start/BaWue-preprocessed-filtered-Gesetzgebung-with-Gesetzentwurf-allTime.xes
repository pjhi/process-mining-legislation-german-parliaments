			<string key="DokNr" value="14/7313"/>
			<string key="Urheber" value="[&apos;Christlich-Demokratische Union (CDU)&apos;, &apos;Freie Demokratische Partei / Demokratische Volkspartei (FDP/DVP)&apos;]"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP14/Drucksachen/7000/14_7313_D.pdf"/>
