			<string key="Titel" value="Gesetz zur Änderung des Landesverwaltungsverfahrensgesetzes und des Landesverwaltungsvollstreckungsgesetzes"/>
			<string key="DokNr" value="10/4374"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP10/Drucksachen/4000/10_4374_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 22.11.1990 Drucksache 10/4374  (32 S.)"/>
			<string key="Su" value="32"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Ergänzung des Landesverwaltungsverfahrensgesetzes um Regelungen über den Widerruf eines begünstigenden Verwaltungsaktes auch mit Vergangenheitswirkung sowie über die Erstattung bereits erbrachter Leistungen und Verzinsung des Erstattungsbetrages, Anwendung einzelner Vorschriften auch für kommunalabgabenrechtliche Verfahren, Umsetzung des neuen Betreuungsgesetzes; Erweiterung des Geltungsbereichs des Landesverwaltungsvollstreckungsgesetzes, Bestimmung der für die Vollstreckungshilfe zuständigen Behörden, Erleichterung der länderübergreifenden Vollstreckung sowie der Abgabe der eidesstattlichen Versicherung, stärkere Einbeziehung der Gemeinden in die Vollstreckung; Änderung der Landeshaushaltsordnung, des Landeskrankenhausgesetzes, des Rettungsdienstgesetzes, des Landesverwaltungszustellungsgesetzes und Studentenwerksgesetzes"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
