			<string key="Desk" value="Beamtenrecht"/>
			<string key="Titel" value="Gesetz zur Änderung des Landesbeamtengesetzes und anderer Vorschriften"/>
			<string key="DokNr" value="15/7552"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP15/Drucksachen/7000/15_7552_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 13.10.2015 Drucksache 15/7552  (92 S.)"/>
			<string key="Su" value="92"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Ermöglichung der freiwilligen Weiterarbeit über die allgemeine Regelaltersgrenze hinaus bis zur Vollendung des 70. Lebensjahres; Rückführung der besonderen Altersgrenze für den Eintritt in den Ruhestand für die Beamten des Einsatzdienstes der Feuerwehr auf den Rechtsstand vor der Dienstrechtsreform; Verbesserung der Vereinbarkeit von Familie, Pflege und Beruf für Beamte durch die wirkungsgleiche Übertragung entsprechender Regelungen für Tarifbeschäftigte; weitere Flexibilisierung des Laufbahnrechts bei Regelungen zu den Bildungsvoraussetzungen für den mittleren Dienst sowie durch Anrechnung von Zeiten in Freiwilligendiensten auf die Probezeit; Änderung von § 62 des Dienstrechtsreformgesetzes in der Fassung vom 9. November 2010; Änderung der §§ 23 und 27 des Landesbeamtenversorgungsgesetzes Baden-Württemberg in der Fassung vom 21. Juli 2015; Änderung der §§ 1 und 39 des Landesdisziplinargesetzes in der Fassung vom 9. November 2010; Änderung der §§ 7 und 87 des Landesrichter- und -staatsanwaltsgesetzes in der Fassung vom 3. Dezember 2013; Änderung der §§ 17, 22, 24, 29 und 48 der Arbeitszeit- und Urlaubsverordnung in der Fassung vom 28. Juli 2015; Änderung von § 1 der Beamtenrechtszuständigkeitsverordnung in der Fassung vom 25. November 2014; Änderung von § 1 der Verordnung des Kultusministeriums zur Übertragung von Zuständigkeiten nach dem Landesbeamtengesetz, nach dem Landesreisekostengesetz, der Landestrennungsgeldverordnung und dem Landesdisziplinargesetz im Kultusressort in der Fassung vom 5. Juni 2014"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
