			<string key="Titel" value="Gesetz zur Verwirklichung der Chancengleichheit von Frauen und Männern im öffentlichen Dienst in Baden-Württemberg und zur Änderung des Landeshochschulgesetzes"/>
			<string key="DokNr" value="15/7844 Geänderte Fassung"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP15/Drucksachen/7000/15_7844_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 08.12.2015 Drucksache 15/7844  (Geänderte Fassung) (84 S.)"/>
			<string key="Su" value="84"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Stärkung der tatsächlichen Durchsetzung der Gleichberechtigung von Frauen und Männern im öffentlichen Dienst in Baden-Württemberg, insbesondere Ablösung des bisherigen Chancengleichheitsgesetzes aus dem Jahr 2005, gezielte Förderung des beruflichen Vorankommens von Frauen in der Verwaltung, Verbesserung der Vereinbarkeit von Familien- und Pflegeaufgaben und Beruf für Frauen und Männer, Verpflichtung zur Bestellung von Gleichstellungsbeauftragten in Stadt- und Landkreisen und Städten ab 50.000 Einwohnern, Stärkung der Rechte der Beauftragten für Chancengleichheit; Änderung von § 20 des Landeshochschulgesetzes in der Fassung vom 1. April 2014"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
