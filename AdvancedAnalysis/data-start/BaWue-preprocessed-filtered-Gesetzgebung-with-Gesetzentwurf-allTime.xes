			<string key="DokNr" value="12/4794"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP12/Drucksachen/4000/12_4794_D.pdf"/>
