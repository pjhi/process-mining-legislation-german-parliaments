			<string key="Titel" value="Gesetz über den öffentlichen Gesundheitsdienst (Gesundheitsdienstgesetz &amp;minus; ÖGDG)"/>
			<string key="DokNr" value="11/4871"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP11/Drucksachen/4000/11_4871_D.pdf"/>
