			<string key="Desk" value="Gymnasium"/>
			<string key="Titel" value="Gesetz zur Einführung des neuen neunjährigen Gymnasiums in Baden-Württemberg (Gesetz zur Änderung des Schulgesetzes für Baden-Württemberg)"/>
			<string key="DokNr" value="16/5979"/>
			<string key="Urheber" value="Alternative für Deutschland (AfD)"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/5000/16_5979_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Fraktion der AfD 22.03.2019 Drucksache 16/5979  (11 S.)"/>
			<string key="Su" value="11"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Einführung einer grundständig neunjährigen Lernzeit am baden-württembergischen Gymnasium zur zeitlichen Entlastung der Schüler durch Reduzierung des Nachmittagsunterrichts und zur Stärkung inner- und außerschulischen Engagements; Schaffung der Möglichkeit zum Überspringen der 11. Jahrgangsstufe zur individuellen Lernzeitverkürzung für Schüler mit guten Leistungen; Ergänzung der Kontingentstundentafel zur Vertiefung der Allgemeinbildung und Sicherung der Studierfähigkeit um zusätzliche 18 Stunden in den Fächern Mathematik, Deutsch, erste Fremdsprache, Informatik, Geschichte und Naturwissenschaften"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
