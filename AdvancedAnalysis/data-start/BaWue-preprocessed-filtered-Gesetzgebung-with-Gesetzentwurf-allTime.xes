			<string key="Titel" value="Gesetz zur Neuordnung des Naturschutzrechts und zur Änderung weiterer Vorschriften"/>
			<string key="DokNr" value="13/4768"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP13/Drucksachen/4000/13_4768_D.pdf"/>
