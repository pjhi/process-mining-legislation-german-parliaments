			<string key="Titel" value="Gesetz zur Änderung des Landesbeamtenversorgungsgesetzes Baden-Württemberg und weiterer dienstrechtlicher Vorschriften"/>
			<string key="DokNr" value="17/5550"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP17/Drucksachen/5000/17_5550_D.pdf"/>
