			<string key="Titel" value="Haushaltsbegleitgesetz 2022"/>
			<string key="DokNr" value="17/1001"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP17/Drucksachen/1000/17_1001_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 26.10.2021 Drucksache 17/1001  (36 S.)"/>
			<string key="Su" value="36"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Redaktionelle Anpassung des Privatschulgesetzes; Verstetigung der finanziellen Grundlage für die über den Bedarf von Forst Baden-Württemberg hinausgehende Ausbildung von Forstwirten für Dritte im ForstBW-Gesetz; Anpassung von Anlage 1 des Landesbesoldungsgesetzes Baden-Württemberg; Änderung des Beteiligungsfondsgesetzes Baden-Württemberg mit dem Ziel der Entnahme nicht benötigter Mittel in Höhe von 980 000 000 Euro und deren Zuführung zu einer anderweitigen Verwendung; Verschiebung des Zensusstichtags und weitere Stichtage aufgrund der Auswirkungen der Covid-19-Pandemie durch Änderung des Gesetzes zur Ausführung des Zensusgesetzes 2021; Stabilisierung der Kommunalfinanzen des Jahres 2021 und Stärkung des Öffentlichen Gesundheitsdienstes  durch Änderungen im Finanzausgleichsgesetz"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
