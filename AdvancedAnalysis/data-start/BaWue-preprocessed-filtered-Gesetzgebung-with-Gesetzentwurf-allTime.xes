			<string key="Desk" value="Region"/>
			<string key="Titel" value="Gesetz über die Weiterentwicklung der Regionen und zur Änderung des Landesabfallgesetzes"/>
			<string key="DokNr" value="12/5877"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP12/Drucksachen/5000/12_5877_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 27.12.2000 Drucksache 12/5877  (32 S.)"/>
			<string key="Su" value="32"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Ausbau der Kompetenzen aller Regionalverbände nach dem Vorbild des VRS: Erweiterung des Planungsgebots, gebietsscharfe Ausweisung von Standorten für den regionalbedeutsamen großflächigen Einzelhandel, Klagerecht gegen Verwaltungsakte, die dem Regionalplan widersprechen, Ermöglichung der Übernahme von weisungsfreien Planungsaufgaben durch Vereinbarung mit Kommunen und Landkreisen, der Aufgabenübertragung auf Zweckverbände sowie der Mitgliedschaft in grenzüberschreitenden Zusammenschlüssen, Einräumung eines qualifizierten Anhörungsrechts bei der Abfallwirtschaftsplanung; Änderung des Landesplanungsgesetzes und Landesabfallgesetzes"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
