			<date key="time:timestamp" value="2024-04-16T02:00:00.000+02:00"/>
			<string key="@id" value="D-233035"/>
			<int key="ReihNr" value="0001"/>
			<int key="Wp" value="17"/>
			<string key="DokArt" value="Drs"/>
			<string key="DokArtL" value="Drucksache"/>
			<string key="DokTypL" value="Gesetzentwurf"/>
			<string key="Desk" value="Rettungsdienstgesetz"/>
			<string key="Titel" value="Neufassung des Gesetzes über den Rettungsdienst (Rettungsdienstgesetz &amp;minus; RDG)"/>
			<string key="DokNr" value="17/6611"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP17/Drucksachen/6000/17_6611_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 16.04.2024 Drucksache 17/6611  (145 S.)"/>
			<string key="Su" value="145"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Neufassung des Rettungsdienstgesetzes zur Verbesserung der Notfallversorgung und Erhöhung der Rechtssicherheit, insbesondere Festlegung der Planungsfrist als Planungsgrundlage auf eine Zeitdauer von zwölf Minuten und Aufnahme des planerisch anzustrebenden Zielerreichungsgrads, Stärkung der Rettungsdienststrukturen durch die gesetzliche Verankerung neuer Instrumente wie Telenotärztliches System oder digitaler Versorgungsnachweis, Erleichterung der Erprobung und Einführung innovativer Versorgungskonzepte durch eine Experimentierklausel, inhaltliche und organisatorische Ausgestaltung der im Notfallsanitätergesetz angelegten vorab und anhand von Standardarbeitsanweisungen durchgeführte Delegation von Heilbehandlungskompetenzen auf Notfallsanitäter, Stärkung der Qualitätssicherung, Erweiterung der Handlungsspielräume des Rettungsdienstes durch Ausnahmevorschriften in besonderen Notlagen wie Pandemien oder einem plötzlichen Unglücksereignis mit einer Vielzahl von Verletzten, Lockerung der starren Bestimmungen im Krankentransport bei außerhalb eines Betriebsbereiches liegenden Beförderungsfällen, Verordnungsermächtigungen für den Erlass des Rettungsdienstplanes und zur Regelung der Fördervoraussetzungen, Anpassung der datenschutzrechtlichen Vorschriften an die europarechtlichen Vorgaben"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
			<int key="@@index" value="119367"/>
			<date key="DokDat" value="2024-04-16T00:00:00+00:00"/>
