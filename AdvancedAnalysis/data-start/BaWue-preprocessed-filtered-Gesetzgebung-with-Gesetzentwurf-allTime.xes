			<string key="Desk" value="Katastrophenschutz"/>
			<string key="Titel" value="Gesetz zur Änderung des Landeskatastrophenschutzgesetzes"/>
			<string key="DokNr" value="09/3592"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP09/Drucksachen/3000/09_3592_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Landesregierung 24.09.1986 Drucksache 9/3592  (51 S.)"/>
			<string key="Su" value="51"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Neufassung des Katastrophenbegriffs, Einführung eines &quot;Katastrophenvoralarms&quot;, Regelung einer direkten subsidiären Zuständigkeit des Polizeivollzugsdienstes gegenüber den Katastrophenschutzbehörden sowie der Zusammenarbeit mit den Leitstellen von Feuerwehr und Rettungsdienst, Klarstellung des Verhältnisses des Landes zu den Hilfsorganisationen, Verpflichtung der Ärzteschaft sowie der Betreiber gefährlicher Anlagen auf Mitwirkung im vorbereitenden Katastrophenschutz, Ausbau der Übungen"/>
