			<string key="Titel" value="Gesetz zur Neufassung des Landesreisekostengesetzes (LRKG)"/>
			<string key="DokNr" value="16/9448"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/9000/16_9448_D.pdf"/>
