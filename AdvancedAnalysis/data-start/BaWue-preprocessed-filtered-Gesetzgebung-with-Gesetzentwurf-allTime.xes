			<string key="Desk" value="Kinder- und Jugendhilfe"/>
			<string key="Titel" value="Gesetz zur Änderung des Landesjugendhilfegesetzes und des Jugendbildungsgesetzes"/>
			<string key="DokNr" value="11/6730"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP11/Drucksachen/6000/11_6730_D.pdf"/>
