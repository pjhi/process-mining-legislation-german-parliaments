			<string key="Titel" value="Gesetz über ein Transparenzregister (Transparenzregistergesetz &amp;minus; TRegG)"/>
			<string key="DokNr" value="16/9738"/>
			<string key="Urheber" value="[&apos;BÜNDNIS 90/DIE GRÜNEN (GRÜNE)&apos;, &apos;Christlich-Demokratische Union (CDU)&apos;, &apos;Sozialdemokratische Partei Deutschlands (SPD)&apos;, &apos;Freie Demokratische Partei / Demokratische Volkspartei (FDP/DVP)&apos;]"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP16/Drucksachen/9000/16_9738_D.pdf"/>
			<string key="FundSt" value="Baden-Württemberg - Gesetzentwurf Fraktion GRÜNE, Fraktion der CDU, Fraktion der SPD, Fraktion der FDP/DVP 18.01.2021 Drucksache 16/9738  (12 S.)"/>
			<string key="Su" value="12"/>
			<string key="Sb" value="nan"/>
			<string key="Redner" value="nan"/>
			<string key="Abstract" value="Einrichtung eines Transparenzregisters beim Landtag zur Eintragung von regelmäßig, auf Dauer angelegter oder im Auftrag Dritter Interessenvertretung gegenüber dem Landtag, den Fraktionen, den Mitgliedern, der Landesregierung oder einem ihrer Mitglieder betreibenden Organisationen und Verbänden; Festlegung von Pflichten integrer Interessenvertretung, insbesondere Registrierungspflicht für die Interessenvertretung betreibenden Verbände und Organisationen; Regelung der Kenntlichmachung der Einbeziehung von Organisationen, Verbänden und Sachverständigen bei der Erstellung von Gesetzentwürfen durch die Landesregierung ; Sanktionierung von Verstößen durch Rüge und Ausschluss aus parlamentarischen Anhörungen und Verweigerung der Zustimmung zu parlamentarischen Abenden"/>
			<string key="VkDat" value="NaT"/>
			<string key="HNr" value="nan"/>
			<string key="Jg" value="NaT"/>
			<string key="concept:name" value="Gesetzentwurf"/>
