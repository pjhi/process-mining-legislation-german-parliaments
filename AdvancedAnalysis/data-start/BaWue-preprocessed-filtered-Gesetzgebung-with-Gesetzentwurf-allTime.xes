			<string key="Desk" value="Landesdatenschutzgesetz"/>
			<string key="Titel" value="Gesetz zum Schutz personenbezogener Daten (Landesdatenschutzgesetz &amp;minus; LDSG)"/>
			<string key="DokNr" value="10/4429"/>
			<string key="Urheber" value="Landesregierung"/>
			<string key="LokURL" value="https://www.landtag-bw.de/files/live/sites/LTBW/files/dokumente/WP10/Drucksachen/4000/10_4429_D.pdf"/>
